{
  "name": "ai-docs",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build:admin_app": "cd src/applications_leptos/admin_app && ./build.sh",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "clean": "./clean.sh",
    "lint": "eslint . --ext .js,.ts,.tsx,.astro,.svelte",
    "lint:fix": "eslint . --ext .js,.ts,.tsx,.astro,.svelte --fix",
    "typecheck": "astro check && tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "wrangler-dev": "npx wrangler pages dev ./dist --ip 0.0.0.0 --port 3001",
    "deploy": "npm run build && wrangler pages deploy dist",
    "deploy:preview": "npm run build && wrangler pages deploy dist --branch preview"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.0",
    "@astrojs/mdx": "^4.3.0",
    "@astrojs/solid-js": "^5.1.0",
    "@astrojs/svelte": "^7.1.0",
    "@astrojs/tailwind": "^5.1.0",
    "@builder.io/qwik": "^1.14.1",
    "@qwikdev/astro": "^0.8.0",
    "amazon-cognito-identity-js": "^6.3.15",
    "astro": "^5.9.1",
    "firebase": "^12.6.0",
    "htmx.org": "^1.9.12",
    "solid-js": "^1.9.7",
    "svelte": "^5.33.18",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vitest/ui": "^2.1.8",
    "eslint": "^9.15.0",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-qwik": "^1.9.0",
    "eslint-plugin-svelte": "^2.46.0",
    "jsdom": "^25.0.1",
    "vitest": "^2.1.8",
    "wrangler": "^4.19.1"
  }
}