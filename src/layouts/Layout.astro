---
import DarkModeToggle from 'src/components-qwik/DarkModeToggle';
import 'src/styles/global.css';

export const prerender = true

export interface Props {
    title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <script is:inline>
        // Prevent flash of light mode
        const isDarkMode = localStorage.getItem('darkMode') === 'true' ||
            (!localStorage.getItem('darkMode') && window.matchMedia('(prefers-color-scheme: dark)').matches);

        if (isDarkMode) {
            document.documentElement.classList.add('dark');
        }
    </script>
</head>
<body class="bg-white dark:bg-[#0a0f1e] text-gray-900 dark:text-white transition-colors duration-200 max-w-full overflow-x-hidden">

<!-- Navigation -->
<header class="fixed top-0 left-0 right-0 z-50 bg-white/95 dark:bg-[#0f1419]/95 backdrop-blur-xl border-b border-gray-200 dark:border-[#00d9ff]/20 shadow-lg transition-colors duration-200 max-w-full overflow-hidden">
    <nav class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 w-full max-w-full">
        <div class="flex justify-between items-center h-24">
            <!-- Logo -->
            <a href="/" class="flex items-center group transition-transform hover:scale-105">
                <img src="/splitdo/logo.svg" alt="SplitDo Logo" class="h-16 w-auto" />
            </a>

            <!-- Desktop Navigation -->
            <div class="hidden lg:flex items-center gap-10">
                <a href="/" class="text-base font-medium text-gray-700 dark:text-gray-200 hover:text-[#00d9ff] transition-all duration-200 relative group">
                    Home
                    <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-[#00d9ff] transition-all duration-200 group-hover:w-full"></span>
                </a>
                <a href="/download" class="text-base font-medium text-gray-700 dark:text-gray-200 hover:text-[#00d9ff] transition-all duration-200 relative group">
                    Download
                    <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-[#00d9ff] transition-all duration-200 group-hover:w-full"></span>
                </a>
                <a href="/tokenomics" class="text-base font-medium text-gray-700 dark:text-gray-200 hover:text-[#00d9ff] transition-all duration-200 relative group">
                    Tokenomics
                    <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-[#00d9ff] transition-all duration-200 group-hover:w-full"></span>
                </a>
                <a href="/about" class="text-base font-medium text-gray-700 dark:text-gray-200 hover:text-[#00d9ff] transition-all duration-200 relative group">
                    About
                    <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-[#00d9ff] transition-all duration-200 group-hover:w-full"></span>
                </a>

                <!-- Dark Mode Toggle -->
                <button id="theme-toggle" class="p-2 rounded-lg bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors" aria-label="Toggle dark mode">
                    <svg id="theme-toggle-dark-icon" class="hidden w-5 h-5 text-gray-700" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
                    </svg>
                    <svg id="theme-toggle-light-icon" class="hidden w-5 h-5 text-gray-300" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" fill-rule="evenodd" clip-rule="evenodd"></path>
                    </svg>
                </button>

                <button class="px-8 py-3 bg-gradient-to-r from-[#00d9ff] to-[#00b8d4] text-white font-bold rounded-xl hover:shadow-[0_0_25px_rgba(0,217,255,0.5)] transition-all duration-300 transform hover:scale-105">
                    Join Presale
                </button>
            </div>

            <!-- Mobile Menu Button & Theme Toggle -->
            <div class="lg:hidden flex items-center gap-3">
                <!-- Dark Mode Toggle (Mobile) -->
                <button id="theme-toggle-mobile" class="p-2 rounded-lg bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors" aria-label="Toggle dark mode">
                    <svg class="theme-toggle-dark-icon hidden w-5 h-5 text-gray-700" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
                    </svg>
                    <svg class="theme-toggle-light-icon hidden w-5 h-5 text-gray-300" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" fill-rule="evenodd" clip-rule="evenodd"></path>
                    </svg>
                </button>

                <button
                    id="mobile-menu-button"
                    type="button"
                    class="text-gray-700 dark:text-gray-300 hover:text-[#00d9ff] p-2 transition-colors"
                    aria-controls="mobile-menu"
                    aria-expanded="false"
                >
                    <span class="sr-only">Open main menu</span>
                    <svg class="h-7 w-7" id="menu-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                    <svg class="h-7 w-7 hidden" id="close-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>
        </div>

        <!-- Mobile Menu -->
        <div class="lg:hidden hidden" id="mobile-menu">
            <div class="px-4 pt-2 pb-3 space-y-1 bg-white/95 dark:bg-[#0f1419]/95 backdrop-blur-xl border-t border-gray-200 dark:border-[#00d9ff]/20">
                <a href="/" class="block px-3 py-2 text-base font-medium text-gray-700 dark:text-gray-200 hover:text-[#00d9ff] transition-colors">Home</a>
                <a href="/download" class="block px-3 py-2 text-base font-medium text-gray-700 dark:text-gray-200 hover:text-[#00d9ff] transition-colors">Download</a>
                <a href="/tokenomics" class="block px-3 py-2 text-base font-medium text-gray-700 dark:text-gray-200 hover:text-[#00d9ff] transition-colors">Tokenomics</a>
                <a href="/about" class="block px-3 py-2 text-base font-medium text-gray-700 dark:text-gray-200 hover:text-[#00d9ff] transition-colors">About</a>
                <div class="pt-4 pb-2">
                    <button class="w-full px-6 py-3 bg-gradient-to-r from-[#00d9ff] to-[#00b8d4] text-white font-bold rounded-xl hover:shadow-[0_0_25px_rgba(0,217,255,0.5)] transition-all duration-300">
                        Join Presale
                    </button>
                </div>
            </div>
        </div>
    </nav>
</header>

<!-- Main content -->
<main class="pt-24">
    <slot />
</main>

<!-- Footer -->
<footer class="bg-white dark:bg-[#0f1419] border-t border-gray-200 dark:border-[#00d9ff]/20 py-12 mt-16">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
            <!-- Brand -->
            <div class="col-span-1 md:col-span-2">
                <a href="/" class="flex items-center mb-6">
                    <img src="/splitdo/logo.svg" alt="SplitDo Logo" class="h-12 w-auto" />
                </a>
                <p class="text-gray-600 dark:text-gray-400 mb-6 max-w-md">
                    Split bills, track expenses, and settle up with friends. The future of group expense management.
                </p>
                <div class="flex space-x-4">
                    <a href="#" class="text-gray-400 hover:text-[#00d9ff] transition-colors">
                        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"/>
                        </svg>
                    </a>
                    <a href="#" class="text-gray-400 hover:text-[#00d9ff] transition-colors">
                        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M22.46 6c-.77.35-1.6.58-2.46.69.88-.53 1.56-1.37 1.88-2.38-.83.5-1.75.85-2.72 1.05C18.37 4.5 17.26 4 16 4c-2.35 0-4.27 1.92-4.27 4.29 0 .34.04.67.11.98C8.28 9.09 5.11 7.38 3 4.79c-.37.63-.58 1.37-.58 2.15 0 1.49.75 2.81 1.91 3.56-.71 0-1.37-.2-1.95-.5v.03c0 2.08 1.48 3.82 3.44 4.21a4.22 4.22 0 0 1-1.93.07 4.28 4.28 0 0 0 4 2.98 8.521 8.521 0 0 1-5.33 1.84c-.34 0-.68-.02-1.02-.06C3.44 20.29 5.7 21 8.12 21 16 21 20.33 14.46 20.33 8.79c0-.19 0-.37-.01-.56.84-.6 1.56-1.36 2.14-2.23z"/>
                        </svg>
                    </a>
                </div>
            </div>

            <!-- Quick Links -->
            <div>
                <h3 class="text-gray-900 dark:text-white font-semibold mb-6">Quick Links</h3>
                <ul class="space-y-4">
                    <li><a href="/" class="text-gray-600 dark:text-gray-400 hover:text-[#00d9ff] transition-colors">Home</a></li>
                    <li><a href="/download" class="text-gray-600 dark:text-gray-400 hover:text-[#00d9ff] transition-colors">Download</a></li>
                    <li><a href="/tokenomics" class="text-gray-600 dark:text-gray-400 hover:text-[#00d9ff] transition-colors">Tokenomics</a></li>
                    <li><a href="/about" class="text-gray-600 dark:text-gray-400 hover:text-[#00d9ff] transition-colors">About</a></li>
                </ul>
            </div>

            <!-- Community -->
            <div>
                <h3 class="text-gray-900 dark:text-white font-semibold mb-6">Community</h3>
                <ul class="space-y-4">
                    <li><a href="#" class="text-gray-600 dark:text-gray-400 hover:text-[#00d9ff] transition-colors">Discord</a></li>
                    <li><a href="#" class="text-gray-600 dark:text-gray-400 hover:text-[#00d9ff] transition-colors">Telegram</a></li>
                    <li><a href="#" class="text-gray-600 dark:text-gray-400 hover:text-[#00d9ff] transition-colors">Reddit</a></li>
                    <li><a href="#" class="text-gray-600 dark:text-gray-400 hover:text-[#00d9ff] transition-colors">GitHub</a></li>
                </ul>
            </div>
        </div>

        <div class="border-t border-gray-200 dark:border-[#00d9ff]/20 mt-12 pt-8">
            <div class="flex flex-col md:flex-row justify-between items-center">
                <p class="text-gray-600 dark:text-gray-400 text-sm">
                    © 2024 SplitDo. All rights reserved.
                </p>
                <div class="flex space-x-6 mt-4 md:mt-0">
                    <a href="#" class="text-gray-600 dark:text-gray-400 hover:text-[#00d9ff] text-sm transition-colors">Privacy Policy</a>
                    <a href="#" class="text-gray-600 dark:text-gray-400 hover:text-[#00d9ff] text-sm transition-colors">Terms of Service</a>
                </div>
            </div>
        </div>
    </div>
</footer>

<script>
document.addEventListener('DOMContentLoaded', function () {
    // Theme toggle functionality
    function updateThemeToggle() {
        const darkIcon = document.getElementById('theme-toggle-dark-icon');
        const lightIcon = document.getElementById('theme-toggle-light-icon');
        const mobileDarkIcon = document.querySelector('#theme-toggle-mobile .theme-toggle-dark-icon');
        const mobileLightIcon = document.querySelector('#theme-toggle-mobile .theme-toggle-light-icon');

        if (document.documentElement.classList.contains('dark')) {
            darkIcon?.classList.add('hidden');
            lightIcon?.classList.remove('hidden');
            mobileDarkIcon?.classList.add('hidden');
            mobileLightIcon?.classList.remove('hidden');
        } else {
            darkIcon?.classList.remove('hidden');
            lightIcon?.classList.add('hidden');
            mobileDarkIcon?.classList.remove('hidden');
            mobileLightIcon?.classList.add('hidden');
        }
    }

    function toggleTheme() {
        console.log('🌙 Theme toggle clicked!');
        console.log('Before toggle - dark class exists:', document.documentElement.classList.contains('dark'));

        document.documentElement.classList.toggle('dark');
        const isDark = document.documentElement.classList.contains('dark');

        console.log('After toggle - dark class exists:', isDark);
        console.log('Setting localStorage darkMode to:', isDark);

        localStorage.setItem('darkMode', isDark);
        updateThemeToggle();

        // Test if CUSTOM CSS classes work (bypassing broken Tailwind dark mode)
        const lightImg = document.getElementById('light-phone-img');
        const darkImg = document.getElementById('dark-phone-img');
        console.log('📱 Testing CUSTOM CSS classes...');
        if (lightImg && darkImg) {
            console.log('🟦 Light image display:', window.getComputedStyle(lightImg).display);
            console.log('🟥 Dark image display:', window.getComputedStyle(darkImg).display);
            console.log('🎯 HTML dark class:', document.documentElement.classList.contains('dark') ? 'YES' : 'NO');
            console.log('✅ Which image should be visible?', isDark ? 'DARK (red border)' : 'LIGHT (blue border)');
            console.log('✅ Which image IS visible?',
                window.getComputedStyle(lightImg).display === 'none' ? 'DARK' : 'LIGHT');
        }
    }

    // Initialize theme toggle
    console.log('🎨 Initializing theme...');
    console.log('Initial dark class exists:', document.documentElement.classList.contains('dark'));
    console.log('LocalStorage darkMode:', localStorage.getItem('darkMode'));
    updateThemeToggle();

    // Event listeners for theme toggle
    document.getElementById('theme-toggle')?.addEventListener('click', toggleTheme);
    document.getElementById('theme-toggle-mobile')?.addEventListener('click', toggleTheme);

    // Mobile menu toggle
    const mobileMenuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');
    const menuIcon = document.getElementById('menu-icon');
    const closeIcon = document.getElementById('close-icon');

    mobileMenuButton?.addEventListener('click', function () {
        const isExpanded = mobileMenuButton.getAttribute('aria-expanded') === 'true';

        mobileMenuButton.setAttribute('aria-expanded', (!isExpanded).toString());
        mobileMenu?.classList.toggle('hidden');
        menuIcon?.classList.toggle('hidden');
        closeIcon?.classList.toggle('hidden');
    });
});
</script>
</body>
</html>