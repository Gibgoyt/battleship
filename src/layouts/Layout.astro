---
import DarkModeToggle from 'src/components-qwik/DarkModeToggle';
import 'src/styles/global.css';

// Define custom colors as a data object for use in the template
const customColors = {
    background: '#564740', // Dark Background (YOUR COLOR)
    primary: '#f07d40',    // Primary Orange Accent
    secondary: '#47a49e',  // Secondary Teal Accent
    // A slightly darker shade of primary for hover state
    primaryDark: '#d86e37',
    // Darker shades for dark mode
    primaryDarkMode: '#c8632f',  // Darker Orange for dark mode
    secondaryDarkMode: '#368179', // Darker Teal for dark mode
};

// opt into SSG
export const prerender = true

export interface Props {
    title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="stylesheet" href="https://use.typekit.net/zog4rto.css">

    <style define:vars={customColors}>
        /* Define custom CSS variables globally from the passed frontmatter variables */
        :root {
            --color-background: var(--background); /* Exposing background color as a variable */
            --color-primary: var(--primary);
            --color-secondary: var(--secondary);
            --color-primary-dark: var(--primaryDark);

            /* Add custom utility classes for the header colors */
            .dark .bg-header-dark {
                background-color: var(--color-background);
            }
            .dark .border-header-dark {
                border-color: var(--color-secondary); /* Using secondary for dark mode border */
            }
            .focus-ring-primary:focus {
                --tw-ring-color: var(--color-primary);
            }
        }

        /* Custom Tailwind class to use CSS variable for smooth hover */
        .bg-primary-hover:hover {
            background-color: var(--color-primary-dark) !important;
        }

        /* Apply a subtle dark theme to the base body for consistency */
        body {
            background-color: #f7f7f7; /* Light background for light mode */
        }
        /* Now uses the CSS variable --background for the dark mode body color */
        html.dark body {
            background-color: var(--background);
        }

        /* Darken images in dark mode */
        .dark-mode-img {
            transition: filter 0.3s ease;
        }
        html.dark .dark-mode-img {
            filter: brightness(0.7) grayscale(0.2);
        }
    </style>
    
    <script is:inline>
        // Prevent flash of light mode
        const isDarkMode = localStorage.getItem('darkMode') === 'true' ||
            (!localStorage.getItem('darkMode') && window.matchMedia('(prefers-color-scheme: dark)').matches);

        if (isDarkMode) {
            document.documentElement.classList.add('dark');
        }
    </script>
</head>
<body class="text-gray-900 dark:text-gray-100 transition-colors duration-300">
<header class="border-b-4 border-[#47a49e] dark:border-[#f07d40] bg-[#f07d40] dark:bg-[#564740] shadow-md">
    <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-16">
            <div class="flex items-center space-x-4">
                <a href="/" class="flex items-center gap-2">
                    <!-- Light mode logo -->
                    <img src="/splitdo/logo_light.svg" alt="SplitDo Logo" class="h-12 w-auto dark:hidden">
                    <!-- Dark mode logo -->
                    <img src="/splitdo/logo_dark.svg" alt="SplitDo Logo" class="h-12 w-auto hidden dark:block">
                    <!-- Text with vertical stretch -->
                    <span class="font-bold text-2xl tracking-wide" style="font-family: 'houschka-rounded', sans-serif; font-weight: 700; transform: scaleY(1.1); transform-origin: center;">
                        <!-- Light mode text -->
                        <span class="dark:hidden">
                            <span style="color: #564740;">SPLIT</span><span style="color: #47a49e;">DO</span>
                        </span>
                        <!-- Dark mode text -->
                        <span class="hidden dark:inline">
                            <span style="color: #47a49e;">SPLIT</span><span style="color: #f07d40;">DO</span>
                        </span>
                    </span>
                </a>
            </div>

            <div class="hidden md:flex items-center space-x-8">
                <a href="/" class="text-black dark:text-gray-200 over:scale-120 transition-transform">Home</a>
                <a href="/features" class="text-black dark:text-gray-200 hover:scale-120 transition-transform">Features</a>
                <a href="/download" class="text-black dark:text-gray-200 hover:scale-120 transition-transform">Download</a>
                <a href="/about" class="text-black dark:text-gray-200 hover:scale-120 transition-transform">About Us</a>
                                
                <a href="/app/dashboard"
                   class="px-4 py-2 text-white rounded-lg transition-colors shadow-md bg-[#564740] dark:bg-[#f07d40] hover:bg-[#4a3d37] dark:hover:bg-[#d86e37]">
                    Go To App
                </a>
            </div>

            <div class="flex items-center space-x-2">
                <div class="hidden md:block">
                    <DarkModeToggle client:load />
                </div>
                <div class="md:hidden">
                    <button
                        id="mobile-menu-button"
                        type="button"
                        class="text-gray-700 dark:text-gray-300 hover:text-gray-900 dark:hover:text-gray-100 focus:outline-none focus:ring-2 focus-ring-primary focus:ring-offset-2 dark:focus:ring-offset-gray-800 p-2"
                        aria-controls="mobile-menu"
                        aria-expanded="false"
                    >
                        <span class="sr-only">Open main menu</span>
                        <svg class="h-6 w-6" id="menu-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                        </svg>
                        <svg class="h-6 w-6 hidden" id="close-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                </div>
            </div>
        </div>

        <div class="md:hidden hidden" id="mobile-menu">
            <div class="px-2 pt-2 pb-3 space-y-1 border-t border-[#47a49e] dark:border-[#f07d40] bg-[#f07d40] dark:bg-[#564740]">
                <a href="/" class="block px-3 py-2 text-black dark:text-gray-200 hover:text-gray-900 dark:hover:text-gray-100 hover:bg-gray-50 dark:hover:bg-gray-700 rounded-md transition-colors">Home</a>
                <a href="/features" class="block px-3 py-2 text-black dark:text-gray-200 hover:text-gray-900 dark:hover:text-gray-100 hover:bg-gray-50 dark:hover:bg-gray-700 rounded-md transition-colors">Features</a>
                <a href="/download" class="block px-3 py-2 text-black dark:text-gray-200 hover:text-gray-900 dark:hover:text-gray-100 hover:bg-gray-50 dark:hover:bg-gray-700 rounded-md transition-colors">Download</a>
                <a href="/about" class="block px-3 py-2 text-black dark:text-gray-200 hover:text-gray-900 dark:hover:text-gray-100 hover:bg-gray-50 dark:hover:bg-gray-700 rounded-md transition-colors">About</a>
                <a href="/privacy" class="block px-3 py-2 text-black dark:text-gray-200 hover:text-gray-900 dark:hover:text-gray-100 hover:bg-gray-50 dark:hover:bg-gray-700 rounded-md transition-colors">Privacy</a>
                
                <a href="/app/dashboard"
                   class="block mx-3 my-2 px-4 py-2 text-white rounded-lg transition-colors text-center shadow-md bg-[#564740] dark:bg-[#f07d40] hover:bg-[#4a3d37] dark:hover:bg-[#d86e37]">
                    Go To App
                </a>
            </div>
        </div>
    </nav>
</header>

<slot />

<!-- Fixed Dark Mode Toggle for Mobile - Bottom Right -->
<div class="md:hidden fixed bottom-8 right-4 z-50">
    <DarkModeToggle client:load />
</div>


