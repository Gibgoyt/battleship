---
export const prerender = true;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Add Expense - SplitDo</title>
    <link rel="stylesheet" href="/src/styles/global.css" />
  </head>
  <body>
    <main
      class="h-screen overflow-hidden pb-16"
      style="background: linear-gradient(to bottom right, #6b4e3d, #564740, #304445);"
    >
      <section class="px-4 py-4 h-full overflow-y-auto">
        <!-- Header -->
        <div class="flex items-center justify-between mb-6">
          <a href="/k-app/welcome" class="text-white/70 hover:text-white transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m15 18-6-6 6-6"/>
            </svg>
          </a>
          <h1 class="text-2xl font-bold text-white">Add Expense</h1>
          <div class="w-6"></div>
        </div>

        <!-- Form -->
        <div class="max-w-md mx-auto">
          <form class="space-y-5">

            <!-- Amount Input -->
            <div class="bg-white/95 backdrop-blur-sm rounded-xl p-6 shadow-lg">
              <label for="amount" class="block text-sm font-semibold text-gray-700 mb-2">
                Amount
              </label>
              <div class="relative">
                <span class="absolute left-4 top-1/2 -translate-y-1/2 text-2xl font-bold text-gray-400">$</span>
                <input
                  type="number"
                  id="amount"
                  name="amount"
                  step="0.01"
                  placeholder="0.00"
                  class="w-full pl-10 pr-4 py-4 text-3xl font-bold border-2 border-gray-300 rounded-lg focus:border-[#f07d40] focus:outline-none focus:ring-2 focus:ring-[#f07d40]/20 transition-all"
                  required
                  autofocus
                />
              </div>
            </div>

            <!-- Description -->
            <div class="bg-white/95 backdrop-blur-sm rounded-xl p-6 shadow-lg">
              <label for="description" class="block text-sm font-semibold text-gray-700 mb-2">
                Description
              </label>
              <input
                type="text"
                id="description"
                name="description"
                placeholder="e.g., Dinner at Luigi's"
                class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:border-[#f07d40] focus:outline-none focus:ring-2 focus:ring-[#f07d40]/20 transition-all"
                required
              />
            </div>

            <!-- Group Selection -->
            <div class="bg-white/95 backdrop-blur-sm rounded-xl p-6 shadow-lg">
              <label for="group" class="block text-sm font-semibold text-gray-700 mb-2">
                Group
              </label>
              <select
                id="group"
                name="group"
                class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:border-[#f07d40] focus:outline-none focus:ring-2 focus:ring-[#f07d40]/20 transition-all appearance-none bg-white"
                required
              >
                <option value="">Select a group...</option>
                <option value="apartment">🏢 Apartment</option>
                <option value="beach-trip">☀️ Beach Trip</option>
                <option value="dinners">🍽️ Dinners</option>
              </select>
            </div>

            <!-- Date -->
            <div class="bg-white/95 backdrop-blur-sm rounded-xl p-6 shadow-lg">
              <label for="date" class="block text-sm font-semibold text-gray-700 mb-2">
                Date
              </label>
              <input
                type="date"
                id="date"
                name="date"
                class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:border-[#f07d40] focus:outline-none focus:ring-2 focus:ring-[#f07d40]/20 transition-all"
                required
              />
            </div>

            <!-- Paid By -->
            <div class="bg-white/95 backdrop-blur-sm rounded-xl p-6 shadow-lg">
              <label for="paidBy" class="block text-sm font-semibold text-gray-700 mb-2">
                Paid By
              </label>
              <select
                id="paidBy"
                name="paidBy"
                class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:border-[#f07d40] focus:outline-none focus:ring-2 focus:ring-[#f07d40]/20 transition-all appearance-none bg-white"
                required
              >
                <option value="">Who paid?</option>
                <option value="you">You</option>
                <option value="alex">Alex</option>
                <option value="sarah">Sarah</option>
                <option value="mike">Mike</option>
              </select>
            </div>

            <!-- Split Method -->
            <div class="bg-white/95 backdrop-blur-sm rounded-xl p-6 shadow-lg">
              <label class="block text-sm font-semibold text-gray-700 mb-3">
                Split Method
              </label>
              <div class="space-y-2">
                <label class="flex items-center p-3 border-2 border-gray-200 rounded-lg cursor-pointer hover:border-[#f07d40] transition-all">
                  <input
                    type="radio"
                    name="splitMethod"
                    value="equal"
                    class="w-4 h-4 text-[#f07d40] focus:ring-[#f07d40]"
                    checked
                  />
                  <div class="ml-3">
                    <p class="font-semibold text-gray-900">Split Equally</p>
                    <p class="text-xs text-gray-500">Divide amount evenly among all members</p>
                  </div>
                </label>
                <label class="flex items-center p-3 border-2 border-gray-200 rounded-lg cursor-pointer hover:border-[#f07d40] transition-all">
                  <input
                    type="radio"
                    name="splitMethod"
                    value="custom"
                    class="w-4 h-4 text-[#f07d40] focus:ring-[#f07d40]"
                  />
                  <div class="ml-3">
                    <p class="font-semibold text-gray-900">Custom Amounts</p>
                    <p class="text-xs text-gray-500">Specify exact amounts for each person</p>
                  </div>
                </label>
                <label class="flex items-center p-3 border-2 border-gray-200 rounded-lg cursor-pointer hover:border-[#f07d40] transition-all">
                  <input
                    type="radio"
                    name="splitMethod"
                    value="percentage"
                    class="w-4 h-4 text-[#f07d40] focus:ring-[#f07d40]"
                  />
                  <div class="ml-3">
                    <p class="font-semibold text-gray-900">By Percentage</p>
                    <p class="text-xs text-gray-500">Split by percentage shares</p>
                  </div>
                </label>
              </div>
            </div>

            <!-- Members Involved -->
            <div class="bg-white/95 backdrop-blur-sm rounded-xl p-6 shadow-lg">
              <label class="block text-sm font-semibold text-gray-700 mb-3">
                Split With
              </label>
              <div class="space-y-2">
                <label class="flex items-center p-3 bg-gray-50 rounded-lg cursor-pointer">
                  <input
                    type="checkbox"
                    name="members"
                    value="alex"
                    class="w-4 h-4 text-[#f07d40] focus:ring-[#f07d40] rounded"
                    checked
                  />
                  <span class="ml-3 font-medium text-gray-900">Alex</span>
                </label>
                <label class="flex items-center p-3 bg-gray-50 rounded-lg cursor-pointer">
                  <input
                    type="checkbox"
                    name="members"
                    value="sarah"
                    class="w-4 h-4 text-[#f07d40] focus:ring-[#f07d40] rounded"
                    checked
                  />
                  <span class="ml-3 font-medium text-gray-900">Sarah</span>
                </label>
                <label class="flex items-center p-3 bg-gray-50 rounded-lg cursor-pointer">
                  <input
                    type="checkbox"
                    name="members"
                    value="mike"
                    class="w-4 h-4 text-[#f07d40] focus:ring-[#f07d40] rounded"
                    checked
                  />
                  <span class="ml-3 font-medium text-gray-900">Mike</span>
                </label>
              </div>
            </div>

            <!-- Submit Button -->
            <button
              type="submit"
              class="w-full px-6 py-4 bg-[#f07d40] hover:bg-[#d86e37] text-white font-semibold rounded-xl shadow-lg hover:shadow-xl transform hover:scale-105 transition-all"
            >
              Add Expense
            </button>

            <!-- Cancel Button -->
            <a
              href="/k-app/welcome"
              class="block w-full px-6 py-4 bg-white/95 hover:bg-white text-[#564740] font-medium rounded-xl shadow-lg text-center transition-all"
            >
              Cancel
            </a>

          </form>
        </div>

      </section>
    </main>

    <script>
      // Set today's date as default
      const dateInput = document.getElementById('date');
      if (dateInput) {
        const today = new Date().toISOString().split('T')[0];
        dateInput.value = today;
      }

      // Handle form submission
      const form = document.querySelector('form');
      if (form) {
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          // In a real app, this would save the expense
          // For now, just redirect back to dashboard
          window.location.href = '/k-app/welcome';
        });
      }
    </script>
  </body>
</html>
