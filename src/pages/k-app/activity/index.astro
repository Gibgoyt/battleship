---
import Taskbar from "../../../components/k-app/Taskbar.astro";
export const prerender = true;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Activity - SplitDo</title>
    <link rel="stylesheet" href="/src/styles/global.css" />
  </head>
  <body>
    <main
      class="h-screen overflow-hidden pb-16"
      style="background: linear-gradient(to bottom right, #6b4e3d, #564740, #304445);"
    >
      <section class="px-3 py-3 h-full overflow-hidden flex flex-col">
        <!-- Header -->
        <div class="pt-6 pb-4">
          <h1 class="text-3xl font-bold text-white">Activity</h1>
          <p class="text-white/70 mt-1">Recent transactions and updates</p>
        </div>

        <!-- Activity Feed -->
        <div class="flex-1 overflow-y-auto">
          <div class="space-y-3">
            <!-- Activity Item 1 -->
            <div class="bg-white/95 backdrop-blur-sm rounded-lg shadow-lg p-4">
              <div class="flex items-start justify-between">
                <div class="flex-1">
                  <p class="font-semibold">You paid Sarah</p>
                  <p class="text-gray-600 text-sm mt-1">Weekend Trip</p>
                  <p class="text-gray-400 text-xs mt-1">2 hours ago</p>
                </div>
                <div class="text-right">
                  <p class="text-[#f07d40] font-semibold">-$45.00</p>
                </div>
              </div>
            </div>

            <!-- Activity Item 2 -->
            <div class="bg-white/95 backdrop-blur-sm rounded-lg shadow-lg p-4">
              <div class="flex items-start justify-between">
                <div class="flex-1">
                  <p class="font-semibold">Mike paid you</p>
                  <p class="text-gray-600 text-sm mt-1">Roommates</p>
                  <p class="text-gray-400 text-xs mt-1">Yesterday</p>
                </div>
                <div class="text-right">
                  <p class="text-[#47a49e] font-semibold">+$60.25</p>
                </div>
              </div>
            </div>

            <!-- Activity Item 3 -->
            <div class="bg-white/95 backdrop-blur-sm rounded-lg shadow-lg p-4">
              <div class="flex items-start justify-between">
                <div class="flex-1">
                  <p class="font-semibold">New expense added</p>
                  <p class="text-gray-600 text-sm mt-1">Dinner at Luigi's - $120.00</p>
                  <p class="text-gray-400 text-xs mt-1">2 days ago</p>
                </div>
                <div class="text-right">
                  <p class="text-gray-600 font-semibold">$30.00</p>
                  <p class="text-gray-400 text-xs">Your share</p>
                </div>
              </div>
            </div>

            <!-- Activity Item 4 -->
            <div class="bg-white/95 backdrop-blur-sm rounded-lg shadow-lg p-4">
              <div class="flex items-start justify-between">
                <div class="flex-1">
                  <p class="font-semibold">You joined "Weekend Trip"</p>
                  <p class="text-gray-600 text-sm mt-1">Group created by Sarah</p>
                  <p class="text-gray-400 text-xs mt-1">3 days ago</p>
                </div>
              </div>
            </div>

            <!-- Activity Item 5 -->
            <div class="bg-white/95 backdrop-blur-sm rounded-lg shadow-lg p-4">
              <div class="flex items-start justify-between">
                <div class="flex-1">
                  <p class="font-semibold">Settled up with Alex</p>
                  <p class="text-gray-600 text-sm mt-1">Office Lunch</p>
                  <p class="text-gray-400 text-xs mt-1">1 week ago</p>
                </div>
                <div class="text-right">
                  <p class="text-gray-400 font-semibold">$0.00</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <!-- Bottom Navigation -->
    <Taskbar />
  </body>
</html>
