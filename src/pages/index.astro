              </div>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>

  <!-- 4. Real-time Balances (BROWN) -->
  <div class="flex flex-col items-center">
    <div class="pt-10 px-10 lg:pt-12 lg:px-12 text-white dark:text-gray-300 min-h-64 flex flex-col justify-center items-center bg-[#564740] w-full">
      
      <!-- Icon -->
      <div class="w-12 h-12 rounded-lg flex items-center justify-center mb-4">
        <svg class="w-8 h-8" style="color: white dark:gray-300;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>

      </div>

      <!-- Heading -->
      <h3 class="text-2xl font-semibold mb-3 text-center">Real-Time Balances</h3>

