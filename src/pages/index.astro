---
import Layout from 'src/layouts/Layout.astro';
import HeroPhones from 'src/components/HeroPhones.astro';
import WhitePhoneHero from 'src/components/WhitePhoneHero.astro';

// export static HTML
export const prerender = true
---

<Layout title="SplitDo - Split Expenses Seamlessly on Solana">

	<main>
<!-- Hero Section - Side by Side (Text Left, Phones Right) -->
    <section class="w-full overflow-visible border-b-[10px] border-[#47a49e] dark:border-[#368179]">
      <style>
        :root {
            --color-background: #564740; /* Dark Background */
            --color-primary: #f07d40;    /* Primary Orange Accent */
            --color-secondary: #47a49e;  /* Secondary Teal Accent */
        }
      </style>

      <div class="relative px-6 sm:px-8 lg:px-12 py-8 sm:py-10 lg:py-12 pb-16 sm:pb-20 lg:pb-24 overflow-visible"
           style="background: linear-gradient(to right, #564740, #55534C, #535F58, #4F766F, #47a49e);">

        <!-- Content container - Flex row with text left and phones right -->
        <div class="flex flex-col lg:flex-row items-center justify-center gap-8 relative max-w-7xl mx-auto">

          <!-- Left side: Logo and Text -->
          <div class="flex flex-col items-center justify-center gap-4 sm:gap-6 lg:gap-8 mt-2 sm:mt-4 w-full lg:w-auto lg:flex-1">
  
            <!-- Text -->
            <div class="flex flex-col gap-2 w-full text-center">
              <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold text-[#f07d40] dark:text-[#c8632f] tracking-normal sm:tracking-wide lg:tracking-wider">
                Split Solana Bills Instantly.
              </h2>
              <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold text-[#47a49e] dark:text-[#368179] tracking-normal sm:tracking-wide lg:tracking-wider">
                Settle Up on Solana.
              </h2>
              <p class="text-base sm:text-lg lg:text-xl mt-4 leading-relaxed text-white dark:text-gray-300 text-balance">
               The fastest way to split expenses and settle balances. Powered by Solana for near-zero fees and instant transfer.
              </p>
            </div>
               <div class="flex flex-col sm:flex-row gap-4 justify-center">

              <a href="/groups/new"
                class="inline-flex items-center justify-center px-6 py-3 sm:px-8 sm:py-4 text-white dark:text-gray-300 text-base sm:text-lg font-semibold rounded-xl transition-colors shadow-lg hover:shadow-xl transform hover:scale-105 transition-transform bg-[#f07d40] dark:bg-[#c8632f]">
                <span class="hidden sm:inline">Start Splitting Bills (It's Free)</span>
                <span class="sm:hidden">Get Started Free</span>
              </a>

                <a href="/how-it-works"
                   class="px-6 py-3 sm:px-8 sm:py-4 bg-white dark:bg-gray-300 text-black text-base sm:text-lg font-medium rounded-xl hover:white dark:hover:bg-gray-300 transition-colors shadow-lg hover:shadow-xl border border-gray-300 transform hover:scale-105 transition-transform">
                    Learn How It Works
                </a>
            </div>
          </div>

          <!-- Right side: Phones container - two phones -->
          <div class="flex justify-center items-center overflow-visible w-full lg:w-auto lg:flex-1">
            <WhitePhoneHero />
          </div>

        </div>
      </div>
    </section>

<section class="w-full border-b-[10px] border-[#564740] dark:border-[#f07d40]">

<div class="w-full">
<div class="grid grid-cols-1 md:grid-cols-2 gap-0">

  <!-- 1. Smart Group Management (BROWN) -->
  <div class="flex flex-col items-center">
    <div class="pt-10 px-10 lg:pt-12 lg:px-12 text-white dark:text-gray-300 min-h-64 flex flex-col justify-center items-center bg-[#564740] w-full">
      
      <!-- Icon -->
      <div class="w-12 h-12 rounded-lg flex items-center justify-center mb-4">
        <svg class="w-8 h-8" style="color: white dark:gray-300;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z">
          </path>
