						<p class="text-white dark:text-gray-200">
							Log purchases, receipts, and shared costs. Our smart algorithms automatically calculate fair splits for everyone.
						</p>
					</div>

					<div class="text-center">
						<div class="w-20 h-20 bg-[#47a49e] text-white rounded-full flex items-center justify-center text-2xl font-bold mx-auto mb-4">
							3
						</div>
						<h3 class="text-xl font-semibold mb-3">Settle via Solana</h3>
						<p class="text-white dark:text-gray-200">
							Connect your Solana wallet and settle debts instantly. Fast transactions with minimal fees on the blockchain.
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- CTA Section -->
		<section class="py-16 lg:py-24">
			<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
