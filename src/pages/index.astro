	<script>
		// Countdown Timer
		const countdownDate = new Date('2025-12-31T23:59:59').getTime();

		function updateCountdown() {
			const now = new Date().getTime();
			const distance = countdownDate - now;

			const days = Math.floor(distance / (1000 * 60 * 60 * 24));
			const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
			const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
			const seconds = Math.floor((distance % (1000 * 60)) / 1000);

			// Main countdown
			const daysEl = document.getElementById('days');
			const hoursEl = document.getElementById('hours');
			const minutesEl = document.getElementById('minutes');
			const secondsEl = document.getElementById('seconds');

			if (daysEl) daysEl.textContent = String(days).padStart(2, '0');
			if (hoursEl) hoursEl.textContent = String(hours).padStart(2, '0');
			if (minutesEl) minutesEl.textContent = String(minutes).padStart(2, '0');
			if (secondsEl) secondsEl.textContent = String(seconds).padStart(2, '0');

			// Sticky bar countdown
			const daysStickyEl = document.getElementById('days-sticky');
			const hoursStickyEl = document.getElementById('hours-sticky');
			const minutesStickyEl = document.getElementById('minutes-sticky');
			const secondsStickyEl = document.getElementById('seconds-sticky');

			if (daysStickyEl) daysStickyEl.textContent = String(days).padStart(2, '0');
			if (hoursStickyEl) hoursStickyEl.textContent = String(hours).padStart(2, '0');
			if (minutesStickyEl) minutesStickyEl.textContent = String(minutes).padStart(2, '0');
			if (secondsStickyEl) secondsStickyEl.textContent = String(seconds).padStart(2, '0');

			if (distance < 0) {
				if (daysEl) daysEl.textContent = '00';
				if (hoursEl) hoursEl.textContent = '00';
				if (minutesEl) minutesEl.textContent = '00';
				if (secondsEl) secondsEl.textContent = '00';
				if (daysStickyEl) daysStickyEl.textContent = '00';
				if (hoursStickyEl) hoursStickyEl.textContent = '00';
				if (minutesStickyEl) minutesStickyEl.textContent = '00';
				if (secondsStickyEl) secondsStickyEl.textContent = '00';
			}
		}

		updateCountdown();
		setInterval(updateCountdown, 1000);

		// Sticky Bar Show/Hide on Scroll
		let lastScroll = 0;
		const stickyBar = document.getElementById('stickyBar');

		window.addEventListener('scroll', () => {
			const currentScroll = window.pageYOffset;

			if (currentScroll > 300) {
				stickyBar?.classList.remove('translate-y-full');
			} else {
				stickyBar?.classList.add('translate-y-full');
			}

			lastScroll = currentScroll;
		});

		// Animated Counters
		const observerOptions = {
			threshold: 0.5,
			rootMargin: '0px'
		};

		const animateCounter = (element: Element) => {
			const target = parseInt(element.getAttribute('data-target') || '0');
			const duration = 2000;
			const increment = target / (duration / 16);
			let current = 0;

			const updateCounter = () => {
				current += increment;
				if (current < target) {
					if (target > 1000000) {
						element.textContent = (current / 1000000).toFixed(0) + 'M';
					} else if (target > 1000) {
						element.textContent = (current / 1000).toFixed(0) + 'K+';
					} else {
						element.textContent = Math.floor(current).toString();
					}
					requestAnimationFrame(updateCounter);
				} else {
					if (target === 1000000000) {
						element.textContent = '1B+';
					} else if (target === 500000000) {
						element.textContent = '500M';
					} else if (target > 1000) {
						element.textContent = (target / 1000).toFixed(0) + 'K+';
					} else {
						element.textContent = target.toString();
					}
				}
			};

			updateCounter();
		};

		const counterObserver = new IntersectionObserver((entries) => {
			entries.forEach((entry) => {
				if (entry.isIntersecting && entry.target.classList.contains('counter')) {
					animateCounter(entry.target);
					counterObserver.unobserve(entry.target);
				}
			});
		}, observerOptions);

		document.querySelectorAll('.counter').forEach((counter) => {
			counterObserver.observe(counter);
		});
	</script>

	<!-- Scroll-Controlled Phone Rotation -->
	<script>
		// Phone screens for each feature
		const featureScreens = [
			{ light: '/phone_screens/GroupsTab_LIGHT.png', dark: '/phone_screens/GroupsTab_DARK.png' },
			{ light: '/phone_screens/WalletIntegration_LIGHT.png', dark: '/phone_screens/WalletIntegration_DARK.png' },
			{ light: '/phone_screens/ExpensesScreen_LIGHT.png', dark: '/phone_screens/ExpensesScreen_DARK.png' }
		];

		function updateScrollExperience() {
			const section = document.getElementById('scroll-experience');
			const phone = document.getElementById('rotating-phone');
			const phoneLightScreen = document.getElementById('phone-screen-light');
			const phoneDarkScreen = document.getElementById('phone-screen-dark');
			const contentItems = document.querySelectorAll('.feature-content-item');

			if (!section || !phone) return;

			// Get section position
			const rect = section.getBoundingClientRect();
			const sectionHeight = section.offsetHeight;
			const viewportHeight = window.innerHeight;

			// Calculate how far we've scrolled through the section
			// rect.top starts at some positive value, goes to 0, then negative
			// When rect.top = 0, section just entered viewport from top
			// When rect.top = -sectionHeight + viewportHeight, section is about to leave
			const scrollStart = rect.top;
			const scrollEnd = rect.bottom - viewportHeight;
			const totalScroll = sectionHeight - viewportHeight;

			// Progress from 0 (start) to 1 (end)
			let progress = -scrollStart / totalScroll;
			progress = Math.max(0, Math.min(1, progress));

			// Determine which feature (0, 1, or 2) with smooth transitions
			// Add transition zones for crossfade effect
			const transitionWidth = 0.08; // 8% transition zone
			let featureIndex;
			let localProgress; // Progress within current feature (0 to 1)

			// Calculate feature opacities for smooth crossfade
			const feature0Opacity = progress < 0.25 ? 1 :
			                       progress < 0.33 ? 1 - ((progress - 0.25) / transitionWidth) : 0;
			const feature1Opacity = progress < 0.25 ? 0 :
			                       progress < 0.33 ? (progress - 0.25) / transitionWidth :
			                       progress < 0.58 ? 1 :
			                       progress < 0.66 ? 1 - ((progress - 0.58) / transitionWidth) : 0;
			const feature2Opacity = progress < 0.58 ? 0 :
			                       progress < 0.66 ? (progress - 0.58) / transitionWidth : 1;

			// Determine primary feature
			if (progress < 0.33) {
				featureIndex = 0;
				localProgress = progress / 0.33;
			} else if (progress < 0.66) {
				featureIndex = 1;
				localProgress = (progress - 0.33) / 0.33;
			} else {
				featureIndex = 2;
				localProgress = (progress - 0.66) / 0.34;
			}

			// Subtle rotation based on feature (phone stays normal size)
			let rotation;
			if (featureIndex === 0) {
				rotation = localProgress * 10; // 0° to 10°
			} else if (featureIndex === 1) {
				rotation = 10 - (localProgress * 20); // 10° to -10°
			} else {
				rotation = -10 + (localProgress * 10); // -10° to 0°
			}

			// Apply phone rotation (NO SCALE)
			phone.style.transform = `perspective(1000px) rotateY(${rotation}deg)`;
			phone.style.transition = 'transform 0.1s ease-out';

			// Update text content visibility with crossfade
			const featureOpacities = [feature0Opacity, feature1Opacity, feature2Opacity];

			contentItems.forEach((item, index) => {
				const opacity = featureOpacities[index];
				const isActive = opacity > 0;

				// Set overall feature opacity for crossfade
				item.style.opacity = opacity;

				if (isActive) {
					item.classList.add('active');

					// Only animate lines for the primary feature
					if (index === featureIndex) {
						// Get all lines to animate
						const badge = item.querySelector('.flex.items-center'); // Icon badge
						const heading = item.querySelector('h3');
						const paragraph = item.querySelector('p');
						const listItems = item.querySelectorAll('ul li');

						const lines = [badge, heading, paragraph, ...listItems].filter(Boolean);
						const totalLines = lines.length;

						lines.forEach((line, lineIndex) => {
							// Each line appears at a different scroll threshold
							const lineThreshold = (lineIndex / totalLines);

							if (localProgress >= lineThreshold) {
								line.classList.add('line-visible');
								// Calculate scale for this line (starts big, ends normal)
								const lineProgress = Math.min(1, (localProgress - lineThreshold) / (1 / totalLines));
								const lineScale = 1.5 - (lineProgress * 0.5); // 1.5 → 1.0
								line.style.transform = `translateX(0) scale(${lineScale})`;
							} else {
								line.classList.remove('line-visible');
								line.style.transform = 'translateX(-30px) scale(1.5)';
							}
						});
					}
				} else {
					item.classList.remove('active');
					// Reset all lines when not active
					const allLines = item.querySelectorAll('.flex.items-center, h3, p, ul li');
					allLines.forEach(line => {
						line.classList.remove('line-visible');
						line.style.transform = 'translateX(-30px) scale(1.5)';
					});
				}
			});

			// Update phone screen with fade transition
			if (phoneLightScreen && phoneDarkScreen && featureScreens[featureIndex]) {
				const lightSrc = featureScreens[featureIndex].light;
				const darkSrc = featureScreens[featureIndex].dark;

				if (!phoneLightScreen.src.endsWith(lightSrc)) {
					// Fade out, change image, fade in
					const phoneContainer = phone.querySelector('.bg-white');
					if (phoneContainer) {
						phoneContainer.style.transition = 'opacity 0.3s ease-out';
						phoneContainer.style.opacity = '0.7';
						setTimeout(() => {
							phoneLightScreen.src = lightSrc;
							phoneDarkScreen.src = darkSrc;
							phoneContainer.style.opacity = '1';
						}, 150);
					}
				}
			}
		}

		// Throttled scroll handler
		let ticking = false;
		window.addEventListener('scroll', () => {
			if (!ticking) {
				window.requestAnimationFrame(() => {
					updateScrollExperience();
					ticking = false;
				});
				ticking = true;
			}
		}, { passive: true });

		// Initial update
		window.addEventListener('load', updateScrollExperience);
		updateScrollExperience();
	</script>

