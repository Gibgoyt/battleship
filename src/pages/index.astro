      <!-- Icon -->
      <div class="w-12 h-12 rounded-lg flex items-center justify-center mb-4">
        <svg class="w-8 h-8" style="color: white dark:gray-300;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M3 14h18m-9-4v4m-7 0v-4M16 10v4"></path>
                </svg>
      </div>

      <!-- Heading -->
      <h3 class="text-2xl font-semibold mb-3 text-center">Intelligent Auto-Split Calculations</h3>

      <!-- Description -->
      <p class="text-base text-white dark:text-gray-300 text-center mb-10">
Intelligent algorithms automatically calculate fair splits. Handle unequal shares, tips, taxes, and complex expense scenarios with precision.  </p>

