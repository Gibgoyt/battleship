            <div class="w-10 h-1.5 bg-black rounded-full"></div>
          </div>

          <!-- Phone screen -->
          <div class="flex items-center justify-center h-full p-4">
            <div class="bg-white dark:bg-gray-300 rounded-[2.2rem] w-full h-full flex items-center justify-center p-6">
