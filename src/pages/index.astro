          <!-- Top bar -->
          <div class="absolute top-0 left-1/2 -translate-x-1/2 w-24 h-5 bg-[#2E2B29] rounded-b-2xl flex justify-center items-center z-10">
            <div class="w-10 h-1.5 bg-black rounded-full"></div>
          </div>

          <!-- Phone screen -->
          <div class="flex items-center justify-center h-full p-4">
            <div class="bg-white dark:bg-gray-300 rounded-[2.2rem] w-full h-full overflow-hidden">
              <img
                src="/splitdo/2.PNG"
                alt="SplitDo App Screenshot"
                class="w-full h-full object-cover object-top"
              />
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>

  <!-- 2. Solana Integration (ORANGE) -->
  <div class="flex flex-col items-center">
    <div class="pt-10 px-10 lg:pt-12 lg:px-12 text-white dark:text-gray-300 min-h-64 flex flex-col justify-center items-center bg-[#f07d40] dark:bg-[#c8632f] w-full">
      
      <!-- Icon -->
      <div class="w-12 h-12 rounded-lg flex items-center justify-center mb-4">
        <svg class="w-8 h-8" style="color: white dark:gray-300;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 13h2m8 0h8m-11-2v2m1-1v-4a1 1 0 011-1h6a1 1 0 011 1v4a1 1 0 01-1 1h-6a1 1 0 01-1-1zM7 7l4-4 4 4M7 17l4 4 4-4"></path>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 13l-4 4M15 7l-4 4"></path>
        </svg>
      </div>

      <!-- Heading -->
      <h3 class="text-2xl font-semibold mb-3 text-center">Solana Integration</h3>

      <!-- Description -->
