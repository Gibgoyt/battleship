---
import Layout from 'src/layouts/Layout.astro';

// export static HTML
export const prerender = true
---

<Layout title="DocForge AI - Transform Your Codebase into Comprehensive Documentation">

	<main>
		<!-- Hero Section -->
		<section class="relative overflow-hidden">
			<div class="absolute inset-0 bg-gradient-to-br from-blue-50 to-purple-50 dark:from-gray-900 dark:to-gray-800 -z-10"></div>
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 lg:py-32">
				<div class="text-center">
					<h1 class="text-5xl lg:text-6xl font-bold mb-6 bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent">
						AI-Powered Documentation for Every Codebase
					</h1>
					<p class="text-xl lg:text-2xl text-gray-600 dark:text-gray-300 mb-8 max-w-3xl mx-auto">
						Transform your entire codebase into comprehensive, searchable documentation with advanced AI understanding and vector embeddings.
					</p>
					<div class="flex flex-col sm:flex-row gap-4 justify-center">
						<a href="/demo" class="px-8 py-4 bg-blue-600 text-white text-lg rounded-lg hover:bg-blue-700 transition-colors shadow-lg hover:shadow-xl">
							Start Free Trial
						</a>
						<a href="/features" class="px-8 py-4 bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 text-lg rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors shadow-lg hover:shadow-xl border border-gray-200 dark:border-gray-700">
							See How It Works
						</a>
					</div>
				</div>
			</div>
		</section>

		<!-- Key Features Section -->
		<section class="py-16 lg:py-24">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="text-center mb-12">
					<h2 class="text-3xl lg:text-4xl font-bold mb-4">
						Everything You Need to Document Your Code
					</h2>
					<p class="text-lg text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">
						Our AI agents understand your code structure, business logic, and dependencies to create meaningful documentation.
					</p>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
					<div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg p-8 hover:shadow-xl transition-shadow">
						<div class="w-12 h-12 bg-blue-100 dark:bg-blue-900 rounded-lg flex items-center justify-center mb-4">
							<svg class="w-6 h-6 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
							</svg>
						</div>
						<h3 class="text-xl font-semibold mb-3">Intelligent Code Analysis</h3>
						<p class="text-gray-600 dark:text-gray-300">
							Recursively traverse your codebase, parsing classes, functions, methods, and understanding complex logic flows and business rules.
						</p>
					</div>

					<div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg p-8 hover:shadow-xl transition-shadow">
						<div class="w-12 h-12 bg-purple-100 dark:bg-purple-900 rounded-lg flex items-center justify-center mb-4">
							<svg class="w-6 h-6 text-purple-600 dark:text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
							</svg>
						</div>
						<h3 class="text-xl font-semibold mb-3">Structured Documentation</h3>
						<p class="text-gray-600 dark:text-gray-300">
							Generate comprehensive Markdown files with high-level summaries, detailed explanations, and inline descriptions for every component.
						</p>
					</div>

					<div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg p-8 hover:shadow-xl transition-shadow">
						<div class="w-12 h-12 bg-green-100 dark:bg-green-900 rounded-lg flex items-center justify-center mb-4">
							<svg class="w-6 h-6 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
							</svg>
						</div>
						<h3 class="text-xl font-semibold mb-3">Vector-Powered Search</h3>
						<p class="text-gray-600 dark:text-gray-300">
							Every documentation file is embedded as a vector, enabling semantic search and intelligent navigation across your entire codebase.
						</p>
					</div>

					<div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg p-8 hover:shadow-xl transition-shadow">
						<div class="w-12 h-12 bg-indigo-100 dark:bg-indigo-900 rounded-lg flex items-center justify-center mb-4">
							<svg class="w-6 h-6 text-indigo-600 dark:text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122"></path>
							</svg>
						</div>
						<h3 class="text-xl font-semibold mb-3">Custom Context & Control</h3>
						<p class="text-gray-600 dark:text-gray-300">
							Provide custom prompts and explanations to enhance documentation quality. Pause scans for manual input when needed.
						</p>
					</div>

					<div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg p-8 hover:shadow-xl transition-shadow">
						<div class="w-12 h-12 bg-orange-100 dark:bg-orange-900 rounded-lg flex items-center justify-center mb-4">
							<svg class="w-6 h-6 text-orange-600 dark:text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"></path>
							</svg>
						</div>
						<h3 class="text-xl font-semibold mb-3">Multiple Input Methods</h3>
						<p class="text-gray-600 dark:text-gray-300">
							Drop .zip files directly or connect your GitHub repository. We'll maintain your folder hierarchy in the documentation structure.
						</p>
					</div>

					<div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg p-8 hover:shadow-xl transition-shadow">
						<div class="w-12 h-12 bg-red-100 dark:bg-red-900 rounded-lg flex items-center justify-center mb-4">
							<svg class="w-6 h-6 text-red-600 dark:text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
							</svg>
						</div>
						<h3 class="text-xl font-semibold mb-3">Team Collaboration</h3>
						<p class="text-gray-600 dark:text-gray-300">
							Manage teams with role-based permissions. Control who can edit docs, customize prompts, and update documentation.
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- How It Works Section -->
		<section class="py-16 lg:py-24 bg-gray-50 dark:bg-gray-900">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="text-center mb-12">
					<h2 class="text-3xl lg:text-4xl font-bold mb-4">
						How DocForge AI Works
					</h2>
					<p class="text-lg text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">
						Three simple steps to transform your codebase into comprehensive documentation
					</p>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
					<div class="text-center">
						<div class="w-20 h-20 bg-blue-600 text-white rounded-full flex items-center justify-center text-2xl font-bold mx-auto mb-4">
							1
						</div>
						<h3 class="text-xl font-semibold mb-3">Upload Your Code</h3>
						<p class="text-gray-600 dark:text-gray-300">
							Drop a .zip file or connect your GitHub repository. We'll analyze your entire codebase structure.
						</p>
					</div>

					<div class="text-center">
						<div class="w-20 h-20 bg-purple-600 text-white rounded-full flex items-center justify-center text-2xl font-bold mx-auto mb-4">
							2
						</div>
						<h3 class="text-xl font-semibold mb-3">AI Analysis & Generation</h3>
						<p class="text-gray-600 dark:text-gray-300">
							Our AI agents understand your code, extract logic, and generate comprehensive documentation automatically.
						</p>
					</div>

					<div class="text-center">
						<div class="w-20 h-20 bg-green-600 text-white rounded-full flex items-center justify-center text-2xl font-bold mx-auto mb-4">
							3
						</div>
						<h3 class="text-xl font-semibold mb-3">Search & Navigate</h3>
						<p class="text-gray-600 dark:text-gray-300">
							Access your documentation with powerful vector search. Find any component, function, or concept instantly.
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- CTA Section -->
		<section class="py-16 lg:py-24">
			<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
				<h2 class="text-3xl lg:text-4xl font-bold mb-4">
					Ready to Document Your Codebase?
				</h2>
				<p class="text-lg text-gray-600 dark:text-gray-300 mb-8">
					Join thousands of teams using AI-powered documentation to understand and maintain their code better.
				</p>
				<div class="flex flex-col sm:flex-row gap-4 justify-center">
					<a href="/pricing" class="px-8 py-4 bg-blue-600 text-white text-lg rounded-lg hover:bg-blue-700 transition-colors shadow-lg hover:shadow-xl">
						View Pricing Plans
					</a>
					<a href="/demo" class="px-8 py-4 bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 text-lg rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors shadow-lg hover:shadow-xl border border-gray-200 dark:border-gray-700">
						Try Live Demo
					</a>
				</div>
			</div>
		</section>
	</main>

	<footer class="border-t border-gray-200 dark:border-gray-800 py-12">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="text-center text-gray-600 dark:text-gray-400">
				<p>&copy; 2025 DocForge AI. All rights reserved.</p>
			</div>
		</div>
	</footer>
</Layout>
