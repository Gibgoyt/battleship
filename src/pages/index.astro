---
import Layout from 'src/layouts/Layout.astro';
import humansImage from 'src/assets/Humans.jpeg';

export const prerender = true
---

<Layout title="SPLITDO Token Presale - Join Early Access">
	<main class="min-h-screen">

		<!-- Hero Section -->
		<section class="relative overflow-hidden bg-gradient-to-b from-gray-50 to-gray-100 dark:from-[#12171f] dark:to-[#1a2030]">
			<div class="absolute inset-0 opacity-10">
				<div class="absolute top-0 left-1/4 w-96 h-96 bg-[#00d9ff] rounded-full filter blur-3xl"></div>
				<div class="absolute bottom-0 right-1/4 w-96 h-96 bg-gray-50 dark:bg-[#0f1419] rounded-full filter blur-3xl"></div>
			</div>

			<div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-16 lg:py-32">
				<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-12 items-center">
					<!-- Left: Text Content -->
					<div class="text-center lg:text-left">
						<!-- Badge -->
						<div class="inline-flex items-center px-4 py-2 rounded-full bg-gray-100 dark:bg-[#12171f] border border-[#00d9ff]/30 mb-4 sm:mb-8">
							<span class="w-2 h-2 bg-[#00d9ff] rounded-full mr-2 animate-pulse"></span>
							<span class="text-[#00d9ff] text-sm font-semibold">PRESALE LIVE NOW</span>
						</div>

						<!-- Main Heading -->
						<h1 class="text-3xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold mb-3 sm:mb-6">
							<span class="text-gray-900 dark:text-white">Secure Your</span><br/>
							<span class="gradient-text">$SPLITDO Tokens</span>
						</h1>

						<!-- Subheading -->
						<p class="text-base sm:text-xl md:text-2xl text-gray-700 dark:text-gray-200 mb-6 sm:mb-12">
							Join the revolution in decentralized expense splitting. Secure your $SPLITDO tokens at presale price before public launch.
						</p>

						<!-- CTA Buttons -->
						<div class="flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center lg:justify-start mb-6 sm:mb-12">
							<button class="group relative px-6 sm:px-8 py-3 sm:py-4 bg-[#00d9ff] text-gray-900 dark:text-white text-base sm:text-lg font-bold rounded-xl hover:bg-[#00b8d4] transition-all transform hover:scale-105 glow-button">
								<span class="relative z-10">Join Presale Now</span>
							</button>
							<button class="px-6 sm:px-8 py-3 sm:py-4 bg-transparent border-2 border-[#00d9ff]/30 text-gray-900 dark:text-white text-base sm:text-lg font-bold rounded-xl hover:bg-[#00d9ff]/10 transition-all">
								Learn More
							</button>
						</div>

						<!-- Countdown Timer -->
						<div class="max-w-2xl mx-auto lg:mx-0">
							<p class="text-gray-700 dark:text-gray-200 mb-2 sm:mb-4 text-xs sm:text-sm uppercase tracking-wider">Presale Phase 1 Ends In</p>
							<div id="countdown" class="grid grid-cols-4 gap-1.5 sm:gap-4">
								<div class="bg-gray-100 dark:bg-[#12171f] border border-gray-200 dark:border-[#00d9ff]/20 rounded-lg sm:rounded-xl p-2 sm:p-4">
									<div class="text-2xl sm:text-3xl md:text-4xl font-bold text-[#00d9ff]" id="days">00</div>
									<div class="text-xs text-gray-600 dark:text-gray-300 uppercase mt-1">Days</div>
								</div>
								<div class="bg-gray-100 dark:bg-[#12171f] border border-gray-200 dark:border-[#00d9ff]/20 rounded-lg sm:rounded-xl p-2 sm:p-4">
									<div class="text-2xl sm:text-3xl md:text-4xl font-bold text-[#00d9ff]" id="hours">00</div>
									<div class="text-xs text-gray-600 dark:text-gray-300 uppercase mt-1">Hours</div>
								</div>
								<div class="bg-gray-100 dark:bg-[#12171f] border border-gray-200 dark:border-[#00d9ff]/20 rounded-lg sm:rounded-xl p-2 sm:p-4">
									<div class="text-2xl sm:text-3xl md:text-4xl font-bold text-[#00d9ff]" id="minutes">00</div>
									<div class="text-xs text-gray-600 dark:text-gray-300 uppercase mt-1">Minutes</div>
								</div>
								<div class="bg-gray-100 dark:bg-[#12171f] border border-gray-200 dark:border-[#00d9ff]/20 rounded-lg sm:rounded-xl p-2 sm:p-4">
									<div class="text-2xl sm:text-3xl md:text-4xl font-bold text-[#00d9ff]" id="seconds">00</div>
									<div class="text-xs text-gray-600 dark:text-gray-300 uppercase mt-1">Seconds</div>
								</div>
							</div>
						</div>
					</div>

					<!-- Right: Phone Mockup -->
					<div class="flex justify-center lg:justify-end mt-4 lg:mt-0">
						<div class="relative max-w-[240px] sm:max-w-[300px] lg:max-w-[380px] w-full">
							<div class="relative bg-[#2E2B29] rounded-[3rem] border-[4px] sm:border-[6px] border-[#3D3530] shadow-2xl overflow-hidden w-full h-[420px] sm:h-[520px] lg:h-[600px] mx-auto glow-button">
								<div class="absolute top-0 left-1/2 -translate-x-1/2 w-24 h-5 bg-[#2E2B29] rounded-b-2xl flex justify-center items-center z-10">
									<div class="w-10 h-1.5 bg-black rounded-full"></div>
								</div>
								<div class="flex items-center justify-center h-full p-4">
									<div class="bg-white dark:bg-gray-300 rounded-[2.2rem] w-full h-full overflow-hidden">
										<img
											src="/phone_screens/WalletScreen_LIGHT.png"
											alt="SplitDo App Wallet Screen"
											class="w-full h-full object-cover object-top dark:hidden"
										/>
										<img
											src="/phone_screens/WalletScreen_DARK.png"
											alt="SplitDo App Wallet Screen"
											class="w-full h-full object-cover object-top hidden dark:block"
										/>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Stats Section with Animated Counters -->
		<section class="bg-gray-100 dark:bg-[#12171f] py-8 sm:py-12 lg:py-16 border-y border-gray-200 dark:border-[#00d9ff]/10">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="grid grid-cols-1 md:grid-cols-4 gap-4 sm:gap-6 lg:gap-8">
					<div class="text-center">
						<div class="text-4xl font-bold text-[#00d9ff] mb-2 counter" data-target="100000000">100M</div>
						<div class="text-gray-600 dark:text-gray-300 text-sm">Total Supply</div>
					</div>
					<div class="text-center">
						<div class="text-4xl font-bold text-[#00d9ff] mb-2 counter" data-target="31500000">31.5M</div>
						<div class="text-gray-600 dark:text-gray-300 text-sm">Strategic/Institutional</div>
					</div>
					<div class="text-center">
						<div class="text-4xl font-bold text-[#00d9ff] mb-2 counter" data-target="50000">50K+</div>
						<div class="text-gray-600 dark:text-gray-300 text-sm">Early Participants</div>
					</div>
					<div class="text-center">
						<div class="text-4xl font-bold text-[#00d9ff] mb-2">Solana</div>
						<div class="text-gray-600 dark:text-gray-300 text-sm">Blockchain</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Community Section with Humans Image -->
		<section class="bg-gray-50 dark:bg-[#0f1419] pt-8 pb-0 sm:py-12 lg:py-24 overflow-hidden">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
				<div class="grid grid-cols-1 lg:grid-cols-2 gap-4 sm:gap-8 lg:gap-12 items-center w-full max-w-full">
					<div class="w-full max-w-full">
						<h2 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 dark:text-white mb-4 sm:mb-6 break-words">
							Join Our <span class="text-[#00d9ff]">Community</span>
						</h2>
						<p class="text-base sm:text-lg lg:text-xl text-gray-700 dark:text-gray-100 mb-6 sm:mb-8 break-words">
							Thousands of users worldwide are already part of the SplitDo revolution. Join our growing community and be part of the future of decentralized expense management.
						</p>
						<div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4 lg:gap-6 w-full max-w-full">
							<div class="bg-gray-100 dark:bg-[#12171f]/30 backdrop-blur-sm rounded-xl p-4 sm:p-6">
								<div class="text-3xl font-bold text-[#00d9ff] mb-2 counter" data-target="15000">15K+</div>
								<div class="text-gray-700 dark:text-gray-100 text-sm">Discord Members</div>
							</div>
							<div class="bg-gray-100 dark:bg-[#12171f]/30 backdrop-blur-sm rounded-xl p-4 sm:p-6">
								<div class="text-3xl font-bold text-[#00d9ff] mb-2 counter" data-target="25000">25K+</div>
								<div class="text-gray-700 dark:text-gray-100 text-sm">Twitter Followers</div>
							</div>
						</div>
					</div>
					<div class="flex justify-center w-full max-w-full overflow-hidden">
						<img src={humansImage.src} alt="SplitDo Community" class="rounded-2xl shadow-2xl max-w-full w-full h-auto object-contain"/>
					</div>
				</div>
			</div>
		</section>

		<!-- Token Features -->
		<section class="bg-gray-100 dark:bg-[#12171f] pt-0 pb-8 sm:py-12 lg:py-24 overflow-hidden">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full max-w-full">
				<div class="text-center mb-8 sm:mb-12 lg:mb-16 mt-8">
					<h2 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 dark:text-white mb-3 sm:mb-4">
						Why <span class="gradient-text">$SPLITDO</span>?
					</h2>
					<p class="text-gray-600 dark:text-gray-300 text-base sm:text-lg">The future of decentralized expense management on Solana</p>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6 lg:gap-8">
					<!-- Feature 1 -->
					<div class="card-glow">
						<div class="card-glow-inner">
							<h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">Lightning Fast</h3>
							<p class="text-gray-600 dark:text-gray-300">Built on Solana for instant transactions and near-zero fees</p>
						</div>
					</div>

					<!-- Feature 2 -->
					<div class="card-glow">
						<div class="card-glow-inner">
							<h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">Secure & Transparent</h3>
							<p class="text-gray-600 dark:text-gray-300">Fully audited smart contracts and decentralized governance</p>
						</div>
					</div>

					<!-- Feature 3 -->
					<div class="card-glow">
						<div class="card-glow-inner">
							<h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">Community Driven</h3>
							<p class="text-gray-600 dark:text-gray-300">Governed by token holders for the community</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- App Features with Phones - Scroll-Controlled -->
		<section id="scroll-experience" class="bg-gray-50 dark:bg-[#0f1419] relative pt-12 sm:pt-16 lg:pt-24" style="height: 400vh;">
			<div class="sticky top-0 left-0 w-full h-screen flex flex-col items-center justify-start pt-16 sm:pt-20 lg:justify-center lg:pt-0 max-w-full overflow-x-hidden">
				<div class="text-center mb-2 sm:mb-4 lg:mb-8 w-full max-w-full px-4">
					<h2 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 dark:text-white mb-2 sm:mb-3 lg:mb-4">
						<span class="text-[#00d9ff]">Experience</span> the App
					</h2>
					<p class="text-gray-700 dark:text-gray-100 text-sm sm:text-base lg:text-lg">Scroll to explore features</p>
				</div>

				<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full max-w-full">
					<div class="grid grid-cols-1 lg:grid-cols-2 gap-4 lg:gap-12 items-center max-w-6xl w-full mx-auto max-w-full">

							<!-- Text content (changes based on scroll) -->
							<div id="feature-content" class="order-2 lg:order-1 relative min-h-[500px]">
								<!-- Feature 1: Group Management -->
								<div class="feature-content-item active" data-feature="0">
									<div class="flex items-center gap-3 mb-6">
										<div class="w-12 h-12 bg-[#00d9ff]/20 rounded-xl flex items-center justify-center">
											<svg class="w-7 h-7 text-[#00d9ff]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
												<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
											</svg>
										</div>
										<span class="text-[#00d9ff] font-semibold uppercase text-sm">Smart Management</span>
									</div>
									<h3 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4">Manage Your Groups</h3>
									<p class="text-gray-700 dark:text-gray-100 text-lg mb-6">
										Create and manage expense groups with ease. Track balances, split costs, and settle up using $SPLITDO tokens on Solana.
									</p>
									<ul class="space-y-3">
										<li class="flex items-start gap-3">
											<svg class="w-6 h-6 text-[#00d9ff] mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
												<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
											</svg>
											<span class="text-gray-900 dark:text-white">Real-time balance tracking</span>
										</li>
										<li class="flex items-start gap-3">
											<svg class="w-6 h-6 text-[#00d9ff] mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
												<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
											</svg>
											<span class="text-gray-900 dark:text-white">Automatic split calculations</span>
										</li>
										<li class="flex items-start gap-3">
											<svg class="w-6 h-6 text-[#00d9ff] mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
												<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
											</svg>
											<span class="text-gray-900 dark:text-white">Instant settlements on Solana</span>
										</li>
									</ul>
								</div>

								<!-- Feature 2: Wallet Integration -->
								<div class="feature-content-item" data-feature="1">
									<div class="flex items-center gap-3 mb-6">
										<div class="w-12 h-12 bg-[#00d9ff]/20 rounded-xl flex items-center justify-center">
											<svg class="w-7 h-7 text-[#00d9ff]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
												<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"></path>
											</svg>
										</div>
										<span class="text-[#00d9ff] font-semibold uppercase text-sm">Seamless Integration</span>
									</div>
									<h3 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4">Connect Your Wallet</h3>
									<p class="text-gray-700 dark:text-gray-100 text-lg mb-6">
										Seamlessly integrate with popular Solana wallets. Keep full control of your tokens with non-custodial, secure connections.
									</p>
									<ul class="space-y-3">
										<li class="flex items-start gap-3">
											<svg class="w-6 h-6 text-[#00d9ff] mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
												<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
											</svg>
											<span class="text-gray-900 dark:text-white">Support for Phantom, Solflare, Backpack</span>
										</li>
										<li class="flex items-start gap-3">
											<svg class="w-6 h-6 text-[#00d9ff] mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
												<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
											</svg>
											<span class="text-gray-900 dark:text-white">Non-custodial & fully secure</span>
										</li>
										<li class="flex items-start gap-3">
											<svg class="w-6 h-6 text-[#00d9ff] mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
												<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
											</svg>
											<span class="text-gray-900 dark:text-white">One-click connection</span>
										</li>
									</ul>
								</div>

								<!-- Feature 3: Settlement History -->
								<div class="feature-content-item" data-feature="2">
									<div class="flex items-center gap-3 mb-6">
										<div class="w-12 h-12 bg-[#00d9ff]/20 rounded-xl flex items-center justify-center">
											<svg class="w-7 h-7 text-[#00d9ff]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
												<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h.01M12 15h.01"></path>
											</svg>
										</div>
										<span class="text-[#00d9ff] font-semibold uppercase text-sm">Complete History</span>
									</div>
									<h3 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4">Track Everything</h3>
									<p class="text-gray-700 dark:text-gray-100 text-lg mb-6">
										Monitor all your transactions and settlements in one place. Export reports and keep complete records of all expenses.
									</p>
									<ul class="space-y-3">
										<li class="flex items-start gap-3">
											<svg class="w-6 h-6 text-[#00d9ff] mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
												<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
											</svg>
											<span class="text-gray-900 dark:text-white">Complete transaction history</span>
										</li>
										<li class="flex items-start gap-3">
											<svg class="w-6 h-6 text-[#00d9ff] mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
												<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
											</svg>
											<span class="text-gray-900 dark:text-white">Exportable reports</span>
										</li>
										<li class="flex items-start gap-3">
											<svg class="w-6 h-6 text-[#00d9ff] mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
												<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
											</svg>
											<span class="text-gray-900 dark:text-white">On-chain verification</span>
										</li>
									</ul>
								</div>
							</div>

							<!-- Phone mockup (rotates based on scroll) -->
							<div class="order-1 lg:order-2 flex justify-center">
								<div id="rotating-phone" class="relative max-w-[240px] sm:max-w-[280px] lg:max-w-[350px] w-full">
									<div class="relative bg-[#2E2B29] rounded-[3rem] border-[4px] sm:border-[6px] border-[#3D3530] shadow-2xl overflow-hidden w-full h-[450px] sm:h-[520px] lg:h-[580px]">
										<div class="absolute top-0 left-1/2 -translate-x-1/2 w-24 h-5 bg-[#2E2B29] rounded-b-2xl flex justify-center items-center z-10">
											<div class="w-10 h-1.5 bg-black rounded-full"></div>
										</div>
										<div class="flex items-center justify-center h-full p-4">
											<div class="bg-white dark:bg-gray-300 rounded-[2.2rem] w-full h-full overflow-hidden">
												<!-- Phone screens will change based on scroll -->
												<img id="phone-screen-light" src="/phone_screens/GroupsTab_LIGHT.png" alt="Groups Management" class="w-full h-full object-cover object-top dark:hidden"/>
												<img id="phone-screen-dark" src="/phone_screens/GroupsTab_DARK.png" alt="Groups Management" class="w-full h-full object-cover object-top hidden dark:block"/>
											</div>
										</div>
									</div>
								</div>
					</div>
				</div>
			</div>
		</section>

		<!-- How to Participate -->
		<section class="bg-gray-100 dark:bg-[#12171f] py-12 sm:py-16 lg:py-24 border-y border-gray-200 dark:border-[#00d9ff]/10">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="text-center mb-8 sm:mb-12 lg:mb-16">
					<h2 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 dark:text-white mb-3 sm:mb-4">
						How to <span class="gradient-text">Participate</span>
					</h2>
					<p class="text-gray-600 dark:text-gray-300 text-base sm:text-lg">Claim your tokens in 3 simple steps</p>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
					<div class="relative text-center">
						<div class="w-16 h-16 bg-gradient-to-r from-[#00d9ff] to-[#cbd5e1] rounded-full flex items-center justify-center text-2xl font-bold text-gray-900 dark:text-white mx-auto mb-6">
							1
						</div>
