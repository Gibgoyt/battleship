    <div class="pt-10 px-10 lg:pt-12 lg:px-12 text-white dark:text-gray-300 min-h-64 flex flex-col justify-center items-center bg-[#f07d40] dark:bg-[#c8632f] w-full">
      
      <!-- Icon -->
      <div class="w-12 h-12 rounded-lg flex items-center justify-center mb-4">
