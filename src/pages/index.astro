                <h4 class="text-lg font-semibold text-gray-800 mb-2">Welcome to SplitDo</h4>
                <p class="text-gray-600">Track expenses, split bills, and manage groups effortlessly.</p>
              </div>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

		<!-- How It Works Section -->
		<section class="py-16 lg:py-24 bg-black dark:bg-gray-900 border-t border-[#47a49e] border-b border-[#47a49e]">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="text-center mb-12">
					<h2 class="text-3xl lg:text-4xl font-bold mb-4 text-white dark:text-gray-200">
						How SplitDo Works
					</h2>
					<p class="text-lg text-white dark:text-gray-200">
						Three simple steps to split expenses and settle debts on the blockchain
					</p>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
					<div class="text-center">
						<div class="w-20 h-20 bg-[#564740] text-white rounded-full flex items-center justify-center text-2xl font-bold mx-auto mb-4">
							1
						</div>
						<h3 class="text-xl font-semibold mb-3">Create Your Group</h3>
						<p class="text-white dark:text-gray-200">
							Set up an expense group with friends, roommates, or colleagues. Add members and customize splitting rules.
						</p>
					</div>

					<div class="text-center">
						<div class="w-20 h-20 bg-[#f07d40] text-white rounded-full flex items-center justify-center text-2xl font-bold mx-auto mb-4">
							2
						</div>
