---
import Layout from 'src/layouts/Layout.astro';
import humansImage from 'src/assets/Humans.jpeg';

export const prerender = true
---

<Layout title="SPLITDO Token Airdrop - Claim Your Share">
	<main class="min-h-screen">

		<!-- Hero Section -->
		<section class="relative overflow-hidden" style="background: linear-gradient(180deg, #2d1b4e 0%, #6b46c1 100%);">
			<div class="absolute inset-0 opacity-10">
				<div class="absolute top-0 left-1/4 w-96 h-96 bg-[#00d9ff] rounded-full filter blur-3xl"></div>
				<div class="absolute bottom-0 right-1/4 w-96 h-96 bg-[#6b46c1] rounded-full filter blur-3xl"></div>
			</div>

			<div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 lg:py-32">
				<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
					<!-- Left: Text Content -->
					<div class="text-center lg:text-left">
						<!-- Badge -->
						<div class="inline-flex items-center px-4 py-2 rounded-full bg-[#2d1b4e] border border-[#00d9ff]/30 mb-8">
							<span class="w-2 h-2 bg-[#00d9ff] rounded-full mr-2 animate-pulse"></span>
							<span class="text-[#00d9ff] text-sm font-semibold">AIRDROP LIVE NOW</span>
						</div>

						<!-- Main Heading -->
						<h1 class="text-5xl md:text-6xl lg:text-7xl font-extrabold mb-6">
							<span class="text-white">Claim Your</span><br/>
							<span class="gradient-text">$SPLITDO Tokens</span>
						</h1>

						<!-- Subheading -->
						<p class="text-xl md:text-2xl text-gray-200 mb-12">
							Join the revolution in decentralized expense splitting. Get your share of 1,000,000,000 $SPLITDO tokens before it's too late.
						</p>

						<!-- CTA Buttons -->
						<div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start mb-12">
							<button class="group relative px-8 py-4 bg-[#00d9ff] text-white text-lg font-bold rounded-xl hover:bg-[#00b8d4] transition-all transform hover:scale-105 glow-button">
								<span class="relative z-10">Claim Airdrop Now</span>
							</button>
							<button class="px-8 py-4 bg-transparent border-2 border-[#00d9ff]/30 text-white text-lg font-bold rounded-xl hover:bg-[#00d9ff]/10 transition-all">
								Learn More
							</button>
						</div>

						<!-- Countdown Timer -->
						<div class="max-w-2xl mx-auto lg:mx-0">
							<p class="text-gray-200 mb-4 text-sm uppercase tracking-wider">Airdrop Phase 1 Ends In</p>
							<div id="countdown" class="grid grid-cols-4 gap-4">
								<div class="bg-[#2d1b4e] border border-[#00d9ff]/20 rounded-xl p-4">
									<div class="text-3xl md:text-4xl font-bold text-[#00d9ff]" id="days">00</div>
									<div class="text-xs text-gray-300 uppercase mt-1">Days</div>
								</div>
								<div class="bg-[#2d1b4e] border border-[#00d9ff]/20 rounded-xl p-4">
									<div class="text-3xl md:text-4xl font-bold text-[#00d9ff]" id="hours">00</div>
									<div class="text-xs text-gray-300 uppercase mt-1">Hours</div>
								</div>
								<div class="bg-[#2d1b4e] border border-[#00d9ff]/20 rounded-xl p-4">
									<div class="text-3xl md:text-4xl font-bold text-[#00d9ff]" id="minutes">00</div>
									<div class="text-xs text-gray-300 uppercase mt-1">Minutes</div>
								</div>
								<div class="bg-[#2d1b4e] border border-[#00d9ff]/20 rounded-xl p-4">
									<div class="text-3xl md:text-4xl font-bold text-[#00d9ff]" id="seconds">00</div>
									<div class="text-xs text-gray-300 uppercase mt-1">Seconds</div>
								</div>
							</div>
						</div>
					</div>

					<!-- Right: Phone Mockup -->
					<div class="flex justify-center lg:justify-end">
						<div class="relative max-w-[320px] sm:max-w-[380px] w-full">
							<div class="relative bg-[#2E2B29] rounded-[3rem] border-[6px] border-[#3D3530] shadow-2xl overflow-hidden w-full h-[600px] mx-auto glow-button">
								<div class="absolute top-0 left-1/2 -translate-x-1/2 w-24 h-5 bg-[#2E2B29] rounded-b-2xl flex justify-center items-center z-10">
									<div class="w-10 h-1.5 bg-black rounded-full"></div>
								</div>
								<div class="flex items-center justify-center h-full p-4">
									<div class="bg-white dark:bg-gray-300 rounded-[2.2rem] w-full h-full overflow-hidden">
										<img
											src="/phone_screens/WalletScreen_LIGHT.png"
											alt="SplitDo App Wallet Screen"
											class="w-full h-full object-cover object-top dark:hidden"
										/>
										<img
											src="/phone_screens/WalletScreen_DARK.png"
											alt="SplitDo App Wallet Screen"
											class="w-full h-full object-cover object-top hidden dark:block"
										/>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Stats Section with Animated Counters -->
		<section class="bg-[#2d1b4e] py-16 border-y border-[#00d9ff]/10">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="grid grid-cols-1 md:grid-cols-4 gap-8">
					<div class="text-center">
						<div class="text-4xl font-bold text-[#00d9ff] mb-2 counter" data-target="1000000000">1B+</div>
						<div class="text-gray-300 text-sm">Total Tokens</div>
					</div>
					<div class="text-center">
						<div class="text-4xl font-bold text-[#00d9ff] mb-2 counter" data-target="500000000">500M</div>
						<div class="text-gray-300 text-sm">Available for Airdrop</div>
					</div>
					<div class="text-center">
						<div class="text-4xl font-bold text-[#00d9ff] mb-2 counter" data-target="50000">50K+</div>
						<div class="text-gray-300 text-sm">Early Participants</div>
					</div>
					<div class="text-center">
						<div class="text-4xl font-bold text-[#00d9ff] mb-2">$0.001</div>
						<div class="text-gray-300 text-sm">Initial Token Price</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Community Section with Humans Image -->
		<section class="bg-[#6b46c1] py-24">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
					<div>
						<h2 class="text-4xl md:text-5xl font-bold text-white mb-6">
							Join Our <span class="text-[#00d9ff]">Community</span>
						</h2>
						<p class="text-xl text-gray-100 mb-8">
							Thousands of users worldwide are already part of the SplitDo revolution. Join our growing community and be part of the future of decentralized expense management.
						</p>
						<div class="grid grid-cols-2 gap-6">
							<div class="bg-[#2d1b4e]/30 backdrop-blur-sm rounded-xl p-6">
								<div class="text-3xl font-bold text-[#00d9ff] mb-2 counter" data-target="15000">15K+</div>
								<div class="text-gray-100 text-sm">Discord Members</div>
							</div>
							<div class="bg-[#2d1b4e]/30 backdrop-blur-sm rounded-xl p-6">
								<div class="text-3xl font-bold text-[#00d9ff] mb-2 counter" data-target="25000">25K+</div>
								<div class="text-gray-100 text-sm">Twitter Followers</div>
							</div>
						</div>
					</div>
					<div class="flex justify-center">
						<img src={humansImage.src} alt="SplitDo Community" class="rounded-2xl shadow-2xl max-w-full h-auto"/>
					</div>
				</div>
			</div>
		</section>

		<!-- Token Features -->
		<section class="bg-[#2d1b4e] py-24">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="text-center mb-16">
					<h2 class="text-4xl md:text-5xl font-bold text-white mb-4">
						Why <span class="gradient-text">$SPLITDO</span>?
					</h2>
					<p class="text-gray-300 text-lg">The future of decentralized expense management on Solana</p>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
					<!-- Feature 1 -->
					<div class="card-glow">
						<div class="card-glow-inner">
							<div class="w-14 h-14 bg-[#00d9ff]/10 rounded-xl flex items-center justify-center mb-4">
								<svg class="w-8 h-8 text-[#00d9ff]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
								</svg>
							</div>
							<h3 class="text-xl font-bold text-white mb-3">Lightning Fast</h3>
							<p class="text-gray-300">Built on Solana for instant transactions and near-zero fees</p>
						</div>
					</div>

					<!-- Feature 2 -->
					<div class="card-glow">
						<div class="card-glow-inner">
							<div class="w-14 h-14 bg-[#6b46c1]/10 rounded-xl flex items-center justify-center mb-4">
								<svg class="w-8 h-8 text-[#6b46c1]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
								</svg>
							</div>
							<h3 class="text-xl font-bold text-white mb-3">Secure & Transparent</h3>
							<p class="text-gray-300">Fully audited smart contracts and decentralized governance</p>
						</div>
					</div>

					<!-- Feature 3 -->
					<div class="card-glow">
						<div class="card-glow-inner">
							<div class="w-14 h-14 bg-[#00d9ff]/10 rounded-xl flex items-center justify-center mb-4">
								<svg class="w-8 h-8 text-[#00d9ff]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
								</svg>
							</div>
							<h3 class="text-xl font-bold text-white mb-3">Community Driven</h3>
							<p class="text-gray-300">Governed by token holders for the community</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- How to Participate -->
		<section class="bg-[#2d1b4e] py-24 border-y border-[#00d9ff]/10">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="text-center mb-16">
					<h2 class="text-4xl md:text-5xl font-bold text-white mb-4">
						How to <span class="gradient-text">Participate</span>
					</h2>
					<p class="text-gray-300 text-lg">Claim your tokens in 3 simple steps</p>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
					<div class="relative text-center">
						<div class="w-16 h-16 bg-gradient-to-r from-[#00d9ff] to-[#6b46c1] rounded-full flex items-center justify-center text-2xl font-bold text-white mx-auto mb-6">
							1
						</div>
						<h3 class="text-xl font-bold text-white mb-3">Connect Wallet</h3>
						<p class="text-gray-300">Connect your Solana wallet (Phantom, Solflare, or Backpack)</p>
					</div>

					<div class="relative text-center">
						<div class="w-16 h-16 bg-gradient-to-r from-[#00d9ff] to-[#6b46c1] rounded-full flex items-center justify-center text-2xl font-bold text-white mx-auto mb-6">
							2
						</div>
						<h3 class="text-xl font-bold text-white mb-3">Verify Eligibility</h3>
						<p class="text-gray-300">Check if your wallet qualifies for the airdrop distribution</p>
					</div>

					<div class="relative text-center">
						<div class="w-16 h-16 bg-gradient-to-r from-[#00d9ff] to-[#6b46c1] rounded-full flex items-center justify-center text-2xl font-bold text-white mx-auto mb-6">
							3
						</div>
						<h3 class="text-xl font-bold text-white mb-3">Claim Tokens</h3>
						<p class="text-gray-300">Claim your $SPLITDO tokens directly to your wallet</p>
					</div>
				</div>

				<!-- Final CTA -->
				<div class="text-center mt-16">
					<button class="px-12 py-5 bg-[#00d9ff] text-white text-xl font-bold rounded-xl hover:bg-[#00b8d4] transition-all transform hover:scale-105 glow-button">
						Start Claiming Now
					</button>
					<p class="text-gray-400 text-sm mt-4">No gas fees · Instant claim · Secure & verified</p>
				</div>
			</div>
		</section>

		<!-- Tokenomics -->
		<section class="bg-[#6b46c1] py-24">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="text-center mb-16">
					<h2 class="text-4xl md:text-5xl font-bold text-white mb-4">
						<span class="text-[#00d9ff]">Tokenomics</span>
					</h2>
					<p class="text-gray-100 text-lg">Fair distribution for sustainable growth</p>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
					<div class="bg-[#2d1b4e] border border-[#00d9ff]/20 rounded-xl p-6">
						<div class="text-3xl font-bold text-[#00d9ff] mb-2">50%</div>
						<div class="text-white font-semibold mb-1">Airdrop & Rewards</div>
						<div class="text-gray-300 text-sm">500M tokens for community</div>
					</div>

					<div class="bg-[#2d1b4e] border border-[#00d9ff]/20 rounded-xl p-6">
						<div class="text-3xl font-bold text-[#00d9ff] mb-2">20%</div>
						<div class="text-white font-semibold mb-1">Liquidity Pool</div>
						<div class="text-gray-300 text-sm">200M tokens for DEX liquidity</div>
					</div>

					<div class="bg-[#2d1b4e] border border-[#00d9ff]/20 rounded-xl p-6">
						<div class="text-3xl font-bold text-[#00d9ff] mb-2">20%</div>
						<div class="text-white font-semibold mb-1">Development</div>
						<div class="text-gray-300 text-sm">200M tokens vested 24 months</div>
					</div>

					<div class="bg-[#2d1b4e] border border-[#00d9ff]/20 rounded-xl p-6">
						<div class="text-3xl font-bold text-[#00d9ff] mb-2">10%</div>
						<div class="text-white font-semibold mb-1">Marketing</div>
						<div class="text-gray-300 text-sm">100M tokens for growth</div>
					</div>
				</div>
			</div>
		</section>

	</main>

	<!-- Sticky Bottom Bar -->
	<div id="stickyBar" class="fixed bottom-0 left-0 right-0 bg-[#2d1b4e] border-t-2 border-[#00d9ff] shadow-2xl transform translate-y-full transition-transform duration-300 z-50">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
			<div class="flex flex-col md:flex-row items-center justify-between gap-4">
				<!-- Current Price -->
				<div class="flex items-center gap-4">
					<div class="text-sm">
						<span class="text-gray-300">Current price</span>
						<span class="text-2xl font-bold text-white ml-2">$0.001</span>
						<span class="text-[#00d9ff] font-semibold ml-2">+73.5%</span>
					</div>
				</div>

				<!-- Countdown Timer Mini -->
				<div class="flex items-center gap-2">
					<span class="text-gray-300 text-sm mr-2">Price up in</span>
					<div class="flex gap-1">
						<div class="bg-[#6b46c1] rounded px-3 py-1">
							<div class="text-lg font-bold text-white" id="days-sticky">01</div>
							<div class="text-[10px] text-gray-200">DAY</div>
						</div>
						<div class="text-white self-center">:</div>
						<div class="bg-[#6b46c1] rounded px-3 py-1">
							<div class="text-lg font-bold text-white" id="hours-sticky">13</div>
							<div class="text-[10px] text-gray-200">HOUR</div>
						</div>
						<div class="text-white self-center">:</div>
						<div class="bg-[#6b46c1] rounded px-3 py-1">
							<div class="text-lg font-bold text-white" id="minutes-sticky">47</div>
							<div class="text-[10px] text-gray-200">MIN</div>
						</div>
						<div class="text-white self-center">:</div>
						<div class="bg-[#6b46c1] rounded px-3 py-1">
							<div class="text-lg font-bold text-white" id="seconds-sticky">01</div>
							<div class="text-[10px] text-gray-200">SEC</div>
						</div>
					</div>
				</div>

				<!-- CTA Button -->
				<button class="px-8 py-3 bg-[#00d9ff] text-white font-bold rounded-lg hover:bg-[#00b8d4] transition-all glow-button whitespace-nowrap">
					Buy $SPLITDO Now
				</button>
			</div>
		</div>
	</div>

	<script>
		// Countdown Timer
		const countdownDate = new Date('2025-12-31T23:59:59').getTime();

		function updateCountdown() {
			const now = new Date().getTime();
			const distance = countdownDate - now;

			const days = Math.floor(distance / (1000 * 60 * 60 * 24));
			const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
			const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
			const seconds = Math.floor((distance % (1000 * 60)) / 1000);

			// Main countdown
			const daysEl = document.getElementById('days');
			const hoursEl = document.getElementById('hours');
			const minutesEl = document.getElementById('minutes');
			const secondsEl = document.getElementById('seconds');

			if (daysEl) daysEl.textContent = String(days).padStart(2, '0');
			if (hoursEl) hoursEl.textContent = String(hours).padStart(2, '0');
			if (minutesEl) minutesEl.textContent = String(minutes).padStart(2, '0');
			if (secondsEl) secondsEl.textContent = String(seconds).padStart(2, '0');

			// Sticky bar countdown
			const daysStickyEl = document.getElementById('days-sticky');
			const hoursStickyEl = document.getElementById('hours-sticky');
			const minutesStickyEl = document.getElementById('minutes-sticky');
			const secondsStickyEl = document.getElementById('seconds-sticky');

			if (daysStickyEl) daysStickyEl.textContent = String(days).padStart(2, '0');
			if (hoursStickyEl) hoursStickyEl.textContent = String(hours).padStart(2, '0');
			if (minutesStickyEl) minutesStickyEl.textContent = String(minutes).padStart(2, '0');
			if (secondsStickyEl) secondsStickyEl.textContent = String(seconds).padStart(2, '0');

			if (distance < 0) {
				if (daysEl) daysEl.textContent = '00';
				if (hoursEl) hoursEl.textContent = '00';
				if (minutesEl) minutesEl.textContent = '00';
				if (secondsEl) secondsEl.textContent = '00';
				if (daysStickyEl) daysStickyEl.textContent = '00';
				if (hoursStickyEl) hoursStickyEl.textContent = '00';
				if (minutesStickyEl) minutesStickyEl.textContent = '00';
				if (secondsStickyEl) secondsStickyEl.textContent = '00';
			}
		}

		updateCountdown();
		setInterval(updateCountdown, 1000);

		// Sticky Bar Show/Hide on Scroll
		let lastScroll = 0;
		const stickyBar = document.getElementById('stickyBar');

		window.addEventListener('scroll', () => {
			const currentScroll = window.pageYOffset;

			if (currentScroll > 300) {
				stickyBar?.classList.remove('translate-y-full');
			} else {
				stickyBar?.classList.add('translate-y-full');
			}

			lastScroll = currentScroll;
		});

		// Animated Counters
		const observerOptions = {
			threshold: 0.5,
			rootMargin: '0px'
		};

		const animateCounter = (element) => {
			const target = parseInt(element.getAttribute('data-target') || '0');
			const duration = 2000;
			const increment = target / (duration / 16);
			let current = 0;

			const updateCounter = () => {
				current += increment;
				if (current < target) {
					if (target > 1000000) {
						element.textContent = (current / 1000000).toFixed(0) + 'M';
					} else if (target > 1000) {
						element.textContent = (current / 1000).toFixed(0) + 'K+';
					} else {
						element.textContent = Math.floor(current).toString();
					}
					requestAnimationFrame(updateCounter);
				} else {
					if (target === 1000000000) {
						element.textContent = '1B+';
					} else if (target === 500000000) {
						element.textContent = '500M';
					} else if (target > 1000) {
						element.textContent = (target / 1000).toFixed(0) + 'K+';
					} else {
						element.textContent = target.toString();
					}
				}
			};

			updateCounter();
		};

		const counterObserver = new IntersectionObserver((entries) => {
			entries.forEach((entry) => {
				if (entry.isIntersecting && entry.target.classList.contains('counter')) {
					animateCounter(entry.target);
					counterObserver.unobserve(entry.target);
				}
			});
		}, observerOptions);

		document.querySelectorAll('.counter').forEach((counter) => {
			counterObserver.observe(counter);
		});
	</script>
</Layout>