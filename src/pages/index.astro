---
import Layout from 'src/layouts/Layout.astro';

// export static HTML
export const prerender = true
---

<Layout title="SplitDo - Split Expenses Seamlessly on Solana">

	<main>
<section class="relative overflow-hidden">
    <style>
        :root {
            --color-background: #564740; /* Dark Background */
            --color-primary: #f07d40;    /* Primary Orange Accent */
            --color-secondary: #47a49e;  /* Secondary Teal Accent */
        }
    </style>
    
    <div class="absolute inset-0 -z-10" 
         style="
            background-image: 
                /* Subtle Dark Overlay for contrast (adjust opacity as needed) */
                linear-gradient(to bottom right, rgba(86, 71, 64, 0.8), rgba(58, 46, 42, 0.9)), 
                /* Your Background Image */
                url('/splitdo/Splitdo_Hero_Image.png'); 
            background-size: cover; 
            background-position: center center;
            background-repeat: no-repeat;
         ">
    </div>
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 lg:py-32 relative z-10 border-b border-[#47a49e]">
        <div class="text-center">
            <h1 class="text-5xl lg:text-6xl font-extrabold mb-6 bg-clip-text text-transparent" 
                style="background-image: linear-gradient(to right, var(--color-primary), var(--color-secondary));">
                Split Bills Instantly. Settle Up on Solana.
            </h1>
            
            <p class="text-xl lg:text-2xl text-white dark:text-gray-200 mb-8 max-w-3xl mx-auto">
                The fastest way to split expenses and settle balances. <br> Powered by Solana for near-zero fees and instant transfers.
            </p>
            
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
                
                <a href="/groups/new" 
                   class="px-8 py-4 text-white dark:text-gray-200 text-lg font-semibold rounded-xl transition-colors shadow-lg hover:shadow-xl transform hover:scale-105"
                   style="background-color: var(--color-primary); hover-bg-color: #f07d40;">
                    Start Splitting Bills (It's Free)
                </a>
                
                <a href="/how-it-works" 
                   class="px-8 py-4 bg-white dark:bg-gray-200 text-black text-lg font-medium rounded-xl hover:bg-gray-100 transition-colors shadow-lg hover:shadow-xl border border-gray-300 transform hover:scale-105">
                    Learn How It Works
                </a>
            </div>
        </div>
    </div>
</section>

<section class="w-full p-4 mx-auto bg-black">

<div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-4">

  <!-- 1. Smart Group Management (BROWN) -->
  <div class="flex flex-col items-center">
    <div class="p-10 lg:p-12 text-white dark:text-gray-200 min-h-64 flex flex-col justify-center items-center bg-[#564740] w-full">
      
      <!-- Icon -->
      <div class="w-12 h-12 rounded-lg flex items-center justify-center mb-4">
        <svg class="w-8 h-8" style="color: white;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z">
          </path>
        </svg>
      </div>

      <!-- Heading -->
      <h3 class="text-2xl font-semibold mb-3 text-center">Smart Group Management</h3>

      <!-- Description -->
      <p class="text-base text-gray-200 text-center mb-10"> 
        Create expense groups with friends, roommates, or colleagues. Add members, set spending rules,
        and manage permissions effortlessly. 
      </p>

      <!-- Phone Mockup -->
      <div class="relative overflow-hidden w-[280px] sm:w-[340px] lg:w-[380px] h-[350px]">
        <div class="relative bg-[#2E2B29] rounded-[3rem] border-[6px] border-[#3D3530] shadow-2xl overflow-hidden w-full h-[520px] mx-auto">
          
          <!-- Top bar -->
          <div class="absolute top-0 left-1/2 -translate-x-1/2 w-24 h-5 bg-[#2E2B29] rounded-b-2xl flex justify-center items-center z-10">
            <div class="w-10 h-1.5 bg-black rounded-full"></div>
          </div>

          <!-- Phone screen -->
          <div class="flex items-center justify-center h-full p-4">
            <div class="bg-white dark:bg-gray-200 rounded-[2.2rem] w-full h-full flex items-center justify-center p-6">
              <div class="text-center">
                <h4 class="text-lg font-semibold text-gray-800 mb-2">Welcome to SplitDo</h4>
                <p class="text-gray-600">Track expenses, split bills, and manage groups effortlessly.</p>
              </div>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>

  <!-- 2. Solana Integration (ORANGE) -->
  <div class="flex flex-col items-center">
    <div class="p-10 lg:p-12 text-white dark:text-gray-200 min-h-64 flex flex-col justify-center items-center bg-[#f07d40] w-full">
      
      <!-- Icon -->
      <div class="w-12 h-12 rounded-lg flex items-center justify-center mb-4">
        <svg class="w-8 h-8" style="color: white;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 13h2m8 0h8m-11-2v2m1-1v-4a1 1 0 011-1h6a1 1 0 011 1v4a1 1 0 01-1 1h-6a1 1 0 01-1-1zM7 7l4-4 4 4M7 17l4 4 4-4"></path>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 13l-4 4M15 7l-4 4"></path>
        </svg>
      </div>

      <!-- Heading -->
      <h3 class="text-2xl font-semibold mb-3 text-center">Solana Integration</h3>

      <!-- Description -->
      <p class="text-base text-gray-200 text-center mb-10">
       Lightning-fast settlements with minimal fees. Connect your Solana wallet and settle debts instantly on the blockchain.
      </p>

      <!-- Phone Mockup -->
      <div class="relative overflow-hidden w-[280px] sm:w-[340px] lg:w-[380px] h-[350px]">
        <div class="relative bg-[#2E2B29] rounded-[3rem] border-[6px] border-[#3D3530] shadow-2xl overflow-hidden w-full h-[520px] mx-auto">
          
          <!-- Top bar -->
          <div class="absolute top-0 left-1/2 -translate-x-1/2 w-24 h-5 bg-[#2E2B29] rounded-b-2xl flex justify-center items-center z-10">
            <div class="w-10 h-1.5 bg-black rounded-full"></div>
          </div>

          <!-- Phone screen -->
          <div class="flex items-center justify-center h-full p-4">
            <div class="bg-white dark:bg-gray-200 rounded-[2.2rem] w-full h-full flex items-center justify-center p-6">
              <div class="text-center">
                <h4 class="text-lg font-semibold text-gray-800 mb-2">Welcome to SplitDo</h4>
                <p class="text-gray-600">Track expenses, split bills, and manage groups effortlessly.</p>
              </div>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>


        <!-- 3. Auto-Split Calculations (TEAL) -->
  <div class="flex flex-col items-center">
    <div class="p-10 lg:p-12 text-white dark:text-gray-200 min-h-64 flex flex-col justify-center items-center bg-[#47a49e] w-full">
      
      <!-- Icon -->
      <div class="w-12 h-12 rounded-lg flex items-center justify-center mb-4">
        <svg class="w-8 h-8" style="color: white;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M3 14h18m-9-4v4m-7 0v-4M16 10v4"></path>
                </svg>
      </div>

      <!-- Heading -->
      <h3 class="text-2xl font-semibold mb-3 text-center">Intelligent Auto-Split Calculations</h3>

      <!-- Description -->
      <p class="text-base text-gray-200 text-center mb-10">
Intelligent algorithms automatically calculate fair splits. Handle unequal shares, tips, taxes, and complex expense scenarios with precision.  </p>

      <!-- Phone Mockup -->
      <div class="relative overflow-hidden w-[280px] sm:w-[340px] lg:w-[380px] h-[350px]">
        <div class="relative bg-[#2E2B29] rounded-[3rem] border-[6px] border-[#3D3530] shadow-2xl overflow-hidden w-full h-[520px] mx-auto">
          
          <!-- Top bar -->
          <div class="absolute top-0 left-1/2 -translate-x-1/2 w-24 h-5 bg-[#2E2B29] rounded-b-2xl flex justify-center items-center z-10">
            <div class="w-10 h-1.5 bg-black rounded-full"></div>
          </div>

          <!-- Phone screen -->
          <div class="flex items-center justify-center h-full p-4">
            <div class="bg-white dark:bg-gray-200 rounded-[2.2rem] w-full h-full flex items-center justify-center p-6">
              <div class="text-center">
                <h4 class="text-lg font-semibold text-gray-800 mb-2">Welcome to SplitDo</h4>
                <p class="text-gray-600">Track expenses, split bills, and manage groups effortlessly.</p>
              </div>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>

  <!-- 4. Real-time Balances (BROWN) -->
  <div class="flex flex-col items-center">
    <div class="p-10 lg:p-12 text-white dark:text-gray-200 min-h-64 flex flex-col justify-center items-center bg-[#564740] w-full">
      
      <!-- Icon -->
      <div class="w-12 h-12 rounded-lg flex items-center justify-center mb-4">
        <svg class="w-8 h-8" style="color: white;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>

      </div>

      <!-- Heading -->
      <h3 class="text-2xl font-semibold mb-3 text-center">Real-Time Balances</h3>

      <!-- Description -->
      <p class="text-base text-gray-200 text-center mb-10"> 
       See exactly who owes what in real-time. Track individual balances and get notifications the moment payments are due.
      </p>

      <!-- Phone Mockup -->
      <div class="relative overflow-hidden w-[280px] sm:w-[340px] lg:w-[380px] h-[350px]">
        <div class="relative bg-[#2E2B29] rounded-[3rem] border-[6px] border-[#3D3530] shadow-2xl overflow-hidden w-full h-[520px] mx-auto">
          
          <!-- Top bar -->
          <div class="absolute top-0 left-1/2 -translate-x-1/2 w-24 h-5 bg-[#2E2B29] rounded-b-2xl flex justify-center items-center z-10">
            <div class="w-10 h-1.5 bg-black rounded-full"></div>
          </div>

          <!-- Phone screen -->
          <div class="flex items-center justify-center h-full p-4">
            <div class="bg-white dark:bg-gray-200 rounded-[2.2rem] w-full h-full flex items-center justify-center p-6">
              <div class="text-center">
                <h4 class="text-lg font-semibold text-gray-800 mb-2">Welcome to SplitDo</h4>
                <p class="text-gray-600">Track expenses, split bills, and manage groups effortlessly.</p>
              </div>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>

  <!-- 5. Wallet Integration (ORANGE) -->
  <div class="flex flex-col items-center">
    <div class="p-10 lg:p-12 text-white dark:text-gray-200 min-h-64 flex flex-col justify-center items-center bg-[#f07d40] w-full">
      
      <!-- Icon -->
      <div class="w-12 h-12 rounded-lg flex items-center justify-center mb-4">
        <svg class="w-8 h-8" style="color: white;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"></path>
        </svg>
      </div>

      <!-- Heading -->
      <h3 class="text-2xl font-semibold mb-3 text-center">Wallet Integration</h3>

      <!-- Description -->
      <p class="text-base text-gray-200 text-center mb-10">
		Seamlessly connect popular Solana wallets like Phantom, Solflare, and Backpack for secure, non-custodial payments.      
	  </p>

      <!-- Phone Mockup -->
      <div class="relative overflow-hidden w-[280px] sm:w-[340px] lg:w-[380px] h-[350px]">
        <div class="relative bg-[#2E2B29] rounded-[3rem] border-[6px] border-[#3D3530] shadow-2xl overflow-hidden w-full h-[520px] mx-auto">
          
          <!-- Top bar -->
          <div class="absolute top-0 left-1/2 -translate-x-1/2 w-24 h-5 bg-[#2E2B29] rounded-b-2xl flex justify-center items-center z-10">
            <div class="w-10 h-1.5 bg-black rounded-full"></div>
          </div>

          <!-- Phone screen -->
          <div class="flex items-center justify-center h-full p-4">
            <div class="bg-white dark:bg-gray-200 rounded-[2.2rem] w-full h-full flex items-center justify-center p-6">
              <div class="text-center">
                <h4 class="text-lg font-semibold text-gray-800 mb-2">Welcome to SplitDo</h4>
                <p class="text-gray-600">Track expenses, split bills, and manage groups effortlessly.</p>
              </div>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>

        <!-- 6. Settlement Tracking (TEAL) -->
  <div class="flex flex-col items-center">
    <div class="p-10 lg:p-12 text-white dark:text-gray-200 min-h-64 flex flex-col justify-center items-center bg-[#47a49e] w-full">
      
      <!-- Icon -->
      <div class="w-12 h-12 rounded-lg flex items-center justify-center mb-4">
        <svg class="w-8 h-8" style="color: white;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h.01M12 15h.01"></path>
        </svg>
      </div>

      <!-- Heading -->
      <h3 class="text-2xl font-semibold mb-3 text-center">Complete Settlement History</h3>

      <!-- Description -->
      <p class="text-base text-gray-200 text-center mb-10">
         Monitor payment history and settlement status. Get detailed transaction records and export reports for your records.
	  </p>

      <!-- Phone Mockup -->
      <div class="relative overflow-hidden w-[280px] sm:w-[340px] lg:w-[380px] h-[350px]">
        <div class="relative bg-[#2E2B29] rounded-[3rem] border-[6px] border-[#3D3530] shadow-2xl overflow-hidden w-full h-[520px] mx-auto">
          
          <!-- Top bar -->
          <div class="absolute top-0 left-1/2 -translate-x-1/2 w-24 h-5 bg-[#2E2B29] rounded-b-2xl flex justify-center items-center z-10">
            <div class="w-10 h-1.5 bg-black rounded-full"></div>
          </div>

          <!-- Phone screen -->
          <div class="flex items-center justify-center h-full p-4">
            <div class="bg-white dark:bg-gray-200 rounded-[2.2rem] w-full h-full flex items-center justify-center p-6">
