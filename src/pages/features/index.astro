---
import Layout from 'src/layouts/Layout.astro';

// export static HTML
export const prerender = true
---

<Layout title="Features - SplitDo">

	<main>
		<!-- Hero Section -->
		<section class="bg-gradient-to-b from-orange-50 to-white dark:from-gray-900 dark:to-gray-800 py-16 lg:py-24">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="text-center">
					<h1 class="text-4xl lg:text-5xl font-bold mb-6">
						Powerful Features for Seamless Expense Splitting
					</h1>
					<p class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
						SplitDo combines blockchain technology with smart algorithms to revolutionize how groups split expenses and settle debts.
					</p>
				</div>
			</div>
		</section>

		<!-- Core Features -->
		<section class="py-16 lg:py-24">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<h2 class="text-3xl font-bold text-center mb-12">Core Capabilities</h2>
				
				<div class="space-y-24">
					<!-- Feature 1: AI Code Analysis -->
					<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
						<div class="order-2 lg:order-1">
							<h3 class="text-2xl font-bold mb-4">Smart Expense Calculations</h3>
							<p class="text-gray-600 dark:text-gray-300 mb-6">
								Our intelligent algorithms don't just split bills—they understand context. Handle complex scenarios like unequal shares, tips, taxes, and custom distributions with mathematical precision.
							</p>
							<ul class="space-y-3">
								<li class="flex items-start">
									<svg class="w-5 h-5 text-green-500 mt-1 mr-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
										<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
									</svg>
									<span class="text-gray-700 dark:text-gray-300">Handles complex splitting scenarios and custom rules</span>
								</li>
								<li class="flex items-start">
									<svg class="w-5 h-5 text-green-500 mt-1 mr-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
										<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
									</svg>
									<span class="text-gray-700 dark:text-gray-300">Automatic tax and tip distribution calculations</span>
								</li>
								<li class="flex items-start">
									<svg class="w-5 h-5 text-green-500 mt-1 mr-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
										<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
									</svg>
									<span class="text-gray-700 dark:text-gray-300">Real-time balance updates and debt optimization</span>
								</li>
								<li class="flex items-start">
									<svg class="w-5 h-5 text-green-500 mt-1 mr-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
										<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
									</svg>
									<span class="text-gray-700 dark:text-gray-300">Supports all major currencies and payment methods</span>
								</li>
							</ul>
						</div>
						<div class="order-1 lg:order-2">
							<div class="bg-gradient-to-br from-blue-100 to-purple-100 dark:from-blue-900 dark:to-purple-900 rounded-2xl p-8 shadow-xl">
								<div class="bg-gray-900 rounded-lg p-6 space-y-4 font-mono text-sm">
									<div class="flex items-center space-x-2">
										<div class="w-3 h-3 bg-red-500 rounded-full"></div>
										<div class="w-3 h-3 bg-yellow-500 rounded-full"></div>
										<div class="w-3 h-3 bg-green-500 rounded-full"></div>
										<span class="text-gray-400 text-xs ml-4">ExpenseCalculator.js</span>
									</div>
									<div class="overflow-x-auto">
										<pre class="text-gray-300"><code><span class="text-purple-400">class</span> <span class="text-yellow-300">ExpenseCalculator</span> {"{"}
  <span class="text-blue-400">async</span> <span class="text-green-400">splitExpense</span>(<span class="text-orange-400">expense, members</span>) {"{"}
    <span class="text-purple-400">const</span> <span class="text-cyan-300">baseAmount</span> = <span class="text-orange-400">expense</span>.<span class="text-green-400">amount</span>;
    <span class="text-purple-400">const</span> <span class="text-cyan-300">taxAmount</span> = <span class="text-cyan-300">baseAmount</span> * <span class="text-orange-400">expense</span>.<span class="text-green-400">taxRate</span>;

    <span class="text-purple-400">const</span> <span class="text-cyan-300">totalWithTip</span> = (<span class="text-cyan-300">baseAmount</span> + <span class="text-cyan-300">taxAmount</span>) * (<span class="text-red-300">1</span> + <span class="text-orange-400">expense</span>.<span class="text-green-400">tipRate</span>);
    <span class="text-purple-400">const</span> <span class="text-cyan-300">perPerson</span> = <span class="text-cyan-300">totalWithTip</span> / <span class="text-orange-400">members</span>.<span class="text-green-400">length</span>;

    <span class="text-purple-400">return</span> <span class="text-orange-400">members</span>.<span class="text-green-400">map</span>(<span class="text-orange-400">member</span> => ({"{"}
      <span class="text-cyan-300">userId</span>: <span class="text-orange-400">member</span>.<span class="text-green-400">id</span>, <span class="text-cyan-300">amount</span>: <span class="text-cyan-300">perPerson</span>, <span class="text-cyan-300">currency</span>: <span class="text-red-300">'USDC'</span>
    {"})"};

  {"}"}
{"}"}</code></pre>
									</div>
								</div>
							</div>
						</div>
					</div>

					<!-- Feature 2: Documentation Generation -->
					<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
						<div class="order-1">
							<div class="bg-gradient-to-br from-teal-100 to-blue-100 dark:from-teal-900 dark:to-blue-900 rounded-2xl p-8 shadow-xl">
								<div class="bg-white dark:bg-gray-800 rounded-lg p-6">
									<div class="flex items-center space-x-2 mb-4">
										<svg class="w-4 h-4 text-blue-500" fill="currentColor" viewBox="0 0 20 20">
											<path d="M4 3a2 2 0 00-2 2v1.586l8 8 8-8V5a2 2 0 00-2-2H4zM2 7.414V15a2 2 0 002 2h12a2 2 0 002-2V7.414l-8 8-8-8z"></path>
										</svg>
										<span class="font-mono text-sm text-gray-600 dark:text-gray-400">Payment Settlement</span>
									</div>
									<div class="prose prose-sm max-w-none dark:prose-invert">
										<h1 class="text-xl font-bold mb-3 text-gray-900 dark:text-gray-100">Solana Payment</h1>
										<p class="text-gray-700 dark:text-gray-300 mb-4">Lightning-fast settlement with minimal fees on Solana blockchain.</p>
										
										<h2 class="text-lg font-semibold mb-2 text-gray-800 dark:text-gray-200">Transaction Details</h2>
										
										<h3 class="text-base font-medium mb-2 text-gray-800 dark:text-gray-200">Amount: $24.75 USDC</h3>
										<p class="text-gray-700 dark:text-gray-300 mb-3">Split among 3 members - $8.25 each</p>
										
										<p class="font-medium text-gray-800 dark:text-gray-200 mb-2">Settlement Status:</p>
										<div class="space-y-1">
											<div class="flex justify-between text-sm">
												<span class="text-gray-700 dark:text-gray-300">Alice → Bob</span>
												<span class="text-green-600 dark:text-green-400">✓ Settled</span>
											</div>
											<div class="flex justify-between text-sm">
												<span class="text-gray-700 dark:text-gray-300">Charlie → Bob</span>
												<span class="text-orange-600 dark:text-orange-400">⏳ Pending</span>
											</div>
										</div>
									</div>
								</div>
							</div>
						</div>
						<div class="order-2">
							<h3 class="text-2xl font-bold mb-4">Solana Blockchain Integration</h3>
							<p class="text-gray-600 dark:text-gray-300 mb-6">
								Leverage the speed and low costs of Solana blockchain for instant settlements. Connect your wallet and settle debts with minimal fees.
							</p>
							<ul class="space-y-3">
								<li class="flex items-start">
									<svg class="w-5 h-5 text-green-500 mt-1 mr-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
										<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
									</svg>
									<span class="text-gray-700 dark:text-gray-300">Lightning-fast transaction processing</span>
								</li>
								<li class="flex items-start">
									<svg class="w-5 h-5 text-green-500 mt-1 mr-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
										<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
									</svg>
									<span class="text-gray-700 dark:text-gray-300">Minimal transaction fees (fractions of a penny)</span>
								</li>
								<li class="flex items-start">
									<svg class="w-5 h-5 text-green-500 mt-1 mr-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
										<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
									</svg>
									<span class="text-gray-700 dark:text-gray-300">Support for USDC, SOL, and major tokens</span>
								</li>
								<li class="flex items-start">
									<svg class="w-5 h-5 text-green-500 mt-1 mr-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
										<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
									</svg>
									<span class="text-gray-700 dark:text-gray-300">Secure, non-custodial wallet integration</span>
								</li>
							</ul>
						</div>
					</div>

					<!-- Feature 3: Vector Search -->
					<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
						<div class="order-2 lg:order-1">
							<h3 class="text-2xl font-bold mb-4">Group Management System</h3>
							<p class="text-gray-600 dark:text-gray-300 mb-6">
								Create and manage expense groups with advanced permission controls, member management, and detailed activity tracking.
							</p>
							<ul class="space-y-3">
								<li class="flex items-start">
									<svg class="w-5 h-5 text-green-500 mt-1 mr-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
										<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
									</svg>
									<span class="text-gray-700 dark:text-gray-300">Role-based permissions for group administrators</span>
								</li>
								<li class="flex items-start">
									<svg class="w-5 h-5 text-green-500 mt-1 mr-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
										<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
									</svg>
									<span class="text-gray-700 dark:text-gray-300">Invite members via email, phone, or QR code</span>
								</li>
								<li class="flex items-start">
									<svg class="w-5 h-5 text-green-500 mt-1 mr-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
										<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
									</svg>
									<span class="text-gray-700 dark:text-gray-300">Real-time activity feeds and notifications</span>
								</li>
								<li class="flex items-start">
									<svg class="w-5 h-5 text-green-500 mt-1 mr-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
										<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
									</svg>
									<span class="text-gray-700 dark:text-gray-300">Detailed expense history and analytics</span>
								</li>
							</ul>
						</div>
						<div class="order-1 lg:order-2">
							<div class="bg-gradient-to-br from-orange-100 to-purple-100 dark:from-orange-900 dark:to-purple-900 rounded-2xl p-8 shadow-xl">
								<div class="bg-white dark:bg-gray-800 rounded-lg p-6">
									<div class="mb-4">
										<div class="text-lg font-semibold mb-4 text-gray-900 dark:text-gray-100">Weekend Trip Group</div>
									</div>
									<div class="space-y-3">
										<div class="p-3 bg-green-50 dark:bg-green-900/20 rounded-lg border border-green-200 dark:border-green-800">
											<div class="flex justify-between text-sm mb-1">
												<span class="font-semibold text-green-900 dark:text-green-100">Alice (Admin)</span>
												<span class="text-green-600 dark:text-green-400">Balance: +$15.25</span>
											</div>
											<p class="text-sm text-gray-700 dark:text-gray-300">Paid for hotel, waiting for reimbursement</p>
										</div>
										<div class="p-3 bg-red-50 dark:bg-red-700/50 rounded-lg">
											<div class="flex justify-between text-sm mb-1">
												<span class="font-semibold">Bob</span>
												<span class="text-red-600 dark:text-red-400">Owes: $8.75</span>
											</div>
											<p class="text-sm text-gray-600 dark:text-gray-300">Gas money and restaurant split</p>
										</div>
										<div class="p-3 bg-gray-50 dark:bg-gray-700/50 rounded-lg">
											<div class="flex justify-between text-sm mb-1">
												<span class="font-semibold">Charlie</span>
												<span class="text-gray-600 dark:text-gray-400">Even: $0.00</span>
											</div>
											<p class="text-sm text-gray-600 dark:text-gray-300">All expenses settled via Solana</p>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Additional Features Grid -->
		<section class="py-16 lg:py-24 bg-gray-50 dark:bg-gray-900">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<h2 class="text-3xl font-bold text-center mb-12">Additional Capabilities</h2>
				
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
					<div class="bg-white dark:bg-gray-800 rounded-xl p-8 shadow-lg">
						<div class="w-12 h-12 bg-orange-100 dark:bg-orange-900 rounded-lg flex items-center justify-center mb-4">
							<svg class="w-6 h-6 text-orange-600 dark:text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"></path>
							</svg>
						</div>
						<h3 class="text-xl font-semibold mb-3">Multi-Wallet Support</h3>
						<p class="text-gray-600 dark:text-gray-300">
							Connect with Phantom, Solflare, Backpack, and other popular Solana wallets. Secure, non-custodial integration.
						</p>
					</div>

					<div class="bg-white dark:bg-gray-800 rounded-xl p-8 shadow-lg">
						<div class="w-12 h-12 bg-teal-100 dark:bg-teal-900 rounded-lg flex items-center justify-center mb-4">
							<svg class="w-6 h-6 text-teal-600 dark:text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
							</svg>
						</div>
						<h3 class="text-xl font-semibold mb-3">Receipt Scanning</h3>
						<p class="text-gray-600 dark:text-gray-300">
							AI-powered receipt scanning to automatically detect items, amounts, and split suggestions. Just snap a photo.
						</p>
					</div>

					<div class="bg-white dark:bg-gray-800 rounded-xl p-8 shadow-lg">
						<div class="w-12 h-12 bg-blue-100 dark:bg-blue-900 rounded-lg flex items-center justify-center mb-4">
							<svg class="w-6 h-6 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-5 5v-5zM4.828 17l2.828-2.828a4 4 0 015.656 0L15.172 17M9 12a3 3 0 100-6 3 3 0 000 6z"></path>
							</svg>
						</div>
						<h3 class="text-xl font-semibold mb-3">Real-time Notifications</h3>
						<p class="text-gray-600 dark:text-gray-300">
							Get instant alerts for new expenses, payment requests, and settlements. Push notifications and email updates.
						</p>
					</div>

					<div class="bg-white dark:bg-gray-800 rounded-xl p-8 shadow-lg">
						<div class="w-12 h-12 bg-purple-100 dark:bg-purple-900 rounded-lg flex items-center justify-center mb-4">
							<svg class="w-6 h-6 text-purple-600 dark:text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z"></path>
							</svg>
						</div>
						<h3 class="text-xl font-semibold mb-3">Expense Categories</h3>
						<p class="text-gray-600 dark:text-gray-300">
							Smart categorization of expenses with detailed analytics. Track spending patterns and generate reports.
						</p>
					</div>

					<div class="bg-white dark:bg-gray-800 rounded-xl p-8 shadow-lg">
						<div class="w-12 h-12 bg-green-100 dark:bg-green-900 rounded-lg flex items-center justify-center mb-4">
							<svg class="w-6 h-6 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
							</svg>
						</div>
						<h3 class="text-xl font-semibold mb-3">Offline Mode</h3>
						<p class="text-gray-600 dark:text-gray-300">
							Track expenses even without internet connection. Data syncs automatically when you're back online.
						</p>
					</div>

					<div class="bg-white dark:bg-gray-800 rounded-xl p-8 shadow-lg">
						<div class="w-12 h-12 bg-indigo-100 dark:bg-indigo-900 rounded-lg flex items-center justify-center mb-4">
							<svg class="w-6 h-6 text-indigo-600 dark:text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2a4 4 0 014-4h0a4 4 0 014 4v2M9 12V9a4 4 0 118 0v3m-6 8h4"></path>
							</svg>
						</div>
						<h3 class="text-xl font-semibold mb-3">Data Export</h3>
						<p class="text-gray-600 dark:text-gray-300">
							Export expense reports and transaction history in CSV, PDF formats for accounting and tax purposes.
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Integration Section -->
		<section class="py-16 lg:py-24">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="text-center mb-12">
					<h2 class="text-3xl font-bold mb-4">Seamless Integrations</h2>
					<p class="text-lg text-gray-600 dark:text-gray-300">
						SplitDo works with your favorite Solana wallets and payment platforms
					</p>
				</div>

				<div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-8">
					<div class="flex flex-col items-center">
