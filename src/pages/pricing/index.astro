---
import Layout from 'src/layouts/Layout.astro';
import WhitePhoneHero from 'src/components/WhitePhoneHero.astro';

// export static HTML
export const prerender = true
---

<Layout title="Download - SplitDo">

	<main>
		<!-- Hero Section -->
		<section class="w-full overflow-visible border-b-[10px] border-[#47a49e]">
			<style>
				:root {
					--color-background: #564740;
					--color-primary: #f07d40;
					--color-secondary: #47a49e;
				}
			</style>

			<div class="relative px-4 sm:px-6 lg:px-8 py-12 sm:py-16 lg:py-20 overflow-visible"
				 style="background: linear-gradient(to bottom right, #6b4e3d, #564740, #304445);">

				<!-- Content container - Flex row with text left and phones right -->
				<div class="flex flex-col lg:flex-row items-center justify-center gap-2 sm:gap-3 lg:gap-4 relative max-w-7xl mx-auto">

					<!-- Left side: Text -->
					<div class="flex flex-col items-center justify-center w-full lg:w-auto lg:flex-1">
						<div class="flex flex-col gap-1.5 w-full text-center">
							<h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-4xl font-extrabold text-[#f07d40] tracking-normal sm:tracking-wide">
								Get SplitDo on
							</h1>
							<h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-4xl font-extrabold text-[#47a49e] tracking-normal sm:tracking-wide">
								Your Device
							</h1>
							<p class="text-sm sm:text-base lg:text-lg mt-3 leading-relaxed text-white dark:text-gray-200 text-balance">
								Split expenses effortlessly with friends on mobile or web. Download now and start managing group expenses with blockchain-powered settlements.
							</p>
						</div>
					</div>

					<!-- Right side: Phones container - two phones (scaled smaller) -->
					<div class="flex justify-center items-center overflow-visible w-full lg:w-auto lg:flex-1">
						<WhitePhoneHero variant="compact" />
					</div>

				</div>
			</div>
		</section>

		<!-- Mobile App Download Section -->
		<section class="py-16 lg:py-24">
			<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="text-center mb-12">
					<h2 class="text-3xl font-bold mb-4">Download the Mobile App</h2>
					<p class="text-lg text-gray-600 dark:text-gray-300">
						Get the full SplitDo experience on your smartphone. Available on all major app stores.
					</p>
				</div>

				<div class="flex flex-col sm:flex-row gap-6 justify-center items-center">
					<!-- App Store Button -->
					<a href="#" class="inline-block transform hover:scale-105 transition-transform duration-200">
						<div class="bg-black text-white rounded-lg px-6 py-3 flex items-center space-x-3 min-w-[200px]">
							<svg class="w-8 h-8" viewBox="0 0 24 24" fill="currentColor">
								<path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
							</svg>
							<div class="text-left">
								<div class="text-xs">Download on the</div>
								<div class="text-lg font-semibold leading-tight">App Store</div>
							</div>
						</div>
					</a>

					<!-- Google Play Button -->
					<a href="#" class="inline-block transform hover:scale-105 transition-transform duration-200">
						<div class="bg-black text-white rounded-lg px-6 py-3 flex items-center space-x-3 min-w-[200px]">
							<svg class="w-8 h-8" viewBox="0 0 24 24" fill="currentColor">
								<path d="M3,20.5V3.5C3,2.91 3.34,2.39 3.84,2.15L13.69,12L3.84,21.85C3.34,21.6 3,21.09 3,20.5M16.81,15.12L6.05,21.34L14.54,12.85L16.81,15.12M20.16,10.81C20.5,11.08 20.75,11.5 20.75,12C20.75,12.5 20.53,12.9 20.18,13.18L17.89,14.5L15.39,12L17.89,9.5L20.16,10.81M6.05,2.66L16.81,8.88L14.54,11.15L6.05,2.66Z"/>
							</svg>
							<div class="text-left">
								<div class="text-xs">Get it on</div>
								<div class="text-lg font-semibold leading-tight">Google Play</div>
							</div>
						</div>
					</a>

					<!-- AppGallery Button -->
					<a href="#" class="inline-block transform hover:scale-105 transition-transform duration-200">
						<div class="bg-black text-white rounded-lg px-6 py-3 flex items-center space-x-3 min-w-[200px]">
							<svg class="w-8 h-8" viewBox="0 0 24 24" fill="currentColor">
								<path d="M9.5,2A2.5,2.5 0 0,1 12,4.5A2.5,2.5 0 0,1 9.5,7A2.5,2.5 0 0,1 7,4.5A2.5,2.5 0 0,1 9.5,2M14.5,2A2.5,2.5 0 0,1 17,4.5A2.5,2.5 0 0,1 14.5,7A2.5,2.5 0 0,1 12,4.5A2.5,2.5 0 0,1 14.5,2M9.5,9A2.5,2.5 0 0,1 12,11.5A2.5,2.5 0 0,1 9.5,14A2.5,2.5 0 0,1 7,11.5A2.5,2.5 0 0,1 9.5,9M14.5,9A2.5,2.5 0 0,1 17,11.5A2.5,2.5 0 0,1 14.5,14A2.5,2.5 0 0,1 12,11.5A2.5,2.5 0 0,1 14.5,9M9.5,16A2.5,2.5 0 0,1 12,18.5A2.5,2.5 0 0,1 9.5,21A2.5,2.5 0 0,1 7,18.5A2.5,2.5 0 0,1 9.5,16M14.5,16A2.5,2.5 0 0,1 17,18.5A2.5,2.5 0 0,1 14.5,21A2.5,2.5 0 0,1 12,18.5A2.5,2.5 0 0,1 14.5,16Z"/>
							</svg>
							<div class="text-left">
								<div class="text-xs">Explore it on</div>
								<div class="text-lg font-semibold leading-tight">AppGallery</div>
							</div>
						</div>
					</a>
				</div>
			</div>
		</section>

		<!-- Web App CTA Section -->
		<section class="py-16 lg:py-24 bg-gray-50 dark:bg-gray-900">
			<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
				<h2 class="text-3xl font-bold mb-4">Prefer Web? Use SplitDo Online</h2>
				<p class="text-lg text-gray-600 dark:text-gray-300 mb-8">
					Access all features directly in your browser. No download required - works on any device with real-time sync.
				</p>
				<a href="/app" class="inline-block px-8 py-4 bg-gradient-to-r from-orange-600 to-teal-600 text-white text-lg rounded-lg hover:scale-105 transition-transform transition-all duration-200 shadow-lg hover:shadow-xl font-semibold">
					Launch Web App
				</a>
			</div>
		</section>

		<!-- Features Preview Section -->
		<section class="py-16 lg:py-24">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="text-center mb-12">
					<h2 class="text-3xl font-bold mb-4">Why Choose SplitDo?</h2>
					<p class="text-lg text-gray-600 dark:text-gray-300">
						The most advanced expense splitting app with blockchain integration
					</p>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
					<div class="text-center">
						<div class="w-16 h-16 bg-orange-100 dark:bg-orange-900 rounded-lg flex items-center justify-center mx-auto mb-4">
							<svg class="w-8 h-8 text-orange-600 dark:text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
							</svg>
						</div>
						<h3 class="text-lg font-semibold mb-2">Smart Expense Tracking</h3>
						<p class="text-gray-600 dark:text-gray-300 text-sm">
							AI-powered receipt scanning and automatic expense categorization
						</p>
					</div>

					<div class="text-center">
						<div class="w-16 h-16 bg-teal-100 dark:bg-teal-900 rounded-lg flex items-center justify-center mx-auto mb-4">
							<svg class="w-8 h-8 text-teal-600 dark:text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
							</svg>
						</div>
						<h3 class="text-lg font-semibold mb-2">Solana Settlements</h3>
						<p class="text-gray-600 dark:text-gray-300 text-sm">
							Lightning-fast blockchain payments with minimal fees
						</p>
					</div>

					<div class="text-center">
						<div class="w-16 h-16 bg-blue-100 dark:bg-blue-900 rounded-lg flex items-center justify-center mx-auto mb-4">
							<svg class="w-8 h-8 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
							</svg>
						</div>
						<h3 class="text-lg font-semibold mb-2">Group Management</h3>
						<p class="text-gray-600 dark:text-gray-300 text-sm">
							Create and manage expense groups with advanced permissions
						</p>
					</div>

					<div class="text-center">
						<div class="w-16 h-16 bg-purple-100 dark:bg-purple-900 rounded-lg flex items-center justify-center mx-auto mb-4">
							<svg class="w-8 h-8 text-purple-600 dark:text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
							</svg>
						</div>
						<h3 class="text-lg font-semibold mb-2">Cross-Platform Sync</h3>
						<p class="text-gray-600 dark:text-gray-300 text-sm">
							Seamless synchronization across all your devices
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Final CTA Section -->
		<section class="py-16 lg:py-24 bg-gradient-to-br from-[#564740] to-[#47a49e] text-white dark:text-gray-200">
			<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
				<h2 class="text-3xl lg:text-4xl font-bold mb-4">
					Start Splitting Expenses Today
				</h2>
				<p class="text-xl mb-8 opacity-90">
					Join thousands of groups already using SplitDo for seamless expense management.
				</p>
				<div class="flex flex-col sm:flex-row gap-4 justify-center">
					<a href="/app" class="px-8 py-4 bg-white text-orange-600 text-lg rounded-lg hover:scale-105 transition-transform shadow-lg hover:shadow-xl font-semibold">
						Try Web App
					</a>
					<a href="#" class="px-8 py-4 bg-transparent text-white text-lg rounded-lg hover:bg-white/10 transition-colors hover:scale-105 transition-transform border-2 border-white">
						Download Mobile App
					</a>
				</div>
			</div>
		</section>
	</main>

</Layout>