---
import Layout from 'src/layouts/Layout.astro';

export const prerender = true
---

<Layout title="Download SplitDo - Mobile & Web App">
	<main class="min-h-screen">

		<!-- Hero Section -->
		<section class="relative overflow-hidden bg-gradient-to-b from-gray-50 to-gray-100 dark:from-[#12171f] dark:to-[#1a2030]">
			<div class="absolute inset-0 opacity-10">
				<div class="absolute top-0 left-1/4 w-96 h-96 bg-[#00d9ff] rounded-full filter blur-3xl"></div>
				<div class="absolute bottom-0 right-1/4 w-96 h-96 bg-gray-50 dark:bg-[#0f1419] rounded-full filter blur-3xl"></div>
			</div>

			<div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 lg:py-32">
				<div class="text-center">
					<div class="inline-flex items-center px-4 py-2 rounded-full bg-gray-100 dark:bg-[#12171f] border border-[#00d9ff]/30 mb-8">
						<svg class="w-4 h-4 text-[#00d9ff] mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
						</svg>
						<span class="text-[#00d9ff] text-sm font-semibold">AVAILABLE ON ALL PLATFORMS</span>
					</div>

					<h1 class="text-5xl md:text-6xl lg:text-7xl font-extrabold mb-6 text-gray-900 dark:text-white">
						Get <span class="gradient-text">SplitDo</span><br/>
						On Your Device
					</h1>

					<p class="text-xl md:text-2xl text-gray-700 dark:text-gray-200 mb-12 max-w-3xl mx-auto">
						Split expenses effortlessly with friends on mobile or web. Download now and start managing group expenses with blockchain-powered settlements.
					</p>

					<div class="flex flex-col sm:flex-row gap-4 justify-center">
						<a href="#mobile" class="px-8 py-4 bg-[#00d9ff] text-gray-900 dark:text-white text-lg font-bold rounded-xl hover:bg-[#00b8d4] transition-all transform hover:scale-105 glow-button">
							Download Mobile App
						</a>
						<a href="/app" class="px-8 py-4 bg-transparent border-2 border-[#00d9ff]/30 text-gray-900 dark:text-white text-lg font-bold rounded-xl hover:bg-[#00d9ff]/10 transition-all">
							Launch Web App
						</a>
					</div>
				</div>
			</div>
		</section>

		<!-- Mobile Apps Section -->
		<section id="mobile" class="bg-gray-100 dark:bg-[#12171f] py-24">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="text-center mb-16">
					<h2 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-4">
						Download the <span class="text-[#00d9ff]">Mobile App</span>
					</h2>
					<p class="text-gray-600 dark:text-gray-300 text-lg">Available on iOS and Android</p>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
					<!-- iOS App -->
					<div class="card-glow">
						<div class="card-glow-inner text-center">
							<h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-3">iOS App</h3>
							<p class="text-gray-600 dark:text-gray-300 mb-6">For iPhone and iPad</p>
							<a href="/download/istore" class="inline-flex items-center justify-center w-full px-6 py-3 bg-black text-gray-900 dark:text-white rounded-lg hover:bg-gray-800 transition-all transform hover:scale-105">
								<svg class="w-6 h-6 mr-2" viewBox="0 0 24 24" fill="currentColor">
									<path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
								</svg>
								<div class="text-left">
									<div class="text-xs opacity-80">Download on the</div>
									<div class="text-base font-bold">App Store</div>
								</div>
							</a>
						</div>
					</div>

					<!-- Android App -->
					<div class="card-glow">
						<div class="card-glow-inner text-center">
							<h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-3">Android App</h3>
							<p class="text-gray-600 dark:text-gray-300 mb-6">For Android devices</p>
							<a href="https://play.google.com/apps/testing/com.splitdo.app" class="inline-flex items-center justify-center w-full px-6 py-3 bg-black text-gray-900 dark:text-white rounded-lg hover:bg-gray-800 transition-all transform hover:scale-105">
								<svg class="w-6 h-6 mr-2" viewBox="0 0 24 24" fill="currentColor">
									<path d="M3,20.5V3.5C3,2.91 3.34,2.39 3.84,2.15L13.69,12L3.84,21.85C3.34,21.6 3,21.09 3,20.5M16.81,15.12L6.05,21.34L14.54,12.85L16.81,15.12M20.16,10.81C20.5,11.08 20.75,11.5 20.75,12C20.75,12.5 20.53,12.9 20.18,13.18L17.89,14.5L15.39,12L17.89,9.5L20.16,10.81M6.05,2.66L16.81,8.88L14.54,11.15L6.05,2.66Z"/>
								</svg>
								<div class="text-left">
									<div class="text-xs opacity-80">Get it on</div>
									<div class="text-base font-bold">Google Play</div>
								</div>
							</a>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Web App Section -->
		<section class="bg-gray-50 dark:bg-[#0f1419] py-24">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
					<div>
						<h2 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-6">
							Or Use the <span class="text-[#00d9ff]">Web App</span>
						</h2>
						<p class="text-xl text-gray-700 dark:text-gray-100 mb-8">
							Access all features directly in your browser. No download required. Works on any device with real-time sync across all platforms.
						</p>
						<ul class="space-y-4 mb-8">
							<li class="flex items-start gap-3">
								<svg class="w-6 h-6 text-[#00d9ff] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
								</svg>
								<span class="text-gray-900 dark:text-white">Works on any browser - Chrome, Safari, Firefox, Edge</span>
							</li>
							<li class="flex items-start gap-3">
								<svg class="w-6 h-6 text-[#00d9ff] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
								</svg>
								<span class="text-gray-900 dark:text-white">Real-time sync with mobile apps</span>
							</li>
							<li class="flex items-start gap-3">
								<svg class="w-6 h-6 text-[#00d9ff] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
								</svg>
								<span class="text-gray-900 dark:text-white">All features available including blockchain settlements</span>
							</li>
							<li class="flex items-start gap-3">
								<svg class="w-6 h-6 text-[#00d9ff] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
								</svg>
								<span class="text-gray-900 dark:text-white">No installation required</span>
							</li>
						</ul>
						<a href="/app" class="inline-block px-10 py-4 bg-[#00d9ff] text-gray-900 dark:text-white text-lg font-bold rounded-xl hover:bg-[#00b8d4] transition-all transform hover:scale-105 glow-button">
							Launch Web App
						</a>
					</div>
					<div class="flex justify-center">
						<div class="relative">
							<div class="absolute inset-0 bg-[#00d9ff] rounded-2xl blur-2xl opacity-20"></div>
							<div class="relative bg-gray-100 dark:bg-[#12171f]/50 backdrop-blur-sm border-2 border-[#00d9ff]/30 rounded-2xl p-8">
								<svg class="w-full h-64 text-[#00d9ff]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
								</svg>
								<p class="text-center text-gray-900 dark:text-white mt-4 font-semibold">Access from any device</p>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Features Grid -->
		<section class="bg-gray-100 dark:bg-[#12171f] py-24">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="text-center mb-16">
					<h2 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-4">
						Why Choose <span class="gradient-text">SplitDo</span>?
					</h2>
					<p class="text-gray-600 dark:text-gray-300 text-lg">The most advanced expense splitting platform</p>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
					<div class="bg-gray-50 dark:bg-[#0f1419]/20 backdrop-blur-sm border border-gray-200 dark:border-[#00d9ff]/10 rounded-xl p-6 hover:border-[#00d9ff]/30 transition-all">
						<h3 class="text-lg font-bold text-gray-900 dark:text-white mb-2">Lightning Fast</h3>
						<p class="text-gray-600 dark:text-gray-300 text-sm">Instant settlements on Solana blockchain with near-zero fees</p>
					</div>

					<div class="bg-gray-50 dark:bg-[#0f1419]/20 backdrop-blur-sm border border-gray-200 dark:border-[#00d9ff]/10 rounded-xl p-6 hover:border-[#00d9ff]/30 transition-all">
						<h3 class="text-lg font-bold text-gray-900 dark:text-white mb-2">Group Management</h3>
						<p class="text-gray-600 dark:text-gray-300 text-sm">Create unlimited groups with custom permissions and rules</p>
					</div>

					<div class="bg-gray-50 dark:bg-[#0f1419]/20 backdrop-blur-sm border border-gray-200 dark:border-[#00d9ff]/10 rounded-xl p-6 hover:border-[#00d9ff]/30 transition-all">
						<h3 class="text-lg font-bold text-gray-900 dark:text-white mb-2">Secure & Private</h3>
						<p class="text-gray-600 dark:text-gray-300 text-sm">End-to-end encryption with non-custodial wallet integration</p>
					</div>

					<div class="bg-gray-50 dark:bg-[#0f1419]/20 backdrop-blur-sm border border-gray-200 dark:border-[#00d9ff]/10 rounded-xl p-6 hover:border-[#00d9ff]/30 transition-all">
						<h3 class="text-lg font-bold text-gray-900 dark:text-white mb-2">Cross-Platform Sync</h3>
						<p class="text-gray-600 dark:text-gray-300 text-sm">Seamless synchronization across all your devices in real-time</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Final CTA -->
		<section class="bg-gradient-to-r from-[#12171f] via-[#cbd5e1] to-[#12171f] py-24">
			<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
				<h2 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-6">
					Ready to Get Started?
				</h2>
				<p class="text-xl text-gray-700 dark:text-gray-200 mb-10">
					Join thousands of groups using SplitDo for seamless expense management
				</p>
				<div class="flex flex-col sm:flex-row gap-4 justify-center">
					<a href="#mobile" class="px-10 py-4 bg-[#00d9ff] text-gray-900 dark:text-white text-lg font-bold rounded-xl hover:bg-[#00b8d4] transition-all transform hover:scale-105 glow-button">
						Download App
					</a>
					<a href="/app" class="px-10 py-4 bg-white text-[#cbd5e1] text-lg font-bold rounded-xl hover:bg-gray-100 transition-all transform hover:scale-105">
						Try Web App
					</a>
				</div>
			</div>
		</section>

	</main>
</Layout>
