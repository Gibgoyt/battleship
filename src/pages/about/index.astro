---
import Layout from 'src/layouts/Layout.astro';
import WhitePhoneHero from 'src/components/WhitePhoneHero.astro';

// export static HTML
export const prerender = true
---

<Layout title="About SplitDo - Revolutionizing Expense Splitting">

	<main class="bg-white dark:bg-[#0a0f1e]">
		<!-- Hero Section - Side by Side (Text Left, Phones Right) -->
		<section class="w-full overflow-visible border-b-2 border-gray-200 dark:border-[#00d9ff]/20">
			<div class="relative px-4 sm:px-6 lg:px-8 py-12 sm:py-16 lg:py-20 overflow-visible bg-gradient-to-br from-gray-100 to-gray-50 dark:from-[#12171f] dark:to-[#1a2030]">

				<!-- Content container - Flex row with text left and phones right -->
				<div class="flex flex-col lg:flex-row items-center justify-center gap-6 sm:gap-8 lg:gap-12 relative max-w-7xl mx-auto">

					<!-- Left side: Text -->
					<div class="flex flex-col items-center justify-center w-full lg:w-auto lg:flex-1">
						<div class="flex flex-col gap-4 w-full text-center">
							<h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold text-gray-900 dark:text-white tracking-tight">
								About <span class="text-[#00d9ff]">SplitDo</span>
							</h1>
							<h2 class="text-2xl sm:text-3xl md:text-4xl lg:text-4xl font-bold text-[#cbd5e1] tracking-normal">
								Revolutionizing Expense Splitting
							</h2>
							<p class="text-base sm:text-lg lg:text-xl mt-3 leading-relaxed text-gray-700 dark:text-gray-200 text-balance max-w-2xl mx-auto">
								We're on a mission to eliminate the hassle of splitting expenses through blockchain technology and smart automation.
							</p>
						</div>
					</div>

					<!-- Right side: Phones container - two phones (scaled smaller) -->
					<div class="flex justify-center items-center overflow-visible w-full lg:w-auto lg:flex-1">
						<WhitePhoneHero variant="compact" />
					</div>

				</div>
			</div>
		</section>

		<!-- Story Section -->
		<section class="py-16 lg:py-24 bg-gray-100 dark:bg-[#12171f] border-b-2 border-gray-200 dark:border-[#00d9ff]/20">
			<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="prose prose-lg mx-auto">
					<h2 class="text-3xl font-bold mb-8 text-gray-900 dark:text-white">Our Story</h2>
					<p class="text-gray-600 dark:text-gray-300 mb-6 text-lg leading-relaxed">
						SplitDo was born from a frustrating dinner with friends. After a great evening out, the joy was quickly dampened by the awkward dance of splitting the bill, calculating tips, and figuring out who owed what. Traditional payment apps charged fees, required multiple transactions, and someone always forgot to pay.
					</p>
					<p class="text-gray-600 dark:text-gray-300 mb-6 text-lg leading-relaxed">
						We knew there had to be a better way. What if we could split expenses automatically, settle instantly, and track everything transparently? What if technology could handle the tedious parts so people could focus on what matters - enjoying time together?
					</p>
					<p class="text-gray-600 dark:text-gray-300 mb-6 text-lg leading-relaxed">
						That's when SplitDo was born. Using blockchain technology and smart contracts, we created a platform that makes expense splitting as simple as taking a photo of a receipt. No more IOUs, no more forgotten payments, no more awkward conversations about money.
					</p>

					<div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
						<div class="bg-white dark:bg-[#0a0f1e] rounded-xl p-6 border border-gray-200 dark:border-[#00d9ff]/20">
							<div class="text-3xl font-bold text-[#00d9ff] mb-2">10M+</div>
							<div class="text-gray-600 dark:text-gray-300">Transactions Processed</div>
						</div>
						<div class="bg-white dark:bg-[#0a0f1e] rounded-xl p-6 border border-gray-200 dark:border-[#00d9ff]/20">
							<div class="text-3xl font-bold text-[#00d9ff] mb-2">50K+</div>
							<div class="text-gray-600 dark:text-gray-300">Active Users</div>
						</div>
						<div class="bg-white dark:bg-[#0a0f1e] rounded-xl p-6 border border-gray-200 dark:border-[#00d9ff]/20">
							<div class="text-3xl font-bold text-[#00d9ff] mb-2">99.9%</div>
							<div class="text-gray-600 dark:text-gray-300">Uptime</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Mission Section -->
		<section class="py-16 lg:py-24 bg-white dark:bg-[#0a0f1e]">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="text-center mb-16">
					<h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-6">Our Mission</h2>
					<p class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
						To create a world where sharing expenses is effortless, transparent, and fair for everyone involved.
					</p>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-12">
					<!-- Transparency -->
					<div class="text-center">
						<div class="w-20 h-20 bg-gradient-to-r from-[#00d9ff] to-[#00b8d4] rounded-xl flex items-center justify-center mx-auto mb-6">
							<svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
							</svg>
						</div>
						<h3 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Transparency</h3>
						<p class="text-gray-600 dark:text-gray-300">
							Every transaction is recorded on the blockchain, providing complete visibility and accountability for all participants.
						</p>
					</div>

					<!-- Fairness -->
					<div class="text-center">
						<div class="w-20 h-20 bg-gradient-to-r from-[#00d9ff] to-[#00b8d4] rounded-xl flex items-center justify-center mx-auto mb-6">
							<svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16l-3-9m3 9l3-9"/>
							</svg>
						</div>
						<h3 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Fairness</h3>
						<p class="text-gray-600 dark:text-gray-300">
							Smart contracts ensure that expenses are split exactly as agreed, with no manipulation or favoritism possible.
						</p>
					</div>

					<!-- Simplicity -->
					<div class="text-center">
						<div class="w-20 h-20 bg-gradient-to-r from-[#00d9ff] to-[#00b8d4] rounded-xl flex items-center justify-center mx-auto mb-6">
							<svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
							</svg>
						</div>
						<h3 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Simplicity</h3>
						<p class="text-gray-600 dark:text-gray-300">
							Complex blockchain technology hidden behind an intuitive interface that anyone can use effortlessly.
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Team Section -->
		<section class="py-16 lg:py-24 bg-gray-50 dark:bg-[#0f1419]">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="text-center mb-16">
					<h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-6">Our Team</h2>
					<p class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
						A passionate team of engineers, designers, and blockchain experts working to revolutionize expense management.
					</p>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
					<div class="text-center bg-white dark:bg-[#12171f] rounded-xl p-6 border border-gray-200 dark:border-[#00d9ff]/20">
						<div class="w-24 h-24 rounded-full mx-auto mb-4 overflow-hidden">
							<img src="/nic.png" alt="Nic van der Bergh" class="w-full h-full object-cover" />
						</div>
						<h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">Nic van der Bergh</h3>
						<p class="text-[#00d9ff] font-medium mb-3">CEO & Founder</p>
						<p class="text-gray-600 dark:text-gray-300 text-sm">
							10 years of experience with SOLANA and other blockchains
						</p>
					</div>

					<div class="text-center bg-white dark:bg-[#12171f] rounded-xl p-6 border border-gray-200 dark:border-[#00d9ff]/20">
						<div class="w-24 h-24 rounded-full mx-auto mb-4 overflow-hidden">
							<img src="/anand.png" alt="Anand Patel" class="w-full h-full object-cover" />
						</div>
						<h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">Anand Patel</h3>
						<p class="text-[#00d9ff] font-medium mb-3">Software Developer</p>
						<p class="text-gray-600 dark:text-gray-300 text-sm">
							Been developing software with expertise in modern frameworks and blockchain integration
						</p>
					</div>

				</div>
			</div>
		</section>

		<!-- Contact Section -->
		<section class="py-16 lg:py-24 bg-white dark:bg-[#0a0f1e]">
			<div class="max-w-4xl mx-auto text-center px-4 sm:px-6 lg:px-8">
				<h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-6">
					Ready to Join the Revolution?
				</h2>
				<p class="text-xl text-gray-600 dark:text-gray-300 mb-8">
					Experience the future of expense splitting. Download SplitDo today and see why thousands of users have made the switch.
				</p>
				<div class="flex flex-col sm:flex-row gap-4 justify-center">
					<a href="/download" class="px-8 py-4 bg-gradient-to-r from-[#00d9ff] to-[#00b8d4] text-white text-lg font-bold rounded-xl hover:shadow-[0_0_25px_rgba(0,217,255,0.5)] transition-all duration-300 transform hover:scale-105">
						Download Now
					</a>
					<a href="/tokenomics" class="px-8 py-4 bg-transparent border-2 border-[#00d9ff] text-[#00d9ff] text-lg font-bold rounded-xl hover:bg-[#00d9ff]/10 transition-all">
						Learn About $SPLITDO
					</a>
				</div>
			</div>
		</section>

	</main>
</Layout>