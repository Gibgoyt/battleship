---
import Taskbar from "../../../components/k-app/Taskbar.astro";
export const prerender = true;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Wallet - SplitDo</title>
    <link rel="stylesheet" href="/src/styles/global.css" />
  </head>
  <body>
    <main
      class="h-screen overflow-hidden pb-16"
      style="background: linear-gradient(to bottom right, #6b4e3d, #564740, #304445);"
    >
      <section class="px-3 py-3 h-full overflow-hidden flex flex-col">
        <!-- Header -->
        <div class="pt-6 pb-4">
          <h1 class="text-3xl font-bold text-white">Wallet</h1>
          <p class="text-white/70 mt-1">Manage payments and balance</p>
        </div>

        <!-- Wallet Content -->
        <div class="flex-1 overflow-y-auto">
          <div class="space-y-4">
            <!-- Balance Card -->
            <div class="bg-white/95 backdrop-blur-sm rounded-lg shadow-lg p-6">
              <p class="text-gray-600 text-sm mb-2">Total Balance</p>
              <p class="text-4xl font-bold text-[#564740] mb-4">$425.75</p>
              <div class="grid grid-cols-2 gap-4 pt-4 border-t border-gray-200">
                <div>
                  <p class="text-gray-600 text-xs">You owe</p>
                  <p class="text-[#f07d40] font-semibold text-lg">$245.00</p>
                </div>
                <div>
                  <p class="text-gray-600 text-xs">You're owed</p>
                  <p class="text-[#47a49e] font-semibold text-lg">$670.75</p>
                </div>
              </div>
            </div>

            <!-- Payment Methods -->
            <div class="bg-white/95 backdrop-blur-sm rounded-lg shadow-lg p-4">
              <h3 class="font-semibold mb-3">Payment Methods</h3>

              <!-- Crypto Methods (Primary) -->
              <div class="mb-3">
                <p class="text-xs font-semibold text-gray-500 uppercase mb-2">Crypto (Recommended)</p>
                <div class="space-y-2">
                  <!-- Phantom Wallet -->
                  <div class="flex items-center justify-between p-3 bg-gradient-to-r from-purple-50 to-blue-50 border-2 border-purple-200 rounded-lg">
                    <div class="flex items-center gap-3">
                      <div class="w-10 h-10 bg-gradient-to-br from-purple-600 to-blue-600 rounded-lg flex items-center justify-center">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white">
                          <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                          <polyline points="7.5 4.21 12 6.81 16.5 4.21"/>
                          <polyline points="7.5 19.79 7.5 14.6 3 12"/>
                          <polyline points="21 12 16.5 14.6 16.5 19.79"/>
                          <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
                          <line x1="12" x2="12" y1="22.08" y2="12"/>
                        </svg>
                      </div>
                      <div>
                        <p class="font-semibold text-sm">Phantom Wallet</p>
                        <p class="text-gray-600 text-xs">7xKX...d97A</p>
                      </div>
                    </div>
                    <span class="text-purple-600 text-xs font-semibold">Default</span>
                  </div>

                  <!-- USDC -->
                  <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
                    <div class="flex items-center gap-3">
                      <div class="w-10 h-10 bg-gradient-to-br from-blue-500 to-blue-600 rounded-lg flex items-center justify-center">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white">
                          <circle cx="12" cy="12" r="10"/>
                          <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/>
                          <path d="M2 12h20"/>
                        </svg>
                      </div>
                      <div>
                        <p class="font-semibold text-sm">USDC Balance</p>
                        <p class="text-gray-600 text-xs">$2,450.00 available</p>
                      </div>
                    </div>
                  </div>

                  <!-- Solflare Wallet -->
                  <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
                    <div class="flex items-center gap-3">
                      <div class="w-10 h-10 bg-gradient-to-br from-orange-500 to-red-600 rounded-lg flex items-center justify-center">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white">
                          <path d="M12 2v20M2 12h20"/>
                          <path d="m6 18 6-6-6-6"/>
                          <path d="m18 6-6 6 6 6"/>
                        </svg>
                      </div>
                      <div>
                        <p class="font-semibold text-sm">Solflare Wallet</p>
                        <p class="text-gray-600 text-xs">Not connected</p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Traditional Methods (Bridge) -->
              <div class="mt-4">
                <p class="text-xs font-semibold text-gray-500 uppercase mb-2">Traditional (Auto-converts to crypto)</p>
                <div class="space-y-2">
                  <!-- Crypto Card -->
                  <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
                    <div class="flex items-center gap-3">
                      <div class="w-10 h-10 bg-gradient-to-br from-gray-700 to-gray-800 rounded flex items-center justify-center">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white">
                          <rect width="20" height="14" x="2" y="5" rx="2"/>
                          <line x1="2" x2="22" y1="10" y2="10"/>
                        </svg>
                      </div>
                      <div>
                        <p class="font-semibold text-sm">Crypto Card •••• 8921</p>
                        <p class="text-gray-600 text-xs">Coinbase Debit</p>
                      </div>
                    </div>
                  </div>

                  <!-- Bank Account -->
                  <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
                    <div class="flex items-center gap-3">
                      <div class="w-10 h-10 bg-gradient-to-br from-green-500 to-green-600 rounded flex items-center justify-center">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white">
                          <line x1="3" x2="21" y1="22" y2="22"/>
                          <line x1="6" x2="6" y1="18" y2="11"/>
                          <line x1="10" x2="10" y1="18" y2="11"/>
                          <line x1="14" x2="14" y1="18" y2="11"/>
                          <line x1="18" x2="18" y1="18" y2="11"/>
                          <polygon points="12 2 20 7 4 7"/>
                        </svg>
                      </div>
                      <div>
                        <p class="font-semibold text-sm">Bank Account</p>
                        <p class="text-gray-600 text-xs">Chase ••••7890</p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <a href="/k-app-dark/add-payment-method" class="block w-full mt-4 py-2 text-[#f07d40] font-semibold text-sm border-2 border-[#f07d40] rounded-lg hover:bg-[#f07d40] hover:text-white transition-colors text-center">
                + Add Payment Method
              </a>
            </div>

            <!-- Recent Transactions -->
            <div class="bg-white/95 backdrop-blur-sm rounded-lg shadow-lg p-4">
              <h3 class="font-semibold mb-3">Recent Transactions</h3>
              <div class="space-y-2">
                <div class="flex justify-between items-center py-2 border-b border-gray-100">
                  <div>
                    <p class="text-sm font-medium">Payment to Sarah</p>
                    <p class="text-xs text-gray-500">Mar 15, 2025</p>
                  </div>
                  <p class="text-[#f07d40] font-semibold">-$45.00</p>
                </div>
                <div class="flex justify-between items-center py-2 border-b border-gray-100">
                  <div>
                    <p class="text-sm font-medium">Received from Mike</p>
                    <p class="text-xs text-gray-500">Mar 14, 2025</p>
                  </div>
                  <p class="text-[#47a49e] font-semibold">+$60.25</p>
                </div>
                <div class="flex justify-between items-center py-2">
                  <div>
                    <p class="text-sm font-medium">Payment to Alex</p>
                    <p class="text-xs text-gray-500">Mar 10, 2025</p>
                  </div>
                  <p class="text-[#f07d40] font-semibold">-$30.00</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <!-- Bottom Navigation -->
    <Taskbar />
  </body>
</html>
