---
export const prerender = true;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Add Payment Method - SplitDo</title>
    <link rel="stylesheet" href="/src/styles/global.css" />
  </head>
  <body>
    <main
      class="h-screen overflow-hidden pb-16"
      style="background: linear-gradient(to bottom right, #6b4e3d, #564740, #304445);"
    >
      <section class="px-4 py-4 h-full overflow-y-auto">
        <!-- Header -->
        <div class="flex items-center justify-between mb-6">
          <a href="/k-app/wallet" class="text-white/70 hover:text-white transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m15 18-6-6 6-6"/>
            </svg>
          </a>
          <h1 class="text-2xl font-bold text-white">Add Payment Method</h1>
          <div class="w-6"></div>
        </div>

        <!-- Content -->
        <div class="max-w-md mx-auto space-y-4">

          <!-- Crypto Options (Recommended) -->
          <div class="bg-white/95 backdrop-blur-sm rounded-xl p-6 shadow-lg">
            <div class="flex items-center gap-2 mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#47a49e]">
                <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
              </svg>
              <h2 class="text-lg font-bold text-gray-900">Crypto Methods</h2>
              <span class="text-xs bg-[#47a49e] text-white px-2 py-1 rounded-full font-semibold">Recommended</span>
            </div>

            <div class="space-y-3">
              <!-- Connect Solana Wallet -->
              <button class="w-full p-4 bg-gradient-to-r from-purple-50 to-blue-50 border-2 border-purple-200 hover:border-purple-300 rounded-xl transition-all text-left group">
                <div class="flex items-center gap-4">
                  <div class="w-12 h-12 bg-gradient-to-br from-purple-600 to-blue-600 rounded-lg flex items-center justify-center flex-shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white">
                      <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                      <polyline points="7.5 4.21 12 6.81 16.5 4.21"/>
                      <polyline points="7.5 19.79 7.5 14.6 3 12"/>
                      <polyline points="21 12 16.5 14.6 16.5 19.79"/>
                      <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
                      <line x1="12" x2="12" y1="22.08" y2="12"/>
                    </svg>
                  </div>
                  <div class="flex-1">
                    <h3 class="font-semibold text-gray-900 group-hover:text-purple-600 transition-colors">Connect Solana Wallet</h3>
                    <p class="text-sm text-gray-600">Phantom, Solflare, or other Solana wallets</p>
                  </div>
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-400 group-hover:text-purple-600 transition-colors">
                    <path d="m9 18 6-6-6-6"/>
                  </svg>
                </div>
              </button>

              <!-- Add USDC Balance -->
              <button class="w-full p-4 bg-white border-2 border-gray-200 hover:border-blue-300 rounded-xl transition-all text-left group">
                <div class="flex items-center gap-4">
                  <div class="w-12 h-12 bg-gradient-to-br from-blue-500 to-blue-600 rounded-lg flex items-center justify-center flex-shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white">
                      <circle cx="12" cy="12" r="10"/>
                      <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/>
                      <path d="M2 12h20"/>
                    </svg>
                  </div>
                  <div class="flex-1">
                    <h3 class="font-semibold text-gray-900 group-hover:text-blue-600 transition-colors">Add USDC</h3>
                    <p class="text-sm text-gray-600">USD Coin stablecoin on Solana</p>
                  </div>
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-400 group-hover:text-blue-600 transition-colors">
                    <path d="m9 18 6-6-6-6"/>
                  </svg>
                </div>
              </button>
            </div>
          </div>

          <!-- Traditional Options (Bridge) -->
          <div class="bg-white/95 backdrop-blur-sm rounded-xl p-6 shadow-lg">
            <div class="flex items-center gap-2 mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-600">
                <rect width="20" height="14" x="2" y="5" rx="2"/>
                <line x1="2" x2="22" y1="10" y2="10"/>
              </svg>
              <h2 class="text-lg font-bold text-gray-900">Traditional Methods</h2>
            </div>
            <p class="text-xs text-gray-500 mb-4">Auto-converts to crypto for instant settlements</p>

            <div class="space-y-3">
              <!-- Link Crypto Card -->
              <button class="w-full p-4 bg-white border-2 border-gray-200 hover:border-gray-400 rounded-xl transition-all text-left group">
                <div class="flex items-center gap-4">
                  <div class="w-12 h-12 bg-gradient-to-br from-gray-700 to-gray-800 rounded-lg flex items-center justify-center flex-shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white">
                      <rect width="20" height="14" x="2" y="5" rx="2"/>
                      <line x1="2" x2="22" y1="10" y2="10"/>
                    </svg>
                  </div>
                  <div class="flex-1">
                    <h3 class="font-semibold text-gray-900 group-hover:text-gray-700 transition-colors">Link Crypto Card</h3>
                    <p class="text-sm text-gray-600">Coinbase, Crypto.com, or similar debit card</p>
                  </div>
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-400 group-hover:text-gray-700 transition-colors">
                    <path d="m9 18 6-6-6-6"/>
                  </svg>
                </div>
              </button>

              <!-- Link Bank Account -->
              <button class="w-full p-4 bg-white border-2 border-gray-200 hover:border-green-300 rounded-xl transition-all text-left group">
                <div class="flex items-center gap-4">
                  <div class="w-12 h-12 bg-gradient-to-br from-green-500 to-green-600 rounded-lg flex items-center justify-center flex-shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white">
                      <line x1="3" x2="21" y1="22" y2="22"/>
                      <line x1="6" x2="6" y1="18" y2="11"/>
                      <line x1="10" x2="10" y1="18" y2="11"/>
                      <line x1="14" x2="14" y1="18" y2="11"/>
                      <line x1="18" x2="18" y1="18" y2="11"/>
                      <polygon points="12 2 20 7 4 7"/>
                    </svg>
                  </div>
                  <div class="flex-1">
                    <h3 class="font-semibold text-gray-900 group-hover:text-green-600 transition-colors">Link Bank Account</h3>
                    <p class="text-sm text-gray-600">Connect via Plaid for easy funding</p>
                  </div>
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-400 group-hover:text-green-600 transition-colors">
                    <path d="m9 18 6-6-6-6"/>
                  </svg>
                </div>
              </button>
            </div>
          </div>

          <!-- Info Card -->
          <div class="bg-blue-50 border-2 border-blue-200 rounded-xl p-4">
            <div class="flex gap-3">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-blue-600 flex-shrink-0 mt-0.5">
                <circle cx="12" cy="12" r="10"/>
                <path d="M12 16v-4"/>
                <path d="M12 8h.01"/>
              </svg>
              <div>
                <h4 class="font-semibold text-blue-900 text-sm mb-1">Why crypto methods?</h4>
                <p class="text-xs text-blue-800">
                  Crypto payments settle instantly with near-zero fees. Traditional methods auto-convert to crypto but may take longer and have higher fees.
                </p>
              </div>
            </div>
          </div>

        </div>

      </section>
    </main>

    <script>
      // Handle button clicks
      const buttons = document.querySelectorAll('button');
      buttons.forEach(button => {
        button.addEventListener('click', () => {
          // In a real app, each button would open its specific setup flow
          // For now, just show a message and redirect
          const methodName = button.querySelector('h3').textContent;
          alert(`Opening ${methodName} setup...`);
          window.location.href = '/k-app/wallet';
        });
      });
    </script>
  </body>
</html>
