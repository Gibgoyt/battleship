---
export const prerender = true
---

<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Create Account - SplitDo</title>
    <link rel="stylesheet" href="/src/styles/global.css" />
</head>
<body>
  <main class="h-screen overflow-hidden flex items-center justify-center" style="background: linear-gradient(to bottom right, #6b4e3d, #564740, #304445);">

    <section class="w-full px-4 py-3">
      <div class="w-full max-w-sm mx-auto">

        <!-- Header -->
        <div class="text-center mb-3">
          <h1 class="text-2xl font-extrabold text-[#f07d40] tracking-wider mb-1">
            Join SplitDo!
          </h1>
          <p class="text-sm text-white">
            You won't regret it!
          </p>
        </div>

        <!-- Sign Up Form -->
        <div class="bg-white/95 backdrop-blur-sm rounded-xl shadow-2xl p-4">
          <form id="signup-form" class="space-y-2.5">

            <!-- Email -->
            <div>
              <label for="email" class="block text-xs font-semibold text-gray-700 mb-1">
                Email
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full px-3 py-2 text-sm border-2 border-gray-300 rounded-lg focus:border-[#f07d40] focus:ring-1 focus:ring-[#f07d40]/20 outline-none transition-all"
                placeholder="your.email@example.com"
              />
            </div>

            <!-- Username -->
            <div>
              <label for="username" class="block text-xs font-semibold text-gray-700 mb-1">
                Username
              </label>
              <input
                type="text"
                id="username"
                name="username"
                required
                minlength="3"
                maxlength="20"
                class="w-full px-3 py-2 text-sm border-2 border-gray-300 rounded-lg focus:border-[#f07d40] focus:ring-1 focus:ring-[#f07d40]/20 outline-none transition-all"
                placeholder="cooluser123"
              />
            </div>

            <!-- Password -->
            <div>
              <label for="password" class="block text-xs font-semibold text-gray-700 mb-1">
                Password (min 12 chars)
              </label>
              <div class="relative">
                <input
                  type="password"
                  id="password"
                  name="password"
                  required
                  minlength="12"
                  class="w-full px-3 py-2 text-sm border-2 border-gray-300 rounded-lg focus:border-[#f07d40] focus:ring-1 focus:ring-[#f07d40]/20 outline-none transition-all pr-8"
                  placeholder="Strong password"
                />
                <button
                  type="button"
                  id="toggle-password"
                  class="absolute right-2 top-1/2 -translate-y-1/2 text-gray-500"
                >
                  <svg id="eye-open" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                  </svg>
                  <svg id="eye-closed" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" />
                  </svg>
                </button>
              </div>
              <p class="text-xs text-gray-600 mt-0.5">Must include uppercase, lowercase, number & special char</p>
            </div>

            <!-- Confirm Password -->
            <div>
              <label for="confirm-password" class="block text-xs font-semibold text-gray-700 mb-1">
                Confirm Password
              </label>
              <input
                type="password"
                id="confirm-password"
                name="confirm-password"
                required
                class="w-full px-3 py-2 text-sm border-2 border-gray-300 rounded-lg focus:border-[#f07d40] focus:ring-1 focus:ring-[#f07d40]/20 outline-none transition-all"
                placeholder="Re-enter password"
              />
            </div>

            <!-- Security Reminder -->
            <div class="bg-[#47a49e]/10 border border-[#47a49e] rounded-lg p-2">
              <div class="flex items-start gap-2">
                <svg class="w-4 h-4 text-[#47a49e] flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
                </svg>
                <p class="text-xs text-gray-700">
                  <strong>Security Tip:</strong> Write your password on paper and store it safely. Never share it digitally.
                </p>
              </div>
            </div>

            <!-- Checkboxes -->
            <div class="space-y-1.5">
              <div class="flex items-start gap-2">
                <input
                  type="checkbox"
                  id="password-saved"
                  required
                  class="mt-0.5 w-3.5 h-3.5 text-[#f07d40] border-gray-300 rounded focus:ring-[#f07d40]"
                />
                <label for="password-saved" class="text-xs text-gray-700">
                  I've safely stored my password
                </label>
              </div>

              <div class="flex items-start gap-2">
                <input
                  type="checkbox"
                  id="terms"
                  required
                  class="mt-0.5 w-3.5 h-3.5 text-[#f07d40] border-gray-300 rounded focus:ring-[#f07d40]"
                />
                <label for="terms" class="text-xs text-gray-700">
                  I agree to <a href="/terms" class="text-[#f07d40] font-semibold">Terms</a> & <a href="/privacy" class="text-[#f07d40] font-semibold">Privacy</a>
                </label>
              </div>
            </div>

            <!-- Submit Button -->
            <button
              type="submit"
              class="w-full px-4 py-2.5 bg-[#f07d40] hover:bg-[#d86e37] text-white text-sm font-semibold rounded-xl transition-all shadow-lg hover:shadow-xl transform hover:scale-105"
            >
              Create My Account
            </button>

            <!-- Sign In Link -->
            <div class="text-center pt-1">
              <p class="text-xs text-gray-600">
                Already have an account?
                <a href="/k-app-dark/welcome" class="text-[#47a49e] hover:text-[#3a8a82] font-semibold">
                  Sign in
                </a>
              </p>
            </div>

          </form>
        </div>

        <!-- Back Button -->
        <div class="text-center mt-2">
          <a href="/k-app-dark" class="text-white hover:text-[#f07d40] transition-colors text-xs font-medium">
            ← Back to Welcome
          </a>
        </div>

      </div>
    </section>

  </main>

  <script>
    // Password visibility toggle
    const togglePassword = document.getElementById('toggle-password');
    const passwordInput = document.getElementById('password');
    const eyeOpen = document.getElementById('eye-open');
    const eyeClosed = document.getElementById('eye-closed');

    if (togglePassword && passwordInput && eyeOpen && eyeClosed) {
      togglePassword.addEventListener('click', () => {
        const type = passwordInput.type === 'password' ? 'text' : 'password';
        passwordInput.type = type;
        eyeOpen.classList.toggle('hidden');
        eyeClosed.classList.toggle('hidden');
      });
    }

    // Form validation
    const form = document.getElementById('signup-form');
    const confirmPasswordInput = document.getElementById('confirm-password');

    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();

        // Check password match
        if (passwordInput.value !== confirmPasswordInput.value) {
          alert('Passwords do not match!');
          return;
        }

        // Check password strength
        const password = passwordInput.value;
        const hasUppercase = /[A-Z]/.test(password);
        const hasLowercase = /[a-z]/.test(password);
        const hasNumber = /[0-9]/.test(password);
        const hasSpecial = /[!@#$%^&*(),.?":{}|<>]/.test(password);

        if (!hasUppercase || !hasLowercase || !hasNumber || !hasSpecial) {
          alert('Password must contain uppercase, lowercase, number, and special character.');
          return;
        }

        // Success
        console.log('Form submitted successfully!');
        alert('Account created! (Demo - no actual account created)');

        // In production: window.location.href = '/k-app-dark/welcome';
      });
    }
  </script>
</body>
</html>
