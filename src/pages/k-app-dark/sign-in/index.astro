---
export const prerender = true;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In - SplitDo</title>
    <link rel="stylesheet" href="/src/styles/global.css" />
  </head>
  <body>
    <main
      class="h-screen overflow-hidden flex items-center justify-center"
      style="background: linear-gradient(to bottom right, #6b4e3d, #564740, #304445);"
    >
      <section class="w-full max-w-md px-4">
        <div class="bg-white/95 backdrop-blur-sm rounded-2xl shadow-2xl p-8">
          <!-- Header -->
          <div class="text-center mb-8">
            <!-- Logo -->
            <div class="flex justify-center mb-4">
              <svg width="80" height="120" viewBox="0 0 400 600" fill="none" xmlns="http://www.w3.org/2000/svg">
                <defs>
                  <clipPath id="rounded-clip">
                    <rect x="80" y="240" width="240" height="240" rx="30"/>
                  </clipPath>
                </defs>
                <circle cx="200" cy="120" r="80" fill="#f07d40"/>
                <g clip-path="url(#rounded-clip)">
                  <path d="M 80 240 L 320 240 L 80 480 Z" fill="#f07d40"/>
                  <path d="M 320 240 L 320 480 L 80 480 Z" fill="#47a49e"/>
                </g>
              </svg>
            </div>
            <h1 class="text-3xl font-bold text-[#564740] mb-2">Welcome Back!</h1>
            <p class="text-gray-600">Sign in to your SplitDo account</p>
          </div>

          <!-- Sign In Form -->
          <form class="space-y-5">
            <!-- Email Input -->
            <div>
              <label for="email" class="block text-sm font-semibold text-gray-700 mb-2">
                Email Address
              </label>
              <input
                type="email"
                id="email"
                name="email"
                placeholder="you@example.com"
                class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:border-[#f07d40] focus:outline-none focus:ring-2 focus:ring-[#f07d40]/20 transition-all"
                required
              />
            </div>

            <!-- Password Input -->
            <div>
              <label for="password" class="block text-sm font-semibold text-gray-700 mb-2">
                Password
              </label>
              <input
                type="password"
                id="password"
                name="password"
                placeholder="Enter your password"
                class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:border-[#f07d40] focus:outline-none focus:ring-2 focus:ring-[#f07d40]/20 transition-all"
                required
              />
            </div>

            <!-- Remember Me & Forgot Password -->
            <div class="flex items-center justify-between">
              <label class="flex items-center">
                <input
                  type="checkbox"
                  class="w-4 h-4 text-[#f07d40] border-gray-300 rounded focus:ring-[#f07d40]"
                />
                <span class="ml-2 text-sm text-gray-600">Remember me</span>
              </label>
              <a href="#" class="text-sm text-[#f07d40] hover:text-[#d86e37] font-semibold">
                Forgot Password?
              </a>
            </div>

            <!-- Sign In Button -->
            <button
              type="submit"
              class="w-full px-6 py-3 bg-[#f07d40] hover:bg-[#d86e37] text-white font-semibold rounded-lg shadow-lg hover:shadow-xl transform hover:scale-105 transition-all"
            >
              Sign In
            </button>
          </form>

          <!-- Divider -->
          <div class="relative my-6">
            <div class="absolute inset-0 flex items-center">
              <div class="w-full border-t border-gray-300"></div>
            </div>
            <div class="relative flex justify-center text-sm">
              <span class="px-4 bg-white text-gray-500">Or continue with</span>
            </div>
          </div>

          <!-- Social Sign In -->
          <div class="grid grid-cols-2 gap-3">
            <button
              type="button"
              class="flex items-center justify-center px-4 py-2.5 border-2 border-gray-300 rounded-lg hover:bg-gray-50 transition-all"
            >
              <svg class="w-5 h-5 mr-2" viewBox="0 0 24 24">
                <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
              </svg>
              <span class="text-sm font-semibold text-gray-700">Google</span>
            </button>
            <button
              type="button"
              class="flex items-center justify-center px-4 py-2.5 border-2 border-gray-300 rounded-lg hover:bg-gray-50 transition-all"
            >
              <svg class="w-5 h-5 mr-2" fill="#1877F2" viewBox="0 0 24 24">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
              <span class="text-sm font-semibold text-gray-700">Facebook</span>
            </button>
          </div>

          <!-- Sign Up Link -->
          <div class="text-center mt-6">
            <p class="text-sm text-gray-600">
              Don't have an account?
              <a href="/k-app-dark/create-account" class="text-[#f07d40] hover:text-[#d86e37] font-semibold ml-1">
                Create Account
              </a>
            </p>
          </div>

          <!-- Back to Home -->
          <div class="text-center mt-4">
            <a href="/k-app-dark" class="text-sm text-gray-500 hover:text-gray-700">
              ← Back to Home
            </a>
          </div>
        </div>
      </section>
    </main>

    <script>
      // Handle form submission
      const form = document.querySelector('form');
      if (form) {
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          // In a real app, this would authenticate the user
          // For now, just redirect to the welcome page
          window.location.href = '/k-app-dark/welcome';
        });
      }
    </script>
  </body>
</html>
