---
export const prerender = true;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Send Payment - SplitDo</title>
    <link rel="stylesheet" href="/src/styles/global.css" />
  </head>
  <body>
    <main
      class="h-screen overflow-hidden pb-16"
      style="background: linear-gradient(to bottom right, #6b4e3d, #564740, #304445);"
    >
      <section class="px-4 py-4 h-full overflow-y-auto">
        <!-- Header -->
        <div class="flex items-center justify-between mb-6">
          <a href="/k-app-dark/welcome" class="text-white/70 hover:text-white transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m15 18-6-6 6-6"/>
            </svg>
          </a>
          <h1 class="text-2xl font-bold text-white">Send Payment</h1>
          <div class="w-6"></div>
        </div>

        <!-- Form -->
        <div class="max-w-md mx-auto">
          <form class="space-y-5">

            <!-- Pay To -->
            <div class="bg-white/95 backdrop-blur-sm rounded-xl p-6 shadow-lg">
              <label for="payTo" class="block text-sm font-semibold text-gray-700 mb-2">
                Pay To
              </label>
              <select
                id="payTo"
                name="payTo"
                class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:border-[#f07d40] focus:outline-none focus:ring-2 focus:ring-[#f07d40]/20 transition-all appearance-none bg-white"
                required
              >
                <option value="">Select a person...</option>
                <option value="sarah">Sarah - You owe $125.00</option>
                <option value="mike">Mike - You owe $95.50</option>
                <option value="alex">Alex - You owe $104.50</option>
              </select>
            </div>

            <!-- Amount -->
            <div class="bg-white/95 backdrop-blur-sm rounded-xl p-6 shadow-lg">
              <label for="amount" class="block text-sm font-semibold text-gray-700 mb-2">
                Amount
              </label>
              <div class="relative">
                <span class="absolute left-4 top-1/2 -translate-y-1/2 text-2xl font-bold text-gray-400">$</span>
                <input
                  type="number"
                  id="amount"
                  name="amount"
                  step="0.01"
                  placeholder="0.00"
                  class="w-full pl-10 pr-4 py-4 text-3xl font-bold border-2 border-gray-300 rounded-lg focus:border-[#f07d40] focus:outline-none focus:ring-2 focus:ring-[#f07d40]/20 transition-all"
                  required
                />
              </div>
              <button type="button" id="payFullAmount" class="mt-2 text-sm text-[#47a49e] hover:text-[#3a8a82] font-semibold">
                Pay full amount owed
              </button>
            </div>

            <!-- Payment Method -->
            <div class="bg-white/95 backdrop-blur-sm rounded-xl p-6 shadow-lg">
              <label for="paymentMethod" class="block text-sm font-semibold text-gray-700 mb-2">
                Payment Method
              </label>
              <select
                id="paymentMethod"
                name="paymentMethod"
                class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:border-[#f07d40] focus:outline-none focus:ring-2 focus:ring-[#f07d40]/20 transition-all appearance-none bg-white"
                required
              >
                <option value="">Select payment method...</option>
                <option value="phantom">💜 Phantom Wallet (Recommended)</option>
                <option value="usdc">💵 USDC - $2,450.00 available</option>
                <option value="solflare">🔥 Solflare Wallet</option>
                <option value="crypto-card">💳 Crypto Card ••••8921</option>
                <option value="bank">🏦 Bank Account ••••7890</option>
              </select>
            </div>

            <!-- Note (Optional) -->
            <div class="bg-white/95 backdrop-blur-sm rounded-xl p-6 shadow-lg">
              <label for="note" class="block text-sm font-semibold text-gray-700 mb-2">
                Note (Optional)
              </label>
              <textarea
                id="note"
                name="note"
                placeholder="e.g., For dinner last week"
                rows="3"
                class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:border-[#f07d40] focus:outline-none focus:ring-2 focus:ring-[#f07d40]/20 transition-all resize-none"
              ></textarea>
            </div>

            <!-- Transaction Fee Info -->
            <div class="bg-blue-50 border-2 border-blue-200 rounded-xl p-4">
              <div class="flex gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-blue-600 flex-shrink-0 mt-0.5">
                  <circle cx="12" cy="12" r="10"/>
                  <path d="M12 16v-4"/>
                  <path d="M12 8h.01"/>
                </svg>
                <div>
                  <h4 class="font-semibold text-blue-900 text-sm mb-1">Transaction Fee</h4>
                  <p class="text-xs text-blue-800">
                    Solana transactions cost ~$0.00025 (fractions of a penny). Traditional methods may have higher fees.
                  </p>
                </div>
              </div>
            </div>

            <!-- Summary -->
            <div class="bg-gradient-to-r from-[#f07d40]/10 to-[#47a49e]/10 border-2 border-[#f07d40]/30 rounded-xl p-4">
              <h3 class="font-semibold text-gray-900 mb-3">Payment Summary</h3>
              <div class="space-y-2 text-sm">
                <div class="flex justify-between">
                  <span class="text-gray-600">Amount:</span>
                  <span class="font-semibold text-gray-900" id="summaryAmount">$0.00</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-gray-600">Transaction Fee:</span>
                  <span class="font-semibold text-green-600" id="summaryFee">~$0.00025</span>
                </div>
                <div class="flex justify-between pt-2 border-t border-gray-300">
                  <span class="font-semibold text-gray-900">Total:</span>
                  <span class="font-bold text-gray-900 text-lg" id="summaryTotal">$0.00</span>
                </div>
              </div>
            </div>

            <!-- Submit Button -->
            <button
              type="submit"
              class="w-full px-6 py-4 bg-[#47a49e] hover:bg-[#3a8a82] text-white font-semibold rounded-xl shadow-lg hover:shadow-xl transform hover:scale-105 transition-all"
            >
              Send Payment
            </button>

            <!-- Cancel Button -->
            <a
              href="/k-app-dark/welcome"
              class="block w-full px-6 py-4 bg-white/95 hover:bg-white text-[#564740] font-medium rounded-xl shadow-lg text-center transition-all"
            >
              Cancel
            </a>

          </form>
        </div>

      </section>
    </main>

    <script>
      // Update summary when amount changes
      const amountInput = document.getElementById('amount');
      const summaryAmount = document.getElementById('summaryAmount');
      const summaryTotal = document.getElementById('summaryTotal');
      const paymentMethodSelect = document.getElementById('paymentMethod');
      const summaryFee = document.getElementById('summaryFee');

      function updateSummary() {
        const amount = parseFloat(amountInput.value) || 0;
        const method = paymentMethodSelect.value;

        // Calculate fee based on payment method
        let fee = 0.00025; // Crypto default
        if (method === 'bank' || method === 'crypto-card') {
          fee = amount * 0.029; // 2.9% for traditional methods
        }

        summaryAmount.textContent = `$${amount.toFixed(2)}`;

        if (method === 'bank' || method === 'crypto-card') {
          summaryFee.textContent = `$${fee.toFixed(2)}`;
          summaryFee.classList.remove('text-green-600');
          summaryFee.classList.add('text-orange-600');
        } else {
          summaryFee.textContent = `~$0.00025`;
          summaryFee.classList.remove('text-orange-600');
          summaryFee.classList.add('text-green-600');
        }

        summaryTotal.textContent = `$${(amount + fee).toFixed(2)}`;
      }

      if (amountInput) {
        amountInput.addEventListener('input', updateSummary);
      }

      if (paymentMethodSelect) {
        paymentMethodSelect.addEventListener('change', updateSummary);
      }

      // Pay full amount button
      const payToSelect = document.getElementById('payTo');
      const payFullButton = document.getElementById('payFullAmount');

      if (payFullButton) {
        payFullButton.addEventListener('click', () => {
          const selectedOption = payToSelect.value;
          let amount = 0;

          // Extract amount from selection
          if (selectedOption === 'sarah') amount = 125.00;
          if (selectedOption === 'mike') amount = 95.50;
          if (selectedOption === 'alex') amount = 104.50;

          if (amount > 0) {
            amountInput.value = amount.toFixed(2);
            updateSummary();
          } else {
            alert('Please select a person to pay first');
          }
        });
      }

      // Handle form submission
      const form = document.querySelector('form');
      if (form) {
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          const person = payToSelect.options[payToSelect.selectedIndex].text.split(' - ')[0];
          const amount = amountInput.value;
          // In a real app, this would process the payment
          alert(`Payment of $${amount} sent to ${person}!`);
          window.location.href = '/k-app-dark/welcome';
        });
      }
    </script>
  </body>
</html>
