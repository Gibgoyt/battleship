---
export const prerender = true;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>About - SplitDo</title>
    <link rel="stylesheet" href="/src/styles/global.css" />
  </head>
  <body>
    <main
      class="h-screen overflow-hidden"
      style="background: linear-gradient(to bottom right, #6b4e3d, #564740, #304445);"
    >
      <section class="px-4 py-4 h-full overflow-y-auto">
        <!-- Header -->
        <div class="flex items-center justify-between mb-6">
          <a href="/k-app-dark/settings" class="text-white/70 hover:text-white transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m15 18-6-6 6-6"/>
            </svg>
          </a>
          <h1 class="text-2xl font-bold text-white">About SplitDo</h1>
          <div class="w-6"></div>
        </div>

        <!-- Content -->
        <div class="max-w-md mx-auto space-y-4 pb-8">

          <!-- App Info -->
          <div class="bg-white/95 backdrop-blur-sm rounded-xl p-6 shadow-lg text-center">
            <!-- Logo -->
            <div class="flex justify-center mb-4">
              <img src="/splitdo/logo_light.svg" alt="SplitDo Logo" class="h-20 w-auto dark:hidden">
              <img src="/splitdo/logo_dark.svg" alt="SplitDo Logo" class="h-20 w-auto hidden dark:block">
            </div>

            <h2 class="text-2xl font-bold text-[#564740] mb-2">SplitDo</h2>
            <p class="text-gray-600 mb-4">Split expenses seamlessly on Solana</p>

            <div class="inline-block bg-[#f07d40]/10 border-2 border-[#f07d40] rounded-lg px-4 py-2">
              <p class="text-sm font-semibold text-[#564740]">Version 1.0.0</p>
            </div>
          </div>

          <!-- Tagline -->
          <div class="bg-gradient-to-r from-[#f07d40]/20 to-[#47a49e]/20 rounded-xl p-6 shadow-lg text-center border-2 border-[#f07d40]/30">
            <p class="text-lg font-semibold text-white mb-2">Made with ❤️ on Solana</p>
            <p class="text-sm text-white/80">Lightning-fast settlements, near-zero fees</p>
          </div>

          <!-- Quick Links -->
          <div class="bg-white/95 backdrop-blur-sm rounded-xl p-6 shadow-lg">
            <h3 class="font-semibold text-gray-900 mb-4">Resources</h3>
            <div class="space-y-2">
              <a href="/" target="_blank" class="flex items-center justify-between p-3 hover:bg-gray-50 rounded-lg transition-colors">
                <div class="flex items-center gap-3">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#47a49e]">
                    <circle cx="12" cy="12" r="10"/>
                    <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/>
                    <path d="M2 12h20"/>
                  </svg>
                  <span class="text-gray-700 font-medium">Visit Website</span>
                </div>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-400">
                  <path d="M7 7h10v10"/>
                  <path d="M7 17 17 7"/>
                </svg>
              </a>

              <a href="/features" target="_blank" class="flex items-center justify-between p-3 hover:bg-gray-50 rounded-lg transition-colors">
                <div class="flex items-center gap-3">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#47a49e]">
                    <path d="M12 20a8 8 0 1 0 0-16 8 8 0 0 0 0 16Z"/>
                    <path d="M12 14a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z"/>
                    <path d="M12 2v2"/>
                    <path d="M12 22v-2"/>
                    <path d="m17 20.66-1-1.73"/>
                    <path d="M11 10.27 7 3.34"/>
                    <path d="m20.66 17-1.73-1"/>
                    <path d="m3.34 7 1.73 1"/>
                    <path d="M14 12h8"/>
                    <path d="M2 12h2"/>
                    <path d="m20.66 7-1.73 1"/>
                    <path d="m3.34 17 1.73-1"/>
                    <path d="m17 3.34-1 1.73"/>
                    <path d="m11 13.73-4 6.93"/>
                  </svg>
                  <span class="text-gray-700 font-medium">Features</span>
                </div>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-400">
                  <path d="M7 7h10v10"/>
                  <path d="M7 17 17 7"/>
                </svg>
              </a>
            </div>
          </div>

          <!-- Legal & Policies -->
          <div class="bg-white/95 backdrop-blur-sm rounded-xl p-6 shadow-lg">
            <h3 class="font-semibold text-gray-900 mb-4">Legal & Policies</h3>
            <div class="space-y-2">
              <a href="/privacy" target="_blank" class="flex items-center justify-between p-3 hover:bg-gray-50 rounded-lg transition-colors">
                <span class="text-gray-700">Privacy Policy</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-400">
                  <path d="M7 7h10v10"/>
                  <path d="M7 17 17 7"/>
                </svg>
              </a>

              <a href="#" class="flex items-center justify-between p-3 hover:bg-gray-50 rounded-lg transition-colors">
                <span class="text-gray-700">Terms of Service</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-400">
                  <path d="M7 7h10v10"/>
                  <path d="M7 17 17 7"/>
                </svg>
              </a>

              <a href="#" class="flex items-center justify-between p-3 hover:bg-gray-50 rounded-lg transition-colors">
                <span class="text-gray-700">Open Source Licenses</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-400">
                  <path d="M7 7h10v10"/>
                  <path d="M7 17 17 7"/>
                </svg>
              </a>
            </div>
          </div>

          <!-- Contact & Support -->
          <div class="bg-white/95 backdrop-blur-sm rounded-xl p-6 shadow-lg">
            <h3 class="font-semibold text-gray-900 mb-4">Contact & Support</h3>
            <div class="space-y-3">
              <a href="mailto:support@splitdo.com" class="flex items-center gap-3 p-3 hover:bg-gray-50 rounded-lg transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#47a49e]">
                  <rect width="20" height="16" x="2" y="4" rx="2"/>
                  <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                </svg>
                <div>
                  <p class="text-gray-700 font-medium">Email Support</p>
                  <p class="text-xs text-gray-500">support@splitdo.com</p>
                </div>
              </a>
            </div>
          </div>

          <!-- Social Links -->
          <div class="bg-white/95 backdrop-blur-sm rounded-xl p-6 shadow-lg">
            <h3 class="font-semibold text-gray-900 mb-4">Community</h3>
            <div class="grid grid-cols-3 gap-3">
              <a href="https://twitter.com/splitdo" target="_blank" class="flex flex-col items-center gap-2 p-3 hover:bg-gray-50 rounded-lg transition-colors">
                <div class="w-10 h-10 bg-blue-500 rounded-full flex items-center justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="white">
                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                  </svg>
                </div>
                <span class="text-xs font-medium text-gray-700">Twitter</span>
              </a>

              <a href="https://discord.gg/splitdo" target="_blank" class="flex flex-col items-center gap-2 p-3 hover:bg-gray-50 rounded-lg transition-colors">
                <div class="w-10 h-10 bg-indigo-500 rounded-full flex items-center justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="white">
                    <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
                  </svg>
                </div>
                <span class="text-xs font-medium text-gray-700">Discord</span>
              </a>

              <a href="https://github.com/splitdo" target="_blank" class="flex flex-col items-center gap-2 p-3 hover:bg-gray-50 rounded-lg transition-colors">
                <div class="w-10 h-10 bg-gray-800 rounded-full flex items-center justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="white">
                    <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                  </svg>
                </div>
                <span class="text-xs font-medium text-gray-700">GitHub</span>
              </a>
            </div>
          </div>

          <!-- Copyright -->
          <div class="text-center py-4">
            <p class="text-sm text-white/70">© 2025 SplitDo. All rights reserved.</p>
            <p class="text-xs text-white/50 mt-1">Built on Solana blockchain</p>
          </div>

        </div>

      </section>
    </main>
  </body>
</html>
