---
export const prerender = true;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit Profile - SplitDo</title>
    <link rel="stylesheet" href="/src/styles/global.css" />
  </head>
  <body>
    <main
      class="h-screen overflow-hidden pb-16"
      style="background: linear-gradient(to bottom right, #6b4e3d, #564740, #304445);"
    >
      <section class="px-4 py-4 h-full overflow-y-auto">
        <!-- Header -->
        <div class="flex items-center justify-between mb-6">
          <a href="/k-app-dark/profile" class="text-white/70 hover:text-white transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m15 18-6-6 6-6"/>
            </svg>
          </a>
          <h1 class="text-2xl font-bold text-white">Edit Profile</h1>
          <div class="w-6"></div>
        </div>

        <!-- Form -->
        <div class="max-w-md mx-auto space-y-4">

          <!-- Profile Picture -->
          <div class="bg-white/95 backdrop-blur-sm rounded-xl p-6 shadow-lg">
            <h3 class="text-sm font-semibold text-gray-700 mb-4">Profile Picture</h3>
            <div class="flex items-center gap-4">
              <div class="w-20 h-20 bg-gradient-to-br from-[#f07d40] to-[#47a49e] rounded-full flex items-center justify-center text-white text-3xl font-bold">
                A
              </div>
              <div class="flex-1">
                <button class="w-full py-2 px-4 bg-[#f07d40] hover:bg-[#d86e37] text-white text-sm font-semibold rounded-lg transition-colors">
                  Change Photo
                </button>
                <p class="text-xs text-gray-500 mt-2">JPG, PNG or GIF (Max 2MB)</p>
              </div>
            </div>
          </div>

          <!-- Personal Information -->
          <div class="bg-white/95 backdrop-blur-sm rounded-xl p-6 shadow-lg">
            <h3 class="text-sm font-semibold text-gray-700 mb-4">Personal Information</h3>
            <form class="space-y-4">

              <!-- Full Name -->
              <div>
                <label for="fullName" class="block text-sm font-medium text-gray-700 mb-2">
                  Full Name
                </label>
                <input
                  type="text"
                  id="fullName"
                  name="fullName"
                  value="Alex Johnson"
                  class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:border-[#f07d40] focus:outline-none focus:ring-2 focus:ring-[#f07d40]/20 transition-all"
                  required
                />
              </div>

              <!-- Email -->
              <div>
                <label for="email" class="block text-sm font-medium text-gray-700 mb-2">
                  Email Address
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  value="alex.johnson@email.com"
                  class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:border-[#f07d40] focus:outline-none focus:ring-2 focus:ring-[#f07d40]/20 transition-all"
                  required
                />
              </div>

              <!-- Phone Number -->
              <div>
                <label for="phone" class="block text-sm font-medium text-gray-700 mb-2">
                  Phone Number
                </label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  value="+1 (555) 123-4567"
                  placeholder="+1 (555) 000-0000"
                  class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:border-[#f07d40] focus:outline-none focus:ring-2 focus:ring-[#f07d40]/20 transition-all"
                />
              </div>

              <!-- Username -->
              <div>
                <label for="username" class="block text-sm font-medium text-gray-700 mb-2">
                  Username
                </label>
                <input
                  type="text"
                  id="username"
                  name="username"
                  value="@alexj"
                  class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:border-[#f07d40] focus:outline-none focus:ring-2 focus:ring-[#f07d40]/20 transition-all"
                />
              </div>

            </form>
          </div>

          <!-- Change Password -->
          <div class="bg-white/95 backdrop-blur-sm rounded-xl p-6 shadow-lg">
            <h3 class="text-sm font-semibold text-gray-700 mb-4">Change Password</h3>
            <form class="space-y-4">

              <!-- Current Password -->
              <div>
                <label for="currentPassword" class="block text-sm font-medium text-gray-700 mb-2">
                  Current Password
                </label>
                <input
                  type="password"
                  id="currentPassword"
                  name="currentPassword"
                  placeholder="Enter current password"
                  class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:border-[#f07d40] focus:outline-none focus:ring-2 focus:ring-[#f07d40]/20 transition-all"
                />
              </div>

              <!-- New Password -->
              <div>
                <label for="newPassword" class="block text-sm font-medium text-gray-700 mb-2">
                  New Password
                </label>
                <input
                  type="password"
                  id="newPassword"
                  name="newPassword"
                  placeholder="Enter new password"
                  class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:border-[#f07d40] focus:outline-none focus:ring-2 focus:ring-[#f07d40]/20 transition-all"
                />
              </div>

              <!-- Confirm New Password -->
              <div>
                <label for="confirmPassword" class="block text-sm font-medium text-gray-700 mb-2">
                  Confirm New Password
                </label>
                <input
                  type="password"
                  id="confirmPassword"
                  name="confirmPassword"
                  placeholder="Confirm new password"
                  class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:border-[#f07d40] focus:outline-none focus:ring-2 focus:ring-[#f07d40]/20 transition-all"
                />
              </div>

            </form>
          </div>

          <!-- Wallet Address -->
          <div class="bg-white/95 backdrop-blur-sm rounded-xl p-6 shadow-lg">
            <h3 class="text-sm font-semibold text-gray-700 mb-4">Solana Wallet</h3>
            <div class="space-y-4">

              <!-- Wallet Address -->
              <div>
                <label for="walletAddress" class="block text-sm font-medium text-gray-700 mb-2">
                  Wallet Address
                </label>
                <div class="flex gap-2">
                  <input
                    type="text"
                    id="walletAddress"
                    name="walletAddress"
                    value="7xKXtg2CW87d..."
                    class="flex-1 px-4 py-3 border-2 border-gray-300 rounded-lg bg-gray-50 text-gray-600"
                    readonly
                  />
                  <button class="px-4 py-3 bg-[#47a49e] hover:bg-[#3a8a82] text-white font-semibold rounded-lg transition-colors">
                    Copy
                  </button>
                </div>
                <p class="text-xs text-gray-500 mt-2">Your Solana wallet for receiving payments</p>
              </div>

              <button class="w-full py-3 px-4 bg-transparent border-2 border-[#f07d40] text-[#f07d40] hover:bg-[#f07d40] hover:text-white font-semibold rounded-lg transition-colors">
                Connect Different Wallet
              </button>

            </div>
          </div>

          <!-- Action Buttons -->
          <div class="space-y-3 pt-4">
            <button
              type="submit"
              class="w-full px-6 py-4 bg-[#f07d40] hover:bg-[#d86e37] text-white font-semibold rounded-xl shadow-lg hover:shadow-xl transform hover:scale-105 transition-all"
            >
              Save Changes
            </button>

            <a
              href="/k-app-dark/profile"
              class="block w-full px-6 py-4 bg-white/95 hover:bg-white text-[#564740] font-medium rounded-xl shadow-lg text-center transition-all"
            >
              Cancel
            </a>
          </div>

        </div>

      </section>
    </main>

    <script>
      // Handle save button
      const saveButton = document.querySelector('button[type="submit"]');
      if (saveButton) {
        saveButton.addEventListener('click', (e) => {
          e.preventDefault();
          // In a real app, this would save the profile changes
          // For now, just show success and redirect
          alert('Profile updated successfully!');
          window.location.href = '/k-app-dark/profile';
        });
      }

      // Handle copy wallet address
      const copyButton = document.querySelector('button:has-text("Copy")');
      const copyButtons = Array.from(document.querySelectorAll('button')).filter(btn => btn.textContent.trim() === 'Copy');
      if (copyButtons.length > 0) {
        copyButtons[0].addEventListener('click', (e) => {
          e.preventDefault();
          const walletInput = document.getElementById('walletAddress');
          if (walletInput) {
            navigator.clipboard.writeText(walletInput.value);
            copyButtons[0].textContent = 'Copied!';
            setTimeout(() => {
              copyButtons[0].textContent = 'Copy';
            }, 2000);
          }
        });
      }
    </script>
  </body>
</html>
