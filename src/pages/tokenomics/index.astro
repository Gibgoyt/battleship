---
import Layout from 'src/layouts/Layout.astro';

export const prerender = true;
---

<Layout title="Tokenomics - SplitDo">
	<main class="bg-white dark:bg-[#0a0f1e]">

		<!-- Hero Section -->
		<section class="relative overflow-hidden bg-gradient-to-b from-gray-50 to-white dark:from-[#12171f] dark:to-[#0a0f1e] border-b border-gray-200 dark:border-[#00d9ff]/20">
			<div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
				<div class="text-center max-w-4xl mx-auto">
					<h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold mb-6 text-gray-900 dark:text-white">
						$SPLITDO Tokenomics
					</h1>
					<p class="text-xl md:text-2xl text-gray-600 dark:text-gray-300 mb-8">
						A utility-first token designed for real-world settlement infrastructure
					</p>
					<div class="flex flex-wrap justify-center gap-4 text-sm">
						<div class="bg-gray-100 dark:bg-[#12171f] border border-gray-200 dark:border-[#00d9ff]/30 rounded-xl px-6 py-3">
							<div class="text-gray-600 dark:text-gray-400 text-xs mb-1">Total Supply</div>
							<div class="text-2xl font-bold text-[#00d9ff]">100M</div>
						</div>
						<div class="bg-gray-100 dark:bg-[#12171f] border border-gray-200 dark:border-[#00d9ff]/30 rounded-xl px-6 py-3">
							<div class="text-gray-600 dark:text-gray-400 text-xs mb-1">Token Type</div>
							<div class="text-2xl font-bold text-[#00d9ff]">Utility</div>
						</div>
						<div class="bg-gray-100 dark:bg-[#12171f] border border-gray-200 dark:border-[#00d9ff]/30 rounded-xl px-6 py-3">
							<div class="text-gray-600 dark:text-gray-400 text-xs mb-1">Blockchain</div>
							<div class="text-2xl font-bold text-[#00d9ff]">Solana</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Token Purpose -->
		<section class="py-16 lg:py-20 bg-white dark:bg-[#0a0f1e]">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="max-w-3xl mx-auto text-center mb-12">
					<h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-6">
						Token Purpose
					</h2>
					<p class="text-lg text-gray-600 dark:text-gray-300 leading-relaxed">
						The SplitDo token is not the product. It's a coordination tool. Its role is simple: reduce platform fees, reward genuine usage, enable limited governance, and support ecosystem growth.
					</p>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
					<div class="border border-gray-200 dark:border-gray-700 rounded-xl p-6 hover:border-[#00d9ff] transition-colors">
						<h3 class="text-lg font-bold text-gray-900 dark:text-white mb-2">Reduce Fees</h3>
						<p class="text-gray-600 dark:text-gray-300 text-sm">Lower platform costs for token holders</p>
					</div>

					<div class="border border-gray-200 dark:border-gray-700 rounded-xl p-6 hover:border-[#00d9ff] transition-colors">
						<h3 class="text-lg font-bold text-gray-900 dark:text-white mb-2">Reward Usage</h3>
						<p class="text-gray-600 dark:text-gray-300 text-sm">Incentivize genuine platform activity</p>
					</div>

					<div class="border border-gray-200 dark:border-gray-700 rounded-xl p-6 hover:border-[#00d9ff] transition-colors">
						<h3 class="text-lg font-bold text-gray-900 dark:text-white mb-2">Governance</h3>
						<p class="text-gray-600 dark:text-gray-300 text-sm">Enable community-driven decisions</p>
					</div>

					<div class="border border-gray-200 dark:border-gray-700 rounded-xl p-6 hover:border-[#00d9ff] transition-colors">
						<h3 class="text-lg font-bold text-gray-900 dark:text-white mb-2">Growth</h3>
						<p class="text-gray-600 dark:text-gray-300 text-sm">Support ecosystem expansion</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Token Allocation with Donut Chart -->
		<section class="py-16 lg:py-20 bg-gray-50 dark:bg-[#12171f]">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="text-center mb-12">
					<h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4">
						Token Distribution
					</h2>
					<p class="text-gray-600 dark:text-gray-300 text-lg max-w-2xl mx-auto">
						Fixed supply of 100,000,000 tokens with no inflation or hidden minting
					</p>
				</div>

				<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
					<!-- Donut Chart -->
					<div class="flex justify-center">
						<div class="relative w-full max-w-md aspect-square">
							<svg viewBox="0 0 400 400" class="w-full h-full">
								<!-- Strategic/Institutional: 31.5% -->
								<circle cx="200" cy="200" r="140" fill="none" stroke="#00d9ff" stroke-width="60"
									stroke-dasharray="277 880" transform="rotate(-90 200 200)" class="hover:stroke-width-65 transition-all cursor-pointer" />

								<!-- Liquidity: 20% -->
								<circle cx="200" cy="200" r="140" fill="none" stroke="#00b8d4" stroke-width="60"
									stroke-dasharray="176 880" stroke-dashoffset="-277" transform="rotate(-90 200 200)" class="hover:stroke-width-65 transition-all cursor-pointer" />

								<!-- Treasury: 10% -->
								<circle cx="200" cy="200" r="140" fill="none" stroke="#0095ad" stroke-width="60"
									stroke-dasharray="88 880" stroke-dashoffset="-453" transform="rotate(-90 200 200)" class="hover:stroke-width-65 transition-all cursor-pointer" />

								<!-- Strategic Partners: 10% -->
								<circle cx="200" cy="200" r="140" fill="none" stroke="#007a8c" stroke-width="60"
									stroke-dasharray="88 880" stroke-dashoffset="-541" transform="rotate(-90 200 200)" class="hover:stroke-width-65 transition-all cursor-pointer" />

								<!-- Team: 10% -->
								<circle cx="200" cy="200" r="140" fill="none" stroke="#005f6b" stroke-width="60"
									stroke-dasharray="88 880" stroke-dashoffset="-629" transform="rotate(-90 200 200)" class="hover:stroke-width-65 transition-all cursor-pointer" />

								<!-- Seed: 8.5% -->
								<circle cx="200" cy="200" r="140" fill="none" stroke="#cbd5e1" stroke-width="60"
									stroke-dasharray="75 880" stroke-dashoffset="-717" transform="rotate(-90 200 200)" class="hover:stroke-width-65 transition-all cursor-pointer" />

								<!-- Marketing: 5% -->
								<circle cx="200" cy="200" r="140" fill="none" stroke="#94a3b8" stroke-width="60"
									stroke-dasharray="44 880" stroke-dashoffset="-792" transform="rotate(-90 200 200)" class="hover:stroke-width-65 transition-all cursor-pointer" />

								<!-- Legal: 5% -->
								<circle cx="200" cy="200" r="140" fill="none" stroke="#64748b" stroke-width="60"
									stroke-dasharray="44 880" stroke-dashoffset="-836" transform="rotate(-90 200 200)" class="hover:stroke-width-65 transition-all cursor-pointer" />

								<!-- Center text -->
								<text x="200" y="190" text-anchor="middle" class="fill-gray-900 dark:fill-white text-2xl font-bold">100M</text>
								<text x="200" y="215" text-anchor="middle" class="fill-gray-600 dark:fill-gray-300 text-sm">Total Supply</text>
							</svg>
						</div>
					</div>

					<!-- Allocation Table -->
					<div class="space-y-3">
						<div class="flex items-center justify-between p-4 bg-white dark:bg-[#0a0f1e] border border-gray-200 dark:border-gray-700 rounded-lg hover:border-[#00d9ff] transition-colors">
							<div class="flex items-center gap-3">
								<div class="w-4 h-4 rounded-full" style="background-color: #00d9ff;"></div>
								<div>
									<div class="font-semibold text-gray-900 dark:text-white">Strategic / Institutional</div>
									<div class="text-sm text-gray-600 dark:text-gray-400">31,500,000 tokens</div>
								</div>
							</div>
							<div class="text-xl font-bold text-[#00d9ff]">31.5%</div>
						</div>

						<div class="flex items-center justify-between p-4 bg-white dark:bg-[#0a0f1e] border border-gray-200 dark:border-gray-700 rounded-lg hover:border-[#00d9ff] transition-colors">
							<div class="flex items-center gap-3">
								<div class="w-4 h-4 rounded-full" style="background-color: #00b8d4;"></div>
								<div>
									<div class="font-semibold text-gray-900 dark:text-white">Liquidity & Market Support</div>
									<div class="text-sm text-gray-600 dark:text-gray-400">20,000,000 tokens</div>
								</div>
							</div>
							<div class="text-xl font-bold text-[#00d9ff]">20%</div>
						</div>

						<div class="flex items-center justify-between p-4 bg-white dark:bg-[#0a0f1e] border border-gray-200 dark:border-gray-700 rounded-lg hover:border-[#00d9ff] transition-colors">
							<div class="flex items-center gap-3">
								<div class="w-4 h-4 rounded-full" style="background-color: #0095ad;"></div>
								<div>
									<div class="font-semibold text-gray-900 dark:text-white">Treasury & Future Dev</div>
									<div class="text-sm text-gray-600 dark:text-gray-400">10,000,000 tokens</div>
								</div>
							</div>
							<div class="text-xl font-bold text-[#00d9ff]">10%</div>
						</div>

						<div class="flex items-center justify-between p-4 bg-white dark:bg-[#0a0f1e] border border-gray-200 dark:border-gray-700 rounded-lg hover:border-[#00d9ff] transition-colors">
							<div class="flex items-center gap-3">
								<div class="w-4 h-4 rounded-full" style="background-color: #007a8c;"></div>
								<div>
									<div class="font-semibold text-gray-900 dark:text-white">Strategic Partners</div>
									<div class="text-sm text-gray-600 dark:text-gray-400">10,000,000 tokens</div>
								</div>
							</div>
							<div class="text-xl font-bold text-[#00d9ff]">10%</div>
						</div>

						<div class="flex items-center justify-between p-4 bg-white dark:bg-[#0a0f1e] border border-gray-200 dark:border-gray-700 rounded-lg hover:border-[#00d9ff] transition-colors">
							<div class="flex items-center gap-3">
								<div class="w-4 h-4 rounded-full" style="background-color: #005f6b;"></div>
								<div>
									<div class="font-semibold text-gray-900 dark:text-white">Team & Advisors</div>
									<div class="text-sm text-gray-600 dark:text-gray-400">10,000,000 tokens</div>
								</div>
							</div>
							<div class="text-xl font-bold text-[#00d9ff]">10%</div>
						</div>

						<div class="flex items-center justify-between p-4 bg-white dark:bg-[#0a0f1e] border border-gray-200 dark:border-gray-700 rounded-lg hover:border-[#00d9ff] transition-colors">
							<div class="flex items-center gap-3">
								<div class="w-4 h-4 rounded-full" style="background-color: #cbd5e1;"></div>
								<div>
									<div class="font-semibold text-gray-900 dark:text-white">Seed Contributors</div>
									<div class="text-sm text-gray-600 dark:text-gray-400">8,500,000 tokens</div>
								</div>
							</div>
							<div class="text-xl font-bold text-[#00d9ff]">8.5%</div>
						</div>

						<div class="flex items-center justify-between p-4 bg-white dark:bg-[#0a0f1e] border border-gray-200 dark:border-gray-700 rounded-lg hover:border-[#00d9ff] transition-colors">
							<div class="flex items-center gap-3">
								<div class="w-4 h-4 rounded-full" style="background-color: #94a3b8;"></div>
								<div>
									<div class="font-semibold text-gray-900 dark:text-white">Marketing & Ecosystem</div>
									<div class="text-sm text-gray-600 dark:text-gray-400">5,000,000 tokens</div>
								</div>
							</div>
							<div class="text-xl font-bold text-[#00d9ff]">5%</div>
						</div>

						<div class="flex items-center justify-between p-4 bg-white dark:bg-[#0a0f1e] border border-gray-200 dark:border-gray-700 rounded-lg hover:border-[#00d9ff] transition-colors">
							<div class="flex items-center gap-3">
								<div class="w-4 h-4 rounded-full" style="background-color: #64748b;"></div>
								<div>
									<div class="font-semibold text-gray-900 dark:text-white">Legal & Compliance</div>
									<div class="text-sm text-gray-600 dark:text-gray-400">5,000,000 tokens</div>
								</div>
							</div>
							<div class="text-xl font-bold text-[#00d9ff]">5%</div>
						</div>
					</div>
				</div>

				<!-- Key Priorities -->
				<div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-6">
					<div class="text-center p-6 bg-white dark:bg-[#0a0f1e] border border-gray-200 dark:border-gray-700 rounded-lg">
						<div class="text-3xl font-bold text-[#00d9ff] mb-2">Liquidity</div>
						<p class="text-gray-600 dark:text-gray-300">Market stability first</p>
					</div>
					<div class="text-center p-6 bg-white dark:bg-[#0a0f1e] border border-gray-200 dark:border-gray-700 rounded-lg">
						<div class="text-3xl font-bold text-[#00d9ff] mb-2">Execution</div>
						<p class="text-gray-600 dark:text-gray-300">Over speculation</p>
					</div>
					<div class="text-center p-6 bg-white dark:bg-[#0a0f1e] border border-gray-200 dark:border-gray-700 rounded-lg">
						<div class="text-3xl font-bold text-[#00d9ff] mb-2">Long-term</div>
						<p class="text-gray-600 dark:text-gray-300">Alignment over exits</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Vesting Schedule -->
		<section class="py-16 lg:py-20 bg-white dark:bg-[#0a0f1e]">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="text-center mb-12">
					<h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4">
						Vesting Schedule
					</h2>
					<p class="text-gray-600 dark:text-gray-300 text-lg max-w-2xl mx-auto">
						All major allocations are subject to vesting. No immediate insider liquidity.
					</p>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
					<div class="border border-gray-200 dark:border-gray-700 rounded-xl p-6 hover:border-[#00d9ff] transition-colors">
						<h3 class="text-lg font-bold text-gray-900 dark:text-white mb-4">Team & Advisors</h3>
						<p class="text-gray-600 dark:text-gray-300 mb-2">12-month cliff, 36-month linear vesting</p>
						<div class="text-sm text-gray-500 dark:text-gray-400">Long-term commitment to execution</div>
					</div>

					<div class="border border-gray-200 dark:border-gray-700 rounded-xl p-6 hover:border-[#00d9ff] transition-colors">
						<h3 class="text-lg font-bold text-gray-900 dark:text-white mb-4">Seed Contributors</h3>
						<p class="text-gray-600 dark:text-gray-300 mb-2">Partial TGE unlock, linear vesting</p>
						<div class="text-sm text-gray-500 dark:text-gray-400">Rewarding early risk-takers</div>
					</div>

					<div class="border border-gray-200 dark:border-gray-700 rounded-xl p-6 hover:border-[#00d9ff] transition-colors">
						<h3 class="text-lg font-bold text-gray-900 dark:text-white mb-4">Strategic Partners</h3>
						<p class="text-gray-600 dark:text-gray-300 mb-2">Milestone-aligned linear vesting</p>
						<div class="text-sm text-gray-500 dark:text-gray-400">Performance-based unlocks</div>
					</div>

					<div class="border border-gray-200 dark:border-gray-700 rounded-xl p-6 hover:border-[#00d9ff] transition-colors">
						<h3 class="text-lg font-bold text-gray-900 dark:text-white mb-4">Treasury</h3>
						<p class="text-gray-600 dark:text-gray-300 mb-2">Time-locked, governance-controlled</p>
						<div class="text-sm text-gray-500 dark:text-gray-400">Community-driven allocation</div>
					</div>
				</div>

				<div class="mt-12 text-center">
					<p class="text-lg text-gray-600 dark:text-gray-300 italic">
						"Trust compounds over time."
					</p>
				</div>
			</div>
		</section>

		<!-- Competitive Positioning -->
		<section class="py-16 lg:py-20 bg-gray-50 dark:bg-[#12171f]">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="text-center mb-12">
					<h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4">
						Competitive Positioning
					</h2>
					<p class="text-gray-600 dark:text-gray-300 text-lg max-w-2xl mx-auto">
						SplitDo isn't trying to replace everything. It replaces the part that never worked well.
					</p>
				</div>

				<div class="overflow-x-auto">
					<table class="w-full border-collapse">
						<thead>
							<tr class="border-b-2 border-[#00d9ff]">
								<th class="text-left py-4 px-6 text-gray-900 dark:text-white font-bold">Platform</th>
								<th class="text-center py-4 px-6 text-gray-900 dark:text-white font-bold">Tracks Expenses</th>
								<th class="text-center py-4 px-6 text-gray-900 dark:text-white font-bold">Settles Instantly</th>
								<th class="text-center py-4 px-6 text-gray-900 dark:text-white font-bold">Global</th>
								<th class="text-center py-4 px-6 text-gray-900 dark:text-white font-bold">On-Chain</th>
							</tr>
						</thead>
						<tbody class="bg-white dark:bg-[#0a0f1e]">
							<tr class="border-b border-gray-200 dark:border-gray-700">
								<td class="py-4 px-6 text-gray-900 dark:text-white font-medium">Splitwise</td>
								<td class="py-4 px-6 text-center"><span class="inline-block w-20 py-1 rounded text-sm font-semibold bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400">Yes</span></td>
								<td class="py-4 px-6 text-center"><span class="inline-block w-20 py-1 rounded text-sm font-semibold bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-400">No</span></td>
								<td class="py-4 px-6 text-center"><span class="inline-block w-20 py-1 rounded text-sm font-semibold bg-yellow-100 text-yellow-700 dark:bg-yellow-900/30 dark:text-yellow-400">Limited</span></td>
								<td class="py-4 px-6 text-center"><span class="inline-block w-20 py-1 rounded text-sm font-semibold bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-400">No</span></td>
							</tr>
							<tr class="border-b border-gray-200 dark:border-gray-700">
								<td class="py-4 px-6 text-gray-900 dark:text-white font-medium">Tricount</td>
								<td class="py-4 px-6 text-center"><span class="inline-block w-20 py-1 rounded text-sm font-semibold bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400">Yes</span></td>
								<td class="py-4 px-6 text-center"><span class="inline-block w-20 py-1 rounded text-sm font-semibold bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-400">No</span></td>
								<td class="py-4 px-6 text-center"><span class="inline-block w-20 py-1 rounded text-sm font-semibold bg-yellow-100 text-yellow-700 dark:bg-yellow-900/30 dark:text-yellow-400">Limited</span></td>
								<td class="py-4 px-6 text-center"><span class="inline-block w-20 py-1 rounded text-sm font-semibold bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-400">No</span></td>
							</tr>
							<tr class="border-b border-gray-200 dark:border-gray-700">
								<td class="py-4 px-6 text-gray-900 dark:text-white font-medium">Group Payments</td>
								<td class="py-4 px-6 text-center"><span class="inline-block w-20 py-1 rounded text-sm font-semibold bg-yellow-100 text-yellow-700 dark:bg-yellow-900/30 dark:text-yellow-400">Partial</span></td>
								<td class="py-4 px-6 text-center"><span class="inline-block w-20 py-1 rounded text-sm font-semibold bg-yellow-100 text-yellow-700 dark:bg-yellow-900/30 dark:text-yellow-400">Partial</span></td>
								<td class="py-4 px-6 text-center"><span class="inline-block w-20 py-1 rounded text-sm font-semibold bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-400">No</span></td>
								<td class="py-4 px-6 text-center"><span class="inline-block w-20 py-1 rounded text-sm font-semibold bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-400">No</span></td>
							</tr>
							<tr class="bg-[#00d9ff]/10 border-2 border-[#00d9ff]">
								<td class="py-4 px-6 text-gray-900 dark:text-white font-bold">SplitDo</td>
								<td class="py-4 px-6 text-center"><span class="inline-block w-20 py-1 rounded text-sm font-semibold bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400">Yes</span></td>
								<td class="py-4 px-6 text-center"><span class="inline-block w-20 py-1 rounded text-sm font-semibold bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400">Yes</span></td>
								<td class="py-4 px-6 text-center"><span class="inline-block w-20 py-1 rounded text-sm font-semibold bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400">Yes</span></td>
								<td class="py-4 px-6 text-center"><span class="inline-block w-20 py-1 rounded text-sm font-semibold bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400">Yes</span></td>
							</tr>
						</tbody>
					</table>
				</div>
			</div>
		</section>

		<!-- Value Flow -->
		<section class="py-16 lg:py-20 bg-white dark:bg-[#0a0f1e]">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="text-center mb-12">
					<h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4">
						Value Flow
					</h2>
					<p class="text-gray-600 dark:text-gray-300 text-lg max-w-2xl mx-auto">
						No artificial demand. No forced mechanics. Usage creates value. Nothing else does.
					</p>
				</div>

