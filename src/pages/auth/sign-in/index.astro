---
import Layout from 'src/layouts/Layout.astro';

// render static HTML
export const prerender = true;
---

<Layout title="Coming Soon - SplitDo">
	<main class="min-h-screen bg-gradient-to-br from-orange-50 via-white to-teal-50 dark:from-gray-900 dark:via-gray-800 dark:to-gray-900 flex items-center justify-center px-4 sm:px-6 lg:px-8">
		<div class="mt-5 max-w-md w-full space-y-8 text-center">
			<!-- Logo/Brand -->
			<div>
				<div class="w-24 h-24 mx-auto mb-8 bg-gradient-to-br from-orange-100 to-teal-100 dark:from-orange-900 dark:to-teal-900 rounded-2xl flex items-center justify-center">
					<svg class="w-12 h-12 text-orange-600 dark:text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
					</svg>
				</div>
			</div>

			<!-- Coming Soon Message -->
			<div class="space-y-6">
				<h2 class="text-3xl font-bold text-gray-900 dark:text-gray-100">
					Coming Soon
				</h2>
				<p class="text-lg text-gray-600 dark:text-gray-300">
					We're building the future of expense splitting on the Solana blockchain. Split bills instantly with minimal fees and zero hassle.
				</p>
			</div>

			<!-- Features Preview -->
			<div class="grid grid-cols-1 gap-4 mt-8">
				<div class="flex items-center justify-center space-x-3 p-4 bg-white dark:bg-gray-800 rounded-lg shadow-sm">
					<div class="w-8 h-8 bg-orange-100 dark:bg-orange-900 rounded-full flex items-center justify-center">
						<svg class="w-4 h-4 text-orange-600 dark:text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
						</svg>
					</div>
					<span class="text-gray-700 dark:text-gray-300 font-medium">Lightning-fast Solana settlements</span>
				</div>
				<div class="flex items-center justify-center space-x-3 p-4 bg-white dark:bg-gray-800 rounded-lg shadow-sm">
					<div class="w-8 h-8 bg-teal-100 dark:bg-teal-900 rounded-full flex items-center justify-center">
						<svg class="w-4 h-4 text-teal-600 dark:text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
						</svg>
					</div>
					<span class="text-gray-700 dark:text-gray-300 font-medium">AI-powered receipt scanning</span>
				</div>
				<div class="flex items-center justify-center space-x-3 p-4 bg-white dark:bg-gray-800 rounded-lg shadow-sm">
					<div class="w-8 h-8 bg-blue-100 dark:bg-blue-900 rounded-full flex items-center justify-center">
						<svg class="w-4 h-4 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
						</svg>
					</div>
					<span class="text-gray-700 dark:text-gray-300 font-medium">Smart group management</span>
				</div>
			</div>

			<!-- Email Signup -->
			<div class="mt-8 p-6 bg-white dark:bg-gray-800 rounded-lg shadow-lg">
				<h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-4">
					Get Early Access
				</h3>
				<form class="space-y-4" action="#" method="POST">
					<input 
						type="email" 
						placeholder="Enter your email address" 
						class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100"
						required
					>
					<button 
						type="submit" 
						class="w-full px-6 py-3 bg-gradient-to-r from-orange-600 to-teal-600 text-white font-semibold rounded-lg hover:from-orange-700 hover:to-teal-700 transition-all duration-200 shadow-lg hover:shadow-xl"
					>
						Notify Me When Ready
					</button>
				</form>
				<p class="text-sm text-gray-500 dark:text-gray-400 mt-3">
					Be the first to know when SplitDo launches. No spam, just updates.
				</p>
			</div>

			<!-- Progress Indicator -->
			<div class="mt-8">
				<div class="flex justify-between text-sm text-gray-500 dark:text-gray-400 mb-2">
					<span>Development Progress</span>
					<span>75%</span>
				</div>
				<div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2">
					<div class="bg-gradient-to-r from-orange-600 to-teal-600 h-2 rounded-full" style="width: 75%"></div>
				</div>
			</div>

			<!-- Social Links -->
			<div class="flex justify-center space-x-6 mt-8">
				<a href="#" class="text-gray-400 hover:text-orange-600 transition-colors">
					<span class="sr-only">Twitter</span>
					<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
						<path d="M8.29 20.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0022 5.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.072 4.072 0 012.8 9.713v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 012 18.407a11.616 11.616 0 006.29 1.84"></path>
					</svg>
				</a>
				<a href="#" class="text-gray-400 hover:text-teal-600 transition-colors">
					<span class="sr-only">Discord</span>
					<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
						<path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"></path>
					</svg>
				</a>
			</div>

			<!-- Back to Home -->
			<div class="mt-8">
				<a href="/" class="text-orange-600 dark:text-orange-400 hover:text-orange-700 dark:hover:text-orange-300 font-medium transition-colors">
					← Back to Home
				</a>
			</div>
		</div>
	</main>
</Layout>
