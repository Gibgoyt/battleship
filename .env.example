# =============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control - it contains sensitive information

# =============================================================================
# AWS COGNITO AUTHENTICATION
# =============================================================================
# Required for user authentication with AWS Cognito
# These are PUBLIC variables accessible in client-side code

# AWS Region where your Cognito User Pool is located
# Example: us-east-1, eu-west-1, af-south-1
PUBLIC_COGNITO_REGION=your-aws-region

# Your Cognito User Pool ID
# Find this in AWS Console > Cognito > User Pools > Your Pool > General Settings
# Format: region_xxxxxxxxx
PUBLIC_COGNITO_USER_POOL_ID=your-user-pool-id

# Your Cognito App Client ID (Web Client)
# Find this in AWS Console > Cognito > User Pools > Your Pool > App Clients
# This should be the Web Client ID (not the Native client)
PUBLIC_COGNITO_CLIENT_ID=your-web-client-id

# =============================================================================
# CLAUDE API CONFIGURATION (Optional)
# =============================================================================
# Only needed if using Claude API features
# These are SERVER-ONLY variables (not accessible in client-side code)

# Your Claude API key from Anthropic
CLAUDE_API_KEY=your-claude-api-key

# Claude model to use (e.g., claude-3-sonnet-20240229)
CLAUDE_MODEL=claude-3-sonnet-20240229

# Maximum tokens for Claude responses
CLAUDE_MAX_TOKENS=4096

# Anthropic API version
ANTHROPIC_VERSION=2023-06-01

# =============================================================================
# CLOUDFLARE CONFIGURATION
# =============================================================================
# Backend API configuration for local development
# These values are already set in wrangler.toml but can be overridden here

# Backend API URL (for local development)
# BACKEND_API_URL=http://192.168.0.6:8443

# Backend WebSocket URL (for local development)  
# BACKEND_WS_URL=ws://192.168.0.6:8443/ws

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Node environment (development, production, test)
NODE_ENV=development

# =============================================================================
# SETUP INSTRUCTIONS
# =============================================================================

# 1. COPY THIS FILE:
#    cp .env.example .env

# 2. AWS COGNITO SETUP:
#    - Go to AWS Console > Cognito
#    - Create or select your User Pool
#    - Copy the Pool ID, Region, and Web Client ID
#    - Replace the placeholder values above

# 3. CLAUDE API (Optional):
#    - Get your API key from https://console.anthropic.com/
#    - Replace CLAUDE_API_KEY with your actual key

# 4. VERIFY CONFIGURATION:
#    - Run `npm run dev` to test your setup
#    - Check browser console for any environment variable errors

# =============================================================================
# DEPLOYMENT NOTES
# =============================================================================

# CLOUDFLARE PAGES:
# - Set these variables in your Cloudflare Pages dashboard
# - Go to Pages > Your Project > Settings > Environment Variables
# - Add all PUBLIC_ prefixed variables for production deployment

# SECURITY:
# - Never commit .env to version control
# - Only PUBLIC_ prefixed variables are accessible in client-side code
# - All other variables are server-side only
# - Use different values for development, staging, and production

# TROUBLESHOOTING:
# - If you get "Missing required environment variables" errors, check your .env file
# - Make sure there are no spaces around the = sign
# - Restart your development server after changing environment variables
# - Check that your AWS Cognito configuration allows your domain/localhost